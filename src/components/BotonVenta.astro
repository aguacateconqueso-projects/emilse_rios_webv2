---
/**
 * El botón de una carta de venta, con lo que va debajo.
 *
 * Es el botón del sitio (`Boton.astro`): relleno bajo el cursor, flecha,
 * imán y notas musicales. Sale dos o tres veces por carta. Dentro de la ficha
 * de precio, que se invierte a tinta al pasarle por encima, se invierte con
 * ella: relleno de papel sobre fondo de tinta.
 *
 * **Con puertas (la membresía)** es el botón de pagar y lleva debajo la cuenta
 * atrás o el aviso de puertas cerradas. Con las puertas cerradas deja de ser
 * un enlace: sin `href`, ni con el teclado se llega al cobro. El estado lo
 * manda `data-doors` en la carta, y el script de `CartaVenta.astro` lo mueve
 * en vivo —ver allí—.
 *
 * **Sin puertas (los cursos)** es el alta al newsletter, «Avísame cuando
 * abra», en otra pestaña.
 */
import type { Carta } from '../data/cartas';
import { NEWSLETTER } from '../data/cartas';
import Boton from './Boton.astro';

interface Props {
  c: Carta;
  /** Las puertas, ya resueltas para el HTML del build. Solo la membresía. */
  puertas?: { cerrado: boolean; lead: string; nota: string };
}
const { c, puertas } = Astro.props;
const fuera = c.boton.fuera ? { target: '_blank', rel: 'noopener' } : {};
---

{
  puertas ? (
    <Boton
      class="venta__btn venta__btn--pay"
      href={puertas.cerrado ? undefined : c.boton.href}
      aria-disabled={puertas.cerrado ? 'true' : undefined}
      tabindex={puertas.cerrado ? '-1' : undefined}
    >
      <span class="venta__btn-open">{c.boton.texto}</span>
      <span class="venta__btn-closed">{c.puertas?.payClosed}</span>
    </Boton>
  ) : (
    <Boton class="venta__btn" href={c.boton.href} {...fuera}>
      {c.boton.texto}
    </Boton>
  )
}
{
  puertas && c.puertas && (
    <p class="mono soft venta__timer">
      <span class="venta__timer-lead">{puertas.lead}</span>
      <span class="venta__clock" aria-hidden="true">
        <span class="venta__u" data-cd-dbox hidden>
          <b data-cd-d>0</b>d
        </span>
        <span class="venta__u">
          <b data-cd-h>00</b>h
        </span>
        <span class="venta__u">
          <b data-cd-m>00</b>m
        </span>
        <span class="venta__u">
          <b data-cd-s>00</b>s
        </span>
      </span>
      <span class="venta__closed">
        {puertas.nota}{' '}
        <a href={NEWSLETTER} target="_blank" rel="noopener">
          {c.puertas.closedLink}
        </a>
      </span>
    </p>
  )
}

<style>
  /* Los rótulos de la membresía: abierto o cerrado, según `data-doors`. Van
     con `:global` porque el `<span>` lo pinta este componente pero el botón
     que lo envuelve es de `Boton.astro`. */
  .venta__btn-closed {
    display: none;
  }

  /* --- Las puertas de la membresía ------------------------------------------
     El estado lo manda `data-doors` en la carta: `soon` = falta para el
     cierre, `closed` = puertas cerradas, `open` = no hay cierre a la vista y
     el renglón de debajo no sale. */
  .venta__timer {
    display: none;
    margin-top: var(--space-2);
    transition: color 0.45s ease;
  }

  :global([data-doors='soon']) .venta__timer,
  :global([data-doors='closed']) .venta__timer {
    display: block;
  }

  .venta__timer-lead {
    display: block;
  }

  /* Los números van en cifras tabulares para que el contador no baile de
     ancho a cada segundo. La urgencia la ponen ellos, no un color. */
  .venta__clock {
    display: inline-flex;
    gap: var(--space-2);
    margin-top: var(--space-1);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    transition: color 0.45s ease;
  }

  .venta__u[hidden] {
    display: none;
  }

  .venta__u b {
    font-weight: 500;
  }

  .venta__closed {
    display: none;
  }

  .venta__closed a {
    color: var(--ink);
    transition: color 0.45s ease;
  }

  :global([data-doors='closed']) .venta__timer-lead,
  :global([data-doors='closed']) .venta__clock {
    display: none;
  }

  :global([data-doors='closed']) .venta__closed {
    display: block;
  }

  /* Puertas cerradas: el botón sigue ahí —la carta se lee igual— pero deja de
     ser un botón: en tinta secundaria, sin relleno, sin flecha, sin notas y
     sin enlace. */
  :global([data-doors='closed'] .venta__btn--pay) {
    color: var(--ink-soft);
    border-color: var(--rule);
    pointer-events: none;
  }

  :global([data-doors='closed'] .venta__btn--pay .boton__ar),
  :global([data-doors='closed']) .venta__btn-open {
    display: none;
  }

  :global([data-doors='closed']) .venta__btn-closed {
    display: inline;
  }

  /* --- Dentro de la ficha invertida -----------------------------------------
     La ficha de precio se vuelve tinta al pasarle el cursor, y el botón y lo
     de debajo se invierten con ella. Solo donde hay cursor de verdad: en una
     pantalla táctil el `:hover` se queda pegado. */
  @media (hover: hover) {
    :global(.venta__ficha:hover .venta__btn) {
      --fill: var(--paper);
      --fg: var(--paper);
      --fg-hover: var(--ink);
    }

    :global([data-doors='closed'] .venta__ficha:hover .venta__btn--pay) {
      color: var(--paper-soft);
      border-color: var(--paper-rule);
    }

    :global(.venta__ficha:hover) .venta__timer {
      color: var(--paper-soft);
    }

    :global(.venta__ficha:hover) .venta__clock,
    :global(.venta__ficha:hover) .venta__closed a {
      color: var(--paper);
    }
  }
</style>
