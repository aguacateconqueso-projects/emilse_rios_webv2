---
import { type Lang, type Route, useTranslations, routePath } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
  route?: Route;
}
const { lang, route = 'home' } = Astro.props;
const t = useTranslations(lang);
---

<footer class="footer">
  <div class="footer__inner">
    <div>
      <div class="footer__mark"><Logo name={t('site.name')} /></div>
      <a class="mono-plain soft footer__email" href={`mailto:${t('footer.email')}`}>
        {t('footer.email')}
      </a>
    </div>

    <nav class="footer__nav mono" aria-label={t('site.name')}>
      <a class="footer__link" href="https://instagram.com/" rel="me noopener">
        {t('footer.instagram')}
      </a>
      <a class="footer__link" href="https://youtube.com/" rel="me noopener">
        {t('footer.youtube')}
      </a>
      <a class="footer__link" href={routePath('about', lang)}>{t('nav.about')}</a>
      <LangSwitch lang={lang} hrefEs={routePath(route, 'es')} hrefEn={routePath(route, 'en')} />
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--rule);
    margin-top: var(--space-16);
  }

  .footer__inner {
    max-width: var(--width-full);
    margin-inline: auto;
    padding: var(--space-6) var(--space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .footer__mark {
    --logo-height: 40px;
  }

  @media (max-width: 36rem) {
    .footer__mark {
      --logo-height: 32px;
    }
  }

  .footer__email {
    display: inline-block;
    margin-top: var(--space-1);
    border-bottom-color: transparent;
  }

  .footer__email:hover {
    color: var(--ink);
    border-bottom-color: currentColor;
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .footer__link {
    border-bottom: 0;
  }

  .footer__link:hover {
    color: var(--ink-soft);
  }
</style>
