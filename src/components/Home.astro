---
import { Image } from 'astro:assets';
import { type Lang, useTranslations } from '../i18n/ui';
import { getHomeCopy } from '../data/home';
import SubscribeForm from './SubscribeForm.astro';
import emilseHero from '../assets/img/emilse-hero.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const { blocks } = getHomeCopy(lang);
---

{
  blocks.map((block) => {
    switch (block.k) {
      case 'hero':
        return (
          <section class="hero">
            <h1 class="hero__title">{block.title}</h1>
            <p class="mono soft hero__eyebrow">{block.eyebrow}</p>
            <p class="hero__lead">{block.lead}</p>
          </section>
        );

      case 'plate':
        return (
          <section class="row row--flush block plate">
            <div class="row__body">
              <figure class="plate__fig">
                <div class="plate__frame">
                  {/*
                    440 y no 640: el marco de abajo no pasa de 432 px, así que
                    pedir el ancho de la columna entera era bajar el doble de
                    píxeles para tirar la mitad.

                    Y `quality` escrito, que es la única imagen del sitio que
                    lo lleva. Por defecto Astro saca el 2× en 269 kB — el
                    triple que el retrato de *Sobre mí*—: es una fachada de
                    piedra a contraluz y la textura no comprime. A 70 son 175 y
                    el recorte a tamaño real no enseña ni un artefacto. Si
                    alguna vez se cambia la foto por una de menos grano, esto
                    sobra y se quita.
                  */}
                  <Image
                    src={emilseHero}
                    alt={block.alt}
                    width={440}
                    quality={70}
                    densities={[1, 2]}
                    class="plate__img"
                  />
                </div>
                <figcaption class="mono soft plate__cap">{block.caption}</figcaption>
              </figure>
            </div>
          </section>
        );

      case 'runs':
        return (
          <section class="row row--flush block">
            <div class="row__body prose lede">
              <p>
                {block.runs.map((run) =>
                  run.mono ? <span class="inline-mono">{run.text}</span> : run.text,
                )}
              </p>
            </div>
          </section>
        );

      case 'h2':
        return (
          <section class="row row--flush block">
            <div class="row__body">
              <h2 class="section-title">{block.text}</h2>
            </div>
          </section>
        );

      case 'prose':
        return (
          <div class="row row--flush block">
            <div class="row__body prose">
              {block.paras.map((para) => (
                <p>{para}</p>
              ))}
            </div>
          </div>
        );

      case 'anchor':
        return (
          <div class="anchor reveal">
            <p class="anchor__text">{block.text}</p>
          </div>
        );

      case 'form':
        return <SubscribeForm lang={lang} id={block.id} flush />;

      case 'fine':
        return (
          <div class="row row--flush fine">
            <div class="row__body">
              <p class="mono soft">{block.text}</p>
            </div>
          </div>
        );
    }
  })
}

<style>
  /* --- Hero ---------------------------------------------------------------
     Portada centrada. Se sale de la rejilla de lectura a propósito: no es un
     bloque de texto más, es la portada del sitio.

     Más ancho que la medida para que el título respire en dos líneas, y el
     párrafo lo acompaña a ese ancho: desde el 21 sep 2026 no es un párrafo de
     cuerpo sino una entradilla del tamaño de los títulos de sección, y a la
     medida de 640 px se partía en renglones demasiado cortos.

     El hueco de arriba lo ponía el numeral `01` —32 px de margen más su propio
     renglón—. Sin él la portada quedaba pegada a la píldora del menú, así que
     esos 64 px son los suyos, no un valor nuevo. */
  .hero {
    max-width: var(--width-wide);
    margin-inline: auto;
    padding-block-start: var(--space-8);
    padding-inline: var(--space-3);
    text-align: center;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-hero);
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-hero);
    text-wrap: balance;
  }

  .hero__eyebrow {
    margin-top: var(--space-3);
  }

  .hero__lead {
    max-width: var(--width-wide);
    margin-top: var(--space-4);
    margin-inline: auto;
    font-size: var(--text-section);
    line-height: var(--leading-section);
    text-wrap: balance;
  }

  /* --- La lámina ----------------------------------------------------------
     La foto de Emi, después del formulario. No es un hero a pantalla completa
     a propósito: eso la pondría por encima del título y haría que la página
     fuera sobre ella y no sobre el newsletter. Demuestra el título en vez de
     ilustrarlo — contrabajo, calle, ciudad.

     Va **dentro de la rejilla de lectura**, alineada con los párrafos y con el
     mismo hueco de numeral vacío que usa el formulario. Estuvo un paso fuera
     de la medida (900 px contra los 768 de la columna) y sobresalir de los
     márgenes no quedaba bien: la página tiene un borde de texto claro y la
     foto lo rompía. Al meterla en la rejilla no puede volver a salirse, venga
     el ancho que venga.

     **Desde el 21 sep 2026 es vertical**, y sigue dentro de la misma rejilla.
     Lo que se descartó en su día era otra cosa: una vertical *al lado* del
     texto, en dos columnas, que no cabe en una medida de 640 px. Una vertical
     sola, centrada en la columna, sí cabe — y no hace falta recortarla.

     Lo que sí pide una vertical es un tope de ancho. A los 640 px de la
     columna, esta proporción da 961 px de alto: más que la ventana de casi
     cualquier portátil, así que la foto dejaría de verse entera y pasaría a
     ser una pared por la que se baja. Los 432 px de abajo la dejan en 649 de
     alto, que entra de una vez en una ventana de 768. Por debajo de ese ancho
     manda el `100%` y en el teléfono ocupa la columna entera, como siempre.

     Centrada y no pegada al margen izquierdo: en una columna de lectura, una
     vertical alineada a un lado deja una franja de papel vacío que se lee como
     un error de maquetación y no como aire. */
  .plate__fig {
    max-width: min(100%, 27rem); /* 432 px → 649 px de alto */
    margin-inline: auto;
  }

  /* `clip` y no `hidden`. Los dos recortan igual lo que el acercamiento saca
     del marco, pero `hidden` convierte el marco en contenedor de scroll —uno
     que no scrollea nunca— y el revelado de abajo se ata al contenedor más
     cercano: se quedaba clavado a mitad de camino. `clip` recorta sin crear
     contenedor, así que la imagen queda atada al documento, que es quien de
     verdad se mueve. */
  .plate__frame {
    /* Es la proporción exacta del fichero (1400 × 2104), así que el marco no
       vuelve a recortar nada: el encuadre es el que eligió Emi. Si algún día
       se cambia la foto, hay que cambiar esto con ella o el marco la recorta
       por su cuenta. */
    aspect-ratio: 1400 / 2104;
    overflow: clip;
  }

  .plate__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* En reposo va en blanco y negro, como el resto de las fotografías del
       sitio. El color es lo que pasa al pasarle el scroll por encima; ver el
       revelado más abajo. Sin soporte, se queda así y no se pierde nada. */
    filter: grayscale(1);
  }

  .plate__cap {
    margin-top: var(--space-2);
  }

  /* Sin recorte aparte para móvil, a propósito. Lo hubo mientras la foto era
     una panorámica 2:1 con media calle vacía: a 342 px de ancho quedaba una
     tira de 171 px y había que recortar por los lados. Este encuadre lo eligió
     Emi y ya viene cerrado —vertical, 0,67— así que en estrecho se mantiene
     entero. Volver a recortarlo por CSS sería deshacer su decisión. */

  /* --- El revelado de la lámina -------------------------------------------
     Al pasarle el scroll por encima recupera el color y sigue acercándose muy
     despacio. El color vuelve al blanco y negro cuando la lámina se va: así el
     reposo de la página sigue siendo monocromo y el color es algo que ocurre
     mientras la miras, no un estado permanente.

     El acercamiento va en una sola dirección a lo largo de todo el paso. Si
     subiera y bajara como el color, la foto respiraría, y eso se nota como un
     tic; creciendo despacio se lee como deriva. Son tres centésimas: lo justo
     para que el ojo registre que algo se mueve.

     Va ligado al scroll, no al tiempo, así que corre fuera del hilo principal
     y no se dispara solo. Cuarta animación de la Home — la enmienda al tope
     está fechada en `progreso.md`. */
  @keyframes plate-bloom {
    0% {
      filter: grayscale(1);
      transform: scale(1);
    }
    15% {
      filter: grayscale(0);
    }
    45% {
      filter: grayscale(0);
    }
    100% {
      filter: grayscale(1);
      transform: scale(1.03);
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .plate__img {
        animation: plate-bloom 1s linear both;
      }

      /* La línea de tiempo y el tramo van en su propia regla a propósito: en
         la misma que el atajo `animation`, el minificador los funde dentro de
         él, y ahí no los acepta ningún navegador — se cae la declaración
         entera y no anima nada. Pasó con el fondo del contrabajo. Selector
         distinto para que no pueda volver a fundirlas. */
      /* El tramo arranca a mitad del paso de la lámina por la ventana. La
         cuenta importa: ese punto cae siempre por debajo de la página sin
         mover, en cualquier ventana de menos de 1525 px de alto — o sea, en
         todas. Anclándolo antes, en un monitor alto la lámina ya nacía a
         color al cargar y el blanco y negro dejaba de ser el reposo. Así
         llega en blanco y negro, florece cuando está bien encuadrada, y se
         apaga al irse por arriba.

         Se escribe con un solo valor. El final que queremos —la lámina fuera
         de pantalla por arriba— es justo el que toma por defecto, y al no
         nombrarlo el minificador no tiene nada que reescribir: escrito como
         `cover 50% exit 100%` lo dejaba en `exit 0%`, que no es lo mismo, y
         el color entraba y salía en un cuarto del recorrido. Es el mismo tipo
         de trampa que la de `animation-timeline`. */
      .plate .plate__img {
        animation-timeline: view();
        animation-range: cover 50%;
      }
    }
  }

  /* --- La letra pequeña ---------------------------------------------------
     «Suscribirse es gratis, darse de baja también». Cierra la página debajo
     del último formulario y va en la misma rejilla de lectura que él, con el
     mismo hueco de numeral vacío: así arranca en la misma vertical que la
     regla del campo y no queda flotando.

     En mono como el acuse de recibo del formulario, que aparece justo encima
     en ese mismo hueco. Los 8 px son los que el acuse ya usa; el pie de página
     pone los 128 de separación por su cuenta. */
  .fine {
    margin-top: var(--space-1);
  }
</style>
