---
import { Image } from 'astro:assets';
import { type Lang, useTranslations } from '../i18n/ui';
import { getHomeCopy } from '../data/home';
import SubscribeForm from './SubscribeForm.astro';
import EmailArchive from './EmailArchive.astro';
import emilseMadrid from '../assets/img/emilse-madrid.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const { blocks } = getHomeCopy(lang);
---

{
  blocks.map((block) => {
    switch (block.k) {
      case 'hero':
        return (
          <section class="hero">
            <div class="hero__head">
              <div class="mono-plain soft hero__num" aria-hidden="true">
                {block.n}
              </div>
              <h1 class="hero__title">{block.title}</h1>
              <p class="mono soft hero__eyebrow">{block.eyebrow}</p>
            </div>

            <div class="hero__band">
              <p class="hero__lead">{block.lead}</p>
              <figure class="hero__fig">
                <div class="plate__frame">
                  <Image
                    src={emilseMadrid}
                    alt={block.alt}
                    width={416}
                    densities={[1, 2]}
                    class="plate__img"
                  />
                </div>
                <figcaption class="mono soft plate__cap">{block.caption}</figcaption>
              </figure>
            </div>
          </section>
        );

      case 'runs':
        return (
          <section class="row block">
            <div class="row__num" aria-hidden="true">
              {block.n}
            </div>
            <div class="row__body prose">
              <p>
                {block.runs.map((run) =>
                  run.mono ? <span class="inline-mono">{run.text}</span> : run.text,
                )}
              </p>
            </div>
          </section>
        );

      case 'h2':
        return (
          <section class="row block">
            <div class="row__num row__num--h2" aria-hidden="true">
              {block.n}
            </div>
            <div class="row__body">
              <h2 class="section-title">{block.text}</h2>
            </div>
          </section>
        );

      case 'prose':
        return (
          <div class="row block">
            <div class="row__num" aria-hidden="true">
              {block.n ?? ''}
            </div>
            <div class="row__body prose">
              {block.paras.map((para) => (
                <p>{para}</p>
              ))}
            </div>
          </div>
        );

      case 'anchor':
        return (
          <div class="anchor reveal">
            {block.num && <div class="mono-plain soft anchor__num">{block.num}</div>}
            <p class="anchor__text">{block.text}</p>
          </div>
        );

      case 'form':
        return <SubscribeForm lang={lang} id={block.id} />;

      case 'cards':
        return (
          <div class="block">
            <EmailArchive lang={lang} n={block.n} label={block.label} />
          </div>
        );

      case 'closing':
        return (
          <section class="closing on-ink">
            <div class="mono-plain closing__num">{block.num}</div>
            <p class="closing__text">{block.text}</p>
            <a class="mono closing__link" href="#suscribete">
              {block.link}
            </a>
          </section>
        );
    }
  })
}

<style>
  /* --- Hero ---------------------------------------------------------------
     Portada centrada. Se sale de la rejilla de lectura a propósito: no es un
     bloque de texto más, es la portada del sitio, y el numeral va centrado
     encima como en las frases-ancla y en el cierre en negro — el sitio ya
     tenía ese patrón para los momentos que no se leen en columna.

     Más ancho que la medida para que el título respire en dos líneas; el
     párrafo sí vuelve a la medida, porque eso sí se lee. */
  .hero {
    padding-block-start: var(--space-4);
  }

  .hero__head {
    max-width: var(--width-wide);
    margin-inline: auto;
    padding-inline: var(--space-3);
    text-align: center;
  }

  .hero__num {
    margin-bottom: var(--space-4);
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-hero);
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-hero);
    text-wrap: balance;
  }

  .hero__eyebrow {
    margin-top: var(--space-3);
  }

  /* --- La banda: el párrafo de entrada y la lámina, en paralelo -------------
     El título va centrado y solo; debajo, el párrafo a la izquierda y la foto
     a su lado. La apertura es una composición, no tres bloques sueltos, y por
     eso el hero y la lámina viven en el mismo `case` — antes eran dos bloques
     de datos y la foto iba después del formulario.

     La banda es más ancha que la columna de lectura, y eso es deliberado: el
     título ya lo era (900 px contra 768). La apertura se abre y luego la
     página se cierra en su columna. Con dos columnas de verdad no cabía de
     otra forma — el párrafo a la medida son 640 px y la lámina 416.

     La foto va a la **derecha**, no a la izquierda, por el fondo del
     contrabajo: la banda del fantasma ocupa los 512 px de la izquierda, y una
     foto opaca encima lo tapaba justo donde se lee. Con el texto a la
     izquierda el fantasma respira entre los renglones. */
  .hero__band {
    max-width: var(--width-text);
    margin-top: var(--space-8);
    margin-inline: auto;
    padding-inline: var(--space-3);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 18rem);
    align-items: center;
    gap: var(--space-6);
  }

  /* El tope solo actúa al apilarse: en dos columnas el párrafo mide 384 px y
     nunca lo alcanza. Apilado sí, y sin él se iría a 720 px de ancho, por
     encima de la medida. */
  .hero__lead {
    max-width: var(--measure);
    text-wrap: pretty;
  }

  /* Apilada, la banda vuelve al ancho de la columna de lectura: el párrafo a
     la medida y la lámina debajo, a su ancho de siempre. */
  @media (max-width: 60rem) {
    .hero__band {
      max-width: var(--width-text);
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }

    .hero__fig {
      max-width: 26rem; /* 416 px */
    }
  }

  /* `clip` y no `hidden`. Los dos recortan igual lo que el acercamiento saca
     del marco, pero `hidden` convierte el marco en contenedor de scroll —uno
     que no scrollea nunca— y el revelado de abajo se ata al contenedor más
     cercano: se quedaba clavado a mitad de camino. `clip` recorta sin crear
     contenedor, así que la imagen queda atada al documento, que es quien de
     verdad se mueve. */
  .plate__frame {
    aspect-ratio: 4 / 5;
    overflow: clip;
  }

  .plate__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* En reposo va en blanco y negro, como el resto de las fotografías del
       sitio. El color es lo que pasa al pasarle el scroll por encima; ver el
       revelado más abajo. Sin soporte, se queda así y no se pierde nada. */
    filter: grayscale(1);
  }

  .plate__cap {
    margin-top: var(--space-2);
  }

  /* --- El revelado de la lámina -------------------------------------------
     Al pasarle el scroll por encima recupera el color y sigue acercándose muy
     despacio. El color vuelve al blanco y negro cuando la lámina se va: así el
     reposo de la página sigue siendo monocromo y el color es algo que ocurre
     mientras la miras, no un estado permanente.

     El acercamiento va en una sola dirección a lo largo de todo el paso. Si
     subiera y bajara como el color, la foto respiraría, y eso se nota como un
     tic; creciendo despacio se lee como deriva. Son tres centésimas: lo justo
     para que el ojo registre que algo se mueve.

     Va ligado al scroll, no al tiempo, así que corre fuera del hilo principal
     y no se dispara solo. Cuarta animación de la Home — la enmienda al tope
     está fechada en `progreso.md`. */
  @keyframes plate-bloom {
    0% {
      filter: grayscale(1);
      transform: scale(1);
    }
    15% {
      filter: grayscale(0);
    }
    45% {
      filter: grayscale(0);
    }
    100% {
      filter: grayscale(1);
      transform: scale(1.03);
    }
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .plate__img {
        animation: plate-bloom 1s linear both;
      }

      /* La línea de tiempo y el tramo van en su propia regla a propósito: en
         la misma que el atajo `animation`, el minificador los funde dentro de
         él, y ahí no los acepta ningún navegador — se cae la declaración
         entera y no anima nada. Pasó con el fondo del contrabajo. Selector
         distinto para que no pueda volver a fundirlas.

         Va atado al scroll del documento y medido en píxeles, no al paso de
         la lámina por la ventana. Mientras la foto estaba a media página,
         `view()` era lo correcto porque se recolocaba sola. Ahora está en la
         primera pantalla, y ahí `view()` no puede cumplir la única condición
         que importa —llegar en blanco y negro—: cualquier punto de su
         recorrido cae en scroll negativo si la ventana es más alta que unos
         1050 px, así que en un monitor grande la foto nacía a color. Medido:
         65 % de color al cargar en una ventana de 1200. Atado al documento,
         el scroll en reposo es cero y el cero es el primer fotograma, sea cual
         sea la ventana. Es el mismo motivo por el que el fondo del contrabajo
         usa `scroll(root)`.

         Los 720 px son de dónde está la foto: arranca en 344 y desaparece por
         arriba en 704. Si se cambia el texto de la apertura y la foto se
         mueve, este número se mueve con ella — es el precio de atarlo al
         documento, y por eso está medido y anotado en `progreso.md` en vez de
         puesto a ojo. En píxeles y no en porcentaje para que el largo de la
         página no lo toque. */
      .hero__fig .plate__img {
        animation-timeline: scroll(root block);
        animation-range: 0px 45rem; /* 720 px */
      }

      /* Apilada, la foto baja: arranca sobre los 500 px y desaparece cerca de
         los 990. El tramo la sigue. */
      @media (max-width: 60rem) {
        .hero__fig .plate__img {
          animation-range: 0px 62.5rem; /* 1000 px */
        }
      }
    }
  }

  /* --- Cierre en negro --------------------------------------------------- */
  .closing {
    margin-top: var(--space-16);
    padding: clamp(var(--space-12), 14vw, 11rem) var(--space-3);
    background: var(--ink);
    color: var(--paper);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 70vh;
  }

  .closing__num {
    color: var(--paper-soft);
  }

  .closing__text {
    margin-top: var(--space-6);
    max-width: 56.25rem; /* 900 px */
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4.4vw, 3rem); /* 28 → 48 px */
    line-height: 1.24;
    text-wrap: pretty;
  }

  .closing__link {
    margin-top: var(--space-8);
    color: var(--paper);
    border-bottom: 1px solid var(--paper-rule);
    padding-bottom: var(--space-1);
  }

  .closing__link:hover {
    border-bottom-color: var(--paper);
  }
</style>
