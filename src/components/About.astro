---
import { type Lang, useTranslations } from '../i18n/ui';
import { getAboutCopy } from '../data/about';
import SubscribeForm from './SubscribeForm.astro';
import MediaSlot from './MediaSlot.astro';
import aboutMe from '../assets/img/about-me.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const { blocks } = getAboutCopy(lang);
---

{
  blocks.map((block) => {
    switch (block.k) {
      case 'ahero':
        return (
          <section class="ahero">
            <div class="ahero__text">
              <div class="ahero__inner">
                <h1 class="ahero__title">{block.title}</h1>
                {/*
                  El índice viaja al CSS como `--i` y de ahí sale el retraso de
                  cada renglón. Escrito así y no con cinco `nth-of-type`, porque
                  el texto de esta entrada lo edita Emi: si mañana añade un
                  párrafo, entra en la escalera solo. Con selectores numerados
                  se quedaría fuera y nadie se daría cuenta.
                */}
                {block.paras.map((para, i) => (
                  <p class="ahero__para" style={`--i:${i}`}>
                    {para}
                  </p>
                ))}
              </div>
            </div>
            <div class="ahero__media">
              {/*
                El retrato es horizontal —Emi en la calle, abrazada al
                contrabajo, lanzando un beso con una pierna en alto— y el marco
                no lo es: casi cuadrado en el escritorio, vertical en la
                tableta, apenas apaisado en el teléfono. Así que la foto llena
                el alto y lo que se recorta son los lados, calle y fachada. Emi
                está justo en el centro, y el centro la sostiene en los tres.

                El 23 sep 2026 hubo dos: primero una vertical de la misma
                sesión, y horas después esta, que es la que se queda.
              */}
              <MediaSlot
                src={aboutMe}
                placeholder={t('media.portrait')}
                alt={t('media.portraitAlt')}
                width={900}
                position="center"
              />
            </div>
          </section>
        );

      case 'prose':
        return (
          <div class="row row--flush block reveal">
            <div class="row__body prose">
              {block.paras.map((para) => (
                <p>{para}</p>
              ))}
            </div>
          </div>
        );

      case 'anchor':
        return (
          <div class="anchor reveal">
            {(Array.isArray(block.text) ? block.text : [block.text]).map((line) => (
              <p class="anchor__text">{line}</p>
            ))}
          </div>
        );

      case 'form':
        return (
          <div class="reveal">
            <SubscribeForm lang={lang} id={block.id} label={block.label} flush />
          </div>
        );

      case 'testi':
        return (
          <section class="row row--wide row--flush block reveal">
            <div class="row__body">
              <h2 class="mono soft testi__label">{block.label}</h2>
              <ul class="testi" role="list">
                {block.items.map((item) => (
                  <li class="testi__item">
                    <blockquote class:list={['testi__text', item.pendiente && 'is-pending']}>
                      {item.text}
                    </blockquote>
                    <p class="mono soft testi__meta">{item.meta}</p>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        );
    }
  })
}

<style>
  /* --- Hero a dos columnas ----------------------------------------------- */
  .ahero {
    display: flex;
    flex-wrap: wrap-reverse;
    align-items: stretch;
    min-height: 35rem; /* 560 px */
  }

  .ahero__text {
    flex: 1 1 27.5rem;
    display: flex;
    align-items: center;
    padding: var(--space-12) var(--space-6) var(--space-12) max(var(--space-3), 8vw);
  }

  .ahero__inner {
    width: 100%;
    max-width: 37.5rem; /* 600 px */
    margin-left: auto;
  }

  .ahero__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3rem, 7vw, 5.5rem); /* 48 → 88 px */
    line-height: 1;
    letter-spacing: var(--tracking-hero);
  }

  .ahero__para {
    margin-top: var(--space-4);
    max-width: 32.5rem; /* 520 px */
    text-wrap: pretty;
  }

  .ahero__media {
    flex: 1 1 27.5rem;
    position: relative;
    min-height: 27.5rem; /* 440 px */
    border-left: 1px solid var(--rule);
  }

  /* El marco lo decide la página, no la foto. Mientras el retrato fue
     horizontal daba igual: su alto natural nunca llegaba al de la columna de
     texto. Con el vertical del 23 sep 2026 sí llega, y el marco crecía con él
     —720 × 1080 en el escritorio, contra los 728 de alto que tenía—. Colgado
     del marco, la foto lo llena sin empujarlo: en el escritorio manda el alto
     del texto de al lado, y apilado, el `min-height` de abajo. */
  .ahero__media :global(.slot) {
    position: absolute;
    inset: 0;
  }

  /* Apilado, el retrato no necesita media pantalla ni una regla al costado. */
  @media (max-width: 55rem) {
    .ahero__text {
      padding: var(--space-6) var(--space-3) var(--space-12);
    }

    .ahero__media {
      min-height: 21rem;
      border-left: 0;
      border-bottom: 1px solid var(--rule);
    }
  }

  /* --- La entrada de *Sobre mí* -------------------------------------------
     La Home tiene la firma escribiéndose sobre negro; esta página no, y no
     debe tenerla: la entrada es de la portada y repetirla en cada sección la
     gastaría. Lo que le faltaba a *Sobre mí* era lo contrario, que aparece de
     golpe, con el titular ya puesto antes de que el ojo llegue.

     Así que entra, y entra sin más: no hay panel, ni cortinilla, ni nada que
     tape la página. Cada renglón sube 16 px y se funde, en la misma curva y a
     una duración del mismo orden que el revelado del resto del sitio — es el
     mismo gesto, solo que disparado por la carga y no por el scroll.

     El retrato entra fundiéndose y no subiendo. Sube el texto, que es una
     columna de renglones y se lee como tal; el retrato es media pantalla
     pegada a tres bordes, y moverlo despegaría la regla del costado del borde
     de la ventana durante medio segundo. Se nota, y se nota como un fallo. */
  @media (prefers-reduced-motion: no-preference) {
    .ahero__title,
    .ahero__para {
      animation: ahero-rise 0.7s var(--ease-reveal) both;
    }

    .ahero__title {
      animation-delay: 0.05s;
    }

    /* La escalera. 60 ms entre renglones: por debajo se leen como uno solo y
       la escalera no se percibe; por encima, quien llega a leer ya está
       esperando al párrafo siguiente. El `--i` lo pone el marcado. */
    .ahero__para {
      animation-delay: calc(0.13s + var(--i, 0) * 0.06s);
    }

    .ahero__media {
      animation: ahero-fade 0.9s var(--ease-reveal) 0.1s both;
    }
  }

  @keyframes ahero-rise {
    from {
      opacity: 0;
      transform: translateY(var(--space-2));
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes ahero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* --- El retrato al pasar por encima -------------------------------------
     Toma color y se levanta un poco. Es lo mismo que hace la lámina de la
     Home —el color es algo que ocurre mientras la miras, no un estado— solo
     que acá lo dispara el cursor y no el scroll, porque acá la foto está
     quieta en pantalla mientras se lee la columna de al lado.

     Ocho píxeles —un escalón de la rejilla— y ni uno más. Lo que se busca es
     que la foto se despegue lo justo para que se note que responde; a partir
     de ahí deja de ser un retrato en una página y empieza a ser una tarjeta,
     que es otro sistema de diseño. El hueco que abre por abajo es de papel, no
     de sombra: el sistema dice sombras cero y esta no es la excepción de la
     cápsula del menú.

     `:global` porque el marco y la imagen son de `MediaSlot`, y sus clases
     están rotuladas con el ámbito de ESE componente, no con el de este.

     Solo donde hay cursor de verdad. En una pantalla táctil el `:hover` se
     queda pegado después de tocar, y el retrato se quedaría a color y en el
     aire hasta que se toque otra cosa. */
  @media (hover: hover) {
    .ahero__media :global(.slot) {
      transition: transform 0.5s var(--ease-reveal);
    }

    .ahero__media :global(.slot__img) {
      transition: filter 0.5s var(--ease-reveal);
    }

    .ahero__media:hover :global(.slot) {
      transform: translateY(calc(-1 * var(--space-1)));
    }

    .ahero__media:hover :global(.slot__img) {
      filter: grayscale(0);
    }

    /* Quien pide menos movimiento se queda con el color, que no es
       movimiento, y sin el salto. */
    @media (prefers-reduced-motion: reduce) {
      .ahero__media:hover :global(.slot) {
        transform: none;
      }
    }
  }

  /* --- Testimonios --------------------------------------------------------- */
  /* «Qué dicen mis alumnos». Es un rótulo, no un titular: va en mono como el
     resto de las etiquetas del sitio, y los 48 px lo separan del párrafo que
     lo precede sin abrir un bloque nuevo. */
  .testi__label {
    margin-bottom: var(--space-6);
    font-weight: 400;
  }

  .testi {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .testi__item {
    border-top: 1px solid var(--rule);
    padding: var(--space-4) 0;
  }

  .testi__text {
    margin: 0;
    max-width: 38.75rem; /* 620 px */
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    line-height: var(--leading-body);
    text-wrap: pretty;
  }

  /* Los que aún no han llegado se ven como lo que son: un hueco. */
  .testi__text.is-pending {
    color: var(--ink-soft);
    font-style: italic;
  }

  .testi__meta {
    margin-top: var(--space-3);
  }
</style>
