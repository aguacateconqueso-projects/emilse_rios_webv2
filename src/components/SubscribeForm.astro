---
import { type Lang, useTranslations } from '../i18n/ui';
import { hayProveedor } from '../lib/klaviyo';

/**
 * Campo de suscripción — una regla, nunca una caja.
 *
 * **Desde el 22 sep 2026 da de alta de verdad.** Manda el correo a
 * `/api/suscribir`, que habla con Klaviyo desde el servidor con la clave
 * privada — ver `src/lib/klaviyo.ts`. Hasta ese día no daba de alta a nadie.
 *
 * Lo que decide si funciona es **`KLAVIYO_API_KEY` en Vercel**, y de ahí sale
 * `hayProveedor`. Sin ella, el comportamiento de siempre, que no se toca
 * porque es el correcto:
 *
 *   · en desarrollo, simula el envío para poder revisar el diseño;
 *   · en producción, muestra el error en vez de mentirle a quien se suscribe.
 *
 * ⚠️ **Desde el 23 sep 2026 el formulario llama siempre al servidor**, también
 * sin clave. Hasta ese día, sin clave, el `data-endpoint` nacía vacío y el
 * navegador enseñaba el error **sin llamar a nadie**. Esta página se escribe en
 * el build, así que eso quedaba congelado en el HTML: una vista previa
 * construida antes de poner la clave seguía fallando después, y en los logs de
 * Vercel no aparecía nada, porque no había llegado ninguna petición. Ahora el
 * que dice que no es `/api/suscribir`, y lo deja escrito en los logs.
 *
 * `PUBLIC_NEWSLETTER_ENDPOINT` sigue existiendo y sigue mandando sobre todo lo
 * demás: es la salida para apuntar a otro sitio —otro proveedor, un formulario
 * alojado— sin tocar código. Vacía, que es lo normal, manda la ruta de casa.
 */
interface Props {
  lang: Lang;
  id: string;
  /** Sin el hueco del numeral al margen. Lo usan la Home y *Sobre mí*, que
   *  desde el 21 sep 2026 no tienen numerales; la tienda y el aula sí. */
  flush?: boolean;
  /**
   * Rótulo encima de la regla, para nombrar el newsletter donde la página no
   * lo ha nombrado. En la Home sobra —el título ya lo dice— y en *Sobre mí*
   * hace falta: ahí el campo llega después de mil palabras sobre Emi.
   */
  label?: string;
}
const { lang, id, flush = false, label } = Astro.props;
const t = useTranslations(lang);

/*
 * La ruta de casa por defecto. Se escribe relativa a propósito: así vale igual
 * en producción, en las previsualizaciones de Vercel y en `astro dev`, sin una
 * variable más — la misma razón por la que el botón de pagar de la membresía
 * (`boton.href` en `src/data/cartas.ts`) es relativo desde que el cobro se
 * mudó acá.
 *
 * ⚠️ `hayProveedor` solo decide si se simula en desarrollo, y viaja al
 * navegador como un booleano y **solo como un booleano**. `klaviyo.ts` es de
 * servidor y la clave no sale de ahí; lo único que cruza es un sí o un no.
 */
const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT || '/api/suscribir';
const conectado = hayProveedor || Boolean(import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT);
const simular = import.meta.env.DEV && !conectado;
const inputId = `${id}-email`;
const statusId = `${id}-status`;
---

<div class:list={['subscribe', 'row', flush && 'row--flush']} id={id}>
  {!flush && <div class="row__num" aria-hidden="true" />}
  <div class="row__body">
    {label && <p class="mono soft subscribe__name">{label}</p>}
    <form
      class="subscribe__form"
      data-subscribe
      data-endpoint={endpoint}
      data-simular={simular ? 'true' : 'false'}
      data-done={t('form.done')}
      data-invalid={t('form.error')}
      data-failed={t('form.failed')}
      action={endpoint}
      method="post"
      novalidate
    >
      <label class="subscribe__label" for={inputId}>{t('form.label')}</label>
      <input
        class="subscribe__input"
        id={inputId}
        name="email"
        type="email"
        autocomplete="email"
        required
        placeholder={t('form.placeholder')}
        aria-describedby={statusId}
      />
      <button class="subscribe__cta mono" type="submit">{t('form.cta')}</button>
    </form>

    <p class="subscribe__status mono" id={statusId} role="status" data-status hidden></p>
  </div>
</div>

<style>
  .subscribe {
    padding-top: var(--space-4);
  }

  .subscribe__name {
    margin-bottom: var(--space-2);
  }

  .subscribe__form {
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
    border-bottom: 1px solid var(--ink);
    padding-bottom: var(--space-1);
  }

  .subscribe__form[hidden] {
    display: none;
  }

  /* La etiqueta existe para el lector de pantalla, no para la pantalla. */
  .subscribe__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .subscribe__input {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 0;
    font-family: var(--font-body);
    font-size: 1.25rem; /* 20 px */
    line-height: var(--leading-body);
    color: var(--ink);
  }

  .subscribe__input::placeholder {
    color: var(--ink-soft);
    opacity: 1;
  }

  .subscribe__input:focus-visible {
    outline: 0;
  }

  /* Con el campo enfocado la regla engorda: el foco se ve sin romper la
     promesa de «una regla, nunca una caja». */
  .subscribe__form:focus-within {
    box-shadow: 0 1px 0 0 var(--ink);
  }

  .subscribe__cta {
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
    color: var(--ink);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .subscribe__cta:hover {
    color: var(--ink-soft);
  }

  .subscribe__status {
    margin-top: var(--space-1);
    color: var(--ink-soft);
  }

  /* El acuse de recibo reemplaza al campo, con su propia regla. */
  .subscribe__status.is-done {
    margin-top: 0;
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--rule);
    animation: subscribe-in 0.4s var(--ease-reveal);
  }

  @keyframes subscribe-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .subscribe__status.is-done {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-subscribe]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[name="email"]');
    const status = form.parentElement?.querySelector<HTMLElement>('[data-status]');
    if (!input || !status) return;

    const endpoint = form.dataset.endpoint ?? '';
    const simular = form.dataset.simular === 'true';
    const doneCopy = form.dataset.done ?? '';
    const invalidCopy = form.dataset.invalid ?? '';
    const failedCopy = form.dataset.failed ?? '';

    const say = (message: string) => {
      status.textContent = message;
      status.hidden = false;
    };

    const succeed = () => {
      form.hidden = true;
      status.classList.add('is-done');
      say(doneCopy);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!input.checkValidity() || !input.value.trim()) {
        say(invalidCopy);
        input.focus();
        return;
      }

      // Solo en desarrollo y sin proveedor —`KLAVIYO_API_KEY` vacía y sin
      // endpoint propio—: se simula para poder revisar el diseño. Fuera de
      // ahí se llama siempre al servidor, con clave o sin ella; sin clave
      // contesta 503, se dice que no y se da una dirección a la que escribir.
      if (simular) {
        console.warn('[suscripción] sin proveedor (falta KLAVIYO_API_KEY): envío simulado.');
        succeed();
        return;
      }

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ email: input.value.trim() }),
        });
        if (!response.ok) throw new Error(String(response.status));
        succeed();
      } catch {
        say(failedCopy);
      }
    });
  });
</script>
