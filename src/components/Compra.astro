---
/**
 * El bloque de compra — el paso 3 del recorrido.
 *
 * Dos formas, según lo que la carta necesite en ese punto:
 *
 * - `precio`: **la ficha de la carta original, pieza por pieza** — el nombre
 *   con su eco en el otro idioma, la etiqueta «Precio», el importe con su
 *   «/mes», el párrafo que explica que el precio se congela, lo que incluye, el
 *   botón, la línea corta y la letra pequeña. A dos columnas, como allí.
 * - `simple`: solo el importe y el botón. Va donde la carta ya lo contó y solo
 *   hace falta la puerta: tras el gancho, tras el mensaje final y tras las
 *   preguntas.
 *
 * **Hoy el paso 4 sale del sitio.** La membresía sigue cobrando en
 * `emilseriosacademy.com` y ahí se queda hasta el cambio de dominio, así que el
 * botón lleva a su checkout de Stripe, que funciona. Se dice una vez, en la
 * primera ficha, en lugar de que la lectora descubra sola que cambió de dominio
 * a mitad de una compra.
 */
import { type Lang, useTranslations } from '../i18n/ui';
import type { Product } from '../data/aula';

interface Props {
  lang: Lang;
  producto: Product;
  variante: 'simple' | 'precio';
  /** El aviso de que el cobro vive fuera solo se dice una vez por página. */
  aviso?: boolean;
}
const { lang, producto, variante, aviso = false } = Astro.props;
const t = useTranslations(lang);
const copia = producto.copia[lang];
const compra = copia.compra;
const href = producto.comprarHref?.[lang];
/** Fuera del sitio mientras el cobro no viva acá. */
const fuera = href?.startsWith('http') ?? false;
const ficha = variante === 'precio' && !!compra;
---

{
  href && (
    <div class="row row--wide block reveal">
      <div class="row__num" aria-hidden="true" />
      <div class="row__body">
        <div class:list={['buy', ficha && 'buy--card']}>
          {ficha && compra ? (
            <>
              <div class="buy__cols">
                <div class="buy__left">
                  <p class="buy__name">
                    {copia.nombre}
                    <span class="buy__echo"> {compra.eco}</span>
                  </p>
                  <p class="mono soft buy__label">{compra.etiquetaPrecio}</p>
                  <p class="buy__price">
                    {copia.precio}
                    <span class="mono soft buy__per">{compra.cadenciaCorta}</span>
                  </p>
                  <p class="buy__lead">
                    <strong>{compra.notaFuerte}</strong> {compra.notaResto}
                  </p>
                </div>

                <div class="buy__right">
                  <ul class="buy__feat" role="list">
                    {compra.incluye.map((item) => (
                      <li class="buy__feat-row">{item}</li>
                    ))}
                  </ul>
                  <a class="mono buy__cta" href={href} rel={fuera ? 'noopener' : undefined}>
                    {compra.etiqueta}
                  </a>
                  <p class="mono soft buy__note">{compra.nota}</p>
                </div>
              </div>

              <p class="buy__fine">{compra.pie}</p>
            </>
          ) : (
            <>
              <p class="buy__price">
                {copia.precio}
                <span class="mono soft buy__per">{compra?.cadenciaCorta ?? copia.cadencia}</span>
              </p>
              <a class="mono buy__cta" href={href} rel={fuera ? 'noopener' : undefined}>
                {compra?.etiqueta ?? t('aula.buy')}
              </a>
              {compra && <p class="mono soft buy__note">{compra.nota}</p>}
            </>
          )}

          {fuera && aviso && <p class="buy__away">{t('aula.leaving')}</p>}
        </div>
      </div>
    </div>
  )
}

<style>
  /* Encuadrado con reglas de 1 px, no con una caja gris: el sistema no tiene
     fondos de relleno. La regla de arriba va en tinta plena para que el bloque
     pese más que una división cualquiera. */
  .buy {
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    padding: var(--space-4) 0;
    max-width: var(--measure);
  }

  /* La ficha completa es más ancha que la columna de lectura: son dos columnas
     y con 640 px se estrangulan. */
  .buy--card {
    max-width: none;
  }

  .buy__cols {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--col-gap);
  }

  .buy__left,
  .buy__right {
    flex: 1 1 18rem;
    min-width: 0;
  }

  .buy__name {
    font-family: var(--font-display);
    font-size: var(--text-section);
    line-height: var(--leading-section);
    letter-spacing: var(--tracking-section);
  }

  /* El nombre en el otro idioma, apagado y en cursiva: es un eco, no un
     segundo título. */
  .buy__echo {
    font-style: italic;
    color: var(--ink-soft);
  }

  .buy__label {
    margin-top: var(--space-3);
  }

  .buy__price {
    font-family: var(--font-display);
    font-size: var(--text-anchor);
    line-height: 1;
  }

  .buy__per {
    margin-left: var(--space-1);
    vertical-align: middle;
  }

  .buy__lead {
    margin-top: var(--space-2);
    max-width: 26rem; /* 416 px */
    font-size: var(--text-small);
    line-height: var(--leading-body);
    text-wrap: pretty;
  }

  /* La negrita del original se resuelve con la tipografía de titulares, que es
     como este sistema destaca; subir el peso de la de cuerpo no está previsto. */
  .buy__lead strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.125rem; /* 18 px */
  }

  /* Lo que incluye. Filas separadas por reglas, como la ficha de trayectoria
     de Sobre mí. */
  .buy__feat {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .buy__feat-row {
    border-top: 1px solid var(--rule);
    padding: var(--space-2) 0;
    font-size: var(--text-small);
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* El único botón macizo del sitio. Se lo gana: es el final del recorrido, y
     no hay color de acento con el que destacarlo de otra manera. */
  .buy__cta {
    display: inline-block;
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-4);
    background: var(--ink);
    color: var(--paper);
    border-bottom: 0;
  }

  .buy__cta:hover {
    background: var(--ink-soft);
  }

  .buy__note {
    margin-top: var(--space-3);
  }

  .buy__fine,
  .buy__away {
    margin-top: var(--space-4);
    max-width: var(--measure);
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--ink-soft);
    text-wrap: pretty;
  }
</style>
