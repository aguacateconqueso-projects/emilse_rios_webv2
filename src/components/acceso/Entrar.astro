---
/**
 * La pantalla de acceso al aula.
 *
 * Dos caminos en la misma página, y a propósito:
 *
 *   1. **Correo y contraseña**, para quien ya la tiene.
 *   2. **«Primera vez, o se te olvidó la clave»**, que manda el correo con el
 *      enlace de un solo uso. Es UN camino, no dos, porque en la práctica es la
 *      misma situación: la cuenta se crea al pagar y nace sin contraseña, así
 *      que «nunca la puse» y «no me acuerdo» acaban en el mismo sitio. La
 *      academia aprendió esto y acá no se desaprende.
 *
 * ⚠️ **La respuesta al pedir el enlace no dice si el correo existe.** Siempre
 * contesta lo mismo. Si dijera «esa cuenta no existe», cualquiera podría
 * averiguar quién es miembro probando correos.
 */
import type { Lang } from '../../i18n/ui';
import { routePath } from '../../i18n/ui';
import { useAula, clavePath, escritorioPath } from '../../i18n/aula';
import { isSupabaseConfigured } from '../../lib/supabase';
import Boton from '../Boton.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const a = useAula(lang);
---

<section
  class="entrar"
  data-entrar
  data-destino={escritorioPath(lang)}
  data-redirect-clave={clavePath(lang)}
  data-t-bad={a('signin.bad')}
  data-t-broke={a('signin.broke')}
  data-t-noemail={a('signin.noEmail')}
>
  <p class="eyebrow">{a('signin.eyebrow')}</p>
  <h1 class="puerta__h">{a('signin.title')}</h1>
  <p class="puerta__lead">{a('signin.lead')}</p>

  {
    !isSupabaseConfigured && (
      <p class="aviso" role="status">
        <b>{a('off.badge')}</b> — {a('off.lead')}
      </p>
    )
  }

  <form class="campos" data-form-entrar novalidate>
    <label class="campo">
      <span class="campo__t">{a('signin.email')}</span>
      <input type="email" name="email" autocomplete="email" required data-email />
    </label>

    <label class="campo">
      <span class="campo__t">{a('signin.pass')}</span>
      <input type="password" name="clave" autocomplete="current-password" required data-clave />
    </label>

    <label class="casilla">
      <input type="checkbox" checked data-recordar />
      <span>
        {a('signin.remember')}
        <span class="campo__ayuda soft">{a('signin.rememberHelp')}</span>
      </span>
    </label>

    <p class="error" data-error hidden></p>

    <Boton class="boton--solid" type="submit" data-enviar>{a('signin.go')}</Boton>
  </form>

  <hr class="hr" />

  <details class="olvido">
    <summary>{a('signin.first')}</summary>
    <p class="soft olvido__lead">{a('signin.firstLead')}</p>
    <form class="campos" data-form-clave novalidate>
      <label class="campo">
        <span class="campo__t">{a('signin.email')}</span>
        <input type="email" name="email" autocomplete="email" required data-email-clave />
      </label>
      <p class="error" data-error-clave hidden></p>
      <p class="ok" data-ok-clave hidden>{a('signin.sent')}</p>
      <Boton type="submit" data-enviar-clave>{a('signin.send')}</Boton>
    </form>
  </details>

  <p class="entrar__tienda">
    <a href={routePath('products', lang)}>{a('signin.store')}</a>
  </p>
</section>

<script>
  /**
   * Va SIN `define:vars` a propósito: ese modificador vuelve el script inline,
   * y un script inline no puede importar módulos. Lo que necesita saber viaja
   * en los `data-` del contenedor, que es lo que Astro sí sabe imprimir.
   */
  import { supabase, isSupabaseConfigured, recordarSesion } from '../../lib/supabase';

  const caja = document.querySelector<HTMLElement>('[data-entrar]');

  // Sin backend la pantalla es una maqueta y lo dice arriba. Un formulario
  // inerte es más honesto que uno que finge.
  if (caja && isSupabaseConfigured) {
    const destino = caja.dataset.destino;
    const redirectClave = caja.dataset.redirectClave;
    const T = {
      bad: caja.dataset.tBad,
      broke: caja.dataset.tBroke,
      noEmail: caja.dataset.tNoemail,
    };
    const $ = (sel: string) => caja.querySelector(sel) as HTMLElement | null;

    /* Si ya hay sesión, acá no hay nada que hacer: adentro. */
    supabase.auth.getSession().then(({ data }) => {
      if (data.session && destino) location.replace(destino);
    });

    /* --- Entrar --------------------------------------------------------- */
    $('[data-form-entrar]')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = ($('[data-email]') as HTMLInputElement).value.trim();
      const clave = ($('[data-clave]') as HTMLInputElement).value;
      const err = $('[data-error]')!;
      const btn = $('[data-enviar]') as HTMLButtonElement;

      err.hidden = true;
      if (!email || !clave) {
        err.textContent = T.noEmail!;
        err.hidden = false;
        return;
      }

      /* La casilla decide DÓNDE se guarda el token, así que se escribe antes
         de iniciar sesión: después ya habría nacido en el almacén que no era. */
      recordarSesion(($('[data-recordar]') as HTMLInputElement).checked);

      btn.disabled = true;
      const { error } = await supabase.auth.signInWithPassword({
        email: email.toLowerCase(),
        password: clave,
      });
      btn.disabled = false;

      if (error) {
        /* EN LA CONSOLA, el error entero. La consola solo la ve quien está
           sentado delante, que es quien acaba de teclear ese correo y esa
           contraseña, así que no se le cuenta nada que no sepa. */
        console.error('[acceso] no se pudo iniciar sesión:', error.message, error);

        /* EN PANTALLA, dos mensajes y no uno, y esta distinción costó una tarde
           el 22 sep 2026:

           **400 → es de credenciales.** Ahí el mensaje es el mismo diga lo que
           diga Supabase —«no existe» y «clave incorrecta» se cuentan igual, o
           cualquiera averiguaría quién es miembro probando correos—. «Email not
           confirmed» también es 400 y también va acá, por lo mismo: confirmar
           que una cuenta existe ya es delatarla.

           **Cualquier otra cosa → NO es de credenciales**, y decir «no son
           correctos» es mandar a alguien a cambiar una contraseña que estaba
           bien. Acá caen la clave `anon` mal copiada en Vercel, un 429, un 500
           de Supabase, la red, y el caso que de verdad pasó: Supabase contestó
           `200` al `/token` —las credenciales ERAN buenas— y supabase-js
           devolvió error igual al guardar la sesión. Nada de eso es un vector
           de enumeración, así que decirlo no cuesta nada y ahorra la tarde. */
        err.textContent = error.status === 400 ? T.bad! : T.broke!;
        err.hidden = false;
        return;
      }
      if (destino) location.assign(destino);
    });

    /* --- Pedir el enlace de la contraseña -------------------------------- */
    $('[data-form-clave]')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = ($('[data-email-clave]') as HTMLInputElement).value.trim();
      const err = $('[data-error-clave]')!;
      const ok = $('[data-ok-clave]')!;
      const btn = $('[data-enviar-clave]') as HTMLButtonElement;

      err.hidden = true;
      ok.hidden = true;
      if (!email) {
        err.textContent = T.noEmail!;
        err.hidden = false;
        return;
      }

      btn.disabled = true;
      await supabase.auth.resetPasswordForEmail(email.toLowerCase(), {
        redirectTo: location.origin + redirectClave,
      });
      btn.disabled = false;

      /* Se contesta lo mismo pase lo que pase, y por eso el error ni se mira:
         la respuesta no puede delatar si ese correo tiene cuenta. */
      ok.hidden = false;
    });
  }
</script>

<style>
  /* Los campos, el aviso y los errores son del marco (`styles/app.css`); acá
     solo lo que es de esta pantalla. */
  .olvido summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .olvido__lead {
    margin: var(--space-2) 0 var(--space-3);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .entrar__tienda {
    margin-top: var(--space-6);
    font-size: var(--text-small);
  }
</style>
