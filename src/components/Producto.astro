---
/**
 * La página de venta de un producto — el paso 2 del recorrido.
 *
 * Es a la vez la carta y el destino de la ficha del catálogo: una sola cosa con
 * dos usos. El botón de comprar va dentro, y aparece varias veces, donde la
 * carta lo pida — eso lo decide el texto, en `data/aula.ts`, no este fichero.
 *
 * **El texto de la membresía es el de `emilseriosacademy.com`, tal cual.** Lo
 * que cambia es la ropa: se pinta con el sistema de este sitio, en blanco y
 * negro, sin la capa cálida de la academia. Si el aula pareciera un sitio
 * distinto al público, la alumna notaría la costura.
 */
import { type Lang, useTranslations, routePath } from '../i18n/ui';
import type { Product, Para } from '../data/aula';
import MediaSlot from './MediaSlot.astro';
import Compra from './Compra.astro';

interface Props {
  lang: Lang;
  producto: Product;
}
const { lang, producto } = Astro.props;
const t = useTranslations(lang);
const copia = producto.copia[lang];
const pagina = copia.pagina!;

/** El texto de un párrafo, venga en llano o marcado como fuerte. */
const texto = (para: Para) => (typeof para === 'string' ? para : para.texto);
const esFuerte = (para: Para) => typeof para !== 'string';

/*
  El aviso de que el cobro vive fuera se dice **una sola vez**, en el primer
  bloque de compra de la página. Repetirlo en los cuatro sería ruido, y callarlo
  del todo sería dejar que la lectora descubra el cambio de dominio ella sola.
*/
let primerCta = true;
---

<article>
  <header class="prod__hero">
    <div class="prod__intro">
      <div class="prod__introInner">
        <a class="mono soft prod__back" href={routePath('aula', lang)}>{t('aula.back')}</a>
        <h1 class="prod__title">{pagina.titulo}</h1>
        <p class="mono soft prod__sub">{pagina.subtitulo}</p>
      </div>
    </div>
    <div class="prod__media">
      <MediaSlot
        src={producto.foto}
        alt={copia.fotoAlt ?? ''}
        placeholder={copia.fotoPie}
        width={900}
      />
    </div>
  </header>

  {
    pagina.bloques.map((bloque) => {
      switch (bloque.k) {
        case 'lede':
          return (
            <div class="anchor reveal">
              <p class="anchor__text prod__lede">
                <span>{bloque.a}</span>
                <span>{bloque.b}</span>
              </p>
            </div>
          );

        case 'prose':
          return (
            <div class="row block reveal">
              <div class="row__num" aria-hidden="true">
                {bloque.n ?? ''}
              </div>
              <div class="row__body prose">
                {bloque.paras.map((para) => (
                  <p class:list={[esFuerte(para) && 'is-strong']}>{texto(para)}</p>
                ))}
              </div>
            </div>
          );

        case 'anchor':
          return (
            <div class="anchor reveal">
              <p class="anchor__text">{bloque.text}</p>
            </div>
          );

        case 'hitos':
          return (
            <section class="row block reveal">
              <div class="row__num row__num--h2" aria-hidden="true">
                {bloque.n}
              </div>
              <div class="row__body">
                <h2 class="section-title">{bloque.lead}</h2>
                <dl class="hitos">
                  {bloque.items.map((item) => (
                    <div class="hitos__row">
                      <dt class="mono soft hitos__label">{item.t}</dt>
                      <dd class="hitos__text">{item.p}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </section>
          );

        case 'contraste':
          return (
            <section class="row row--wide block reveal">
              <div class="row__num row__num--h2" aria-hidden="true">
                {bloque.n}
              </div>
              <div class="row__body">
                <div class="fit">
                  {[bloque.si, bloque.no].map((col) => (
                    <div class="fit__col">
                      <h2 class="section-title fit__h">{col.titulo}</h2>
                      <ul class="fit__list" role="list">
                        {col.items.map((item) => (
                          <li class="fit__item">{item}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          );

        case 'lista':
          return (
            <section class="row block reveal">
              <div class="row__num row__num--h2" aria-hidden="true">
                {bloque.n}
              </div>
              <div class="row__body">
                <h2 class="section-title">{bloque.titulo}</h2>
                <ul class="items" role="list">
                  {bloque.items.map((item) => (
                    <li class="items__row">{item}</li>
                  ))}
                </ul>
              </div>
            </section>
          );

        case 'faq':
          return (
            <section class="row block reveal">
              <div class="row__num row__num--h2" aria-hidden="true">
                {bloque.n}
              </div>
              <div class="row__body">
                <h2 class="section-title">{bloque.titulo}</h2>
                {/*
                  Desplegables, como en la carta original: once preguntas
                  abiertas a la vez son un muro, y quien busca la suya la
                  encuentra antes leyendo solo los titulares. `<details>` lo
                  hace sin una línea de script y con el teclado ya resuelto.
                */}
                <div class="faq">
                  {bloque.items.map((item, i) => (
                    <details class="qa">
                      <summary class="qa__q">
                        <span class="mono-plain soft qa__n" aria-hidden="true">
                          {String(i + 1).padStart(2, '0')}
                        </span>
                        <span>{item.q}</span>
                      </summary>
                      <p class="qa__a">
                        {item.a}
                        {item.correo && (
                          <>
                            {' '}
                            <a href={`mailto:${item.correo}`}>{item.correo}</a>
                          </>
                        )}
                      </p>
                    </details>
                  ))}
                </div>
              </div>
            </section>
          );

        case 'pd':
          return (
            <section class="row block reveal">
              <div class="row__num" aria-hidden="true" />
              <div class="row__body">
                <div class="pd">
                  <p class="mono soft">{bloque.label}</p>
                  <p class="pd__text">{bloque.texto}</p>
                  <p class="pd__firma">{bloque.firma}</p>
                </div>
              </div>
            </section>
          );

        case 'news':
          return (
            <section class="row row--wide block reveal">
              <div class="row__num" aria-hidden="true" />
              <div class="row__body">
                <div class="news">
                  <p class="news__pre">{bloque.texto}</p>
                  <a class="mono news__cta" href={bloque.href} rel="noopener">
                    {bloque.enlace}
                  </a>
                </div>
              </div>
            </section>
          );

        case 'cta': {
          const aviso = primerCta;
          primerCta = false;
          return (
            <Compra lang={lang} producto={producto} variante={bloque.variante} aviso={aviso} />
          );
        }
      }
    })
  }
</article>

<style>
  /* --- La entrada, a dos columnas ------------------------------------------
     Mismo reparto que el hero de Sobre mí: el texto a un lado, el retrato al
     otro, con una regla entre los dos. */
  .prod__hero {
    display: flex;
    flex-wrap: wrap-reverse;
    align-items: stretch;
    min-height: 32rem; /* 512 px */
  }

  .prod__intro {
    flex: 1 1 27.5rem;
    display: flex;
    align-items: center;
    padding: var(--space-12) var(--space-6) var(--space-12) max(var(--space-3), 8vw);
  }

  .prod__introInner {
    width: 100%;
    max-width: 37.5rem; /* 600 px */
    margin-left: auto;
  }

  .prod__back {
    display: inline-block;
    border-bottom-color: transparent;
  }

  .prod__back:hover {
    color: var(--ink);
    border-bottom-color: currentColor;
  }

  .prod__title {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3rem, 7vw, 5.5rem); /* 48 → 88 px */
    line-height: 1;
    letter-spacing: var(--tracking-hero);
  }

  .prod__sub {
    margin-top: var(--space-2);
  }

  .prod__media {
    flex: 1 1 27.5rem;
    position: relative;
    min-height: 27.5rem; /* 440 px */
    border-left: 1px solid var(--rule);
  }

  @media (max-width: 55rem) {
    .prod__intro {
      padding: var(--space-6) var(--space-3) var(--space-12);
    }

    .prod__media {
      min-height: 21rem;
      border-left: 0;
      border-bottom: 1px solid var(--rule);
    }
  }

  /* La apertura son dos frases, y la segunda va debajo de la primera aunque
     quepan al lado: en la carta original ese salto es el golpe. */
  .prod__lede span {
    display: block;
  }

  /* --- Párrafos en negrita -------------------------------------------------
     La carta original marca algunos párrafos enteros. No se sube el peso de la
     fuente de cuerpo: se pasan a la de titulares, que es la que este sistema
     usa para destacar. */
  .prose > p.is-strong {
    font-family: var(--font-display);
    font-size: 1.375rem; /* 22 px */
    line-height: 1.35;
    text-wrap: pretty;
  }

  /* --- Los descubrimientos -------------------------------------------------- */
  .hitos {
    margin: var(--space-4) 0 0;
    border-bottom: 1px solid var(--rule);
  }

  .hitos__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--col-gap);
    border-top: 1px solid var(--rule);
    padding: var(--space-3) 0;
  }

  .hitos__label {
    flex: 0 0 6rem; /* 96 px */
    margin: 0;
    padding-top: var(--space-1);
  }

  .hitos__text {
    flex: 1 1 20rem;
    min-width: 0;
    margin: 0;
    font-size: var(--text-small);
    line-height: var(--leading-body);
    text-wrap: pretty;
  }

  /* --- Para quién es y para quién no ---------------------------------------- */
  .fit {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--col-gap);
  }

  .fit__col {
    flex: 1 1 18rem;
    min-width: 0;
  }

  .fit__h {
    font-size: 1.375rem; /* 22 px */
  }

  .fit__list {
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .fit__item {
    border-top: 1px solid var(--rule);
    padding: var(--space-2) 0;
    font-size: var(--text-small);
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* La columna de la derecha —lo que no es— va en tinta secundaria: dice que
     no, y decirlo con el mismo peso que el sí desequilibra la página. */
  .fit__col:last-child .fit__item {
    color: var(--ink-soft);
  }

  /* --- Listas y preguntas --------------------------------------------------- */
  .items {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .items__row {
    border-top: 1px solid var(--rule);
    padding: var(--space-3) 0;
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .faq {
    margin: var(--space-4) 0 0;
    border-bottom: 1px solid var(--rule);
  }

  .qa {
    border-top: 1px solid var(--rule);
  }

  /* Sin el triángulo nativo: la pista de que abre es el número, que pasa a
     tinta plena, y el propio `<details>` ya lo anuncia al lector de pantalla. */
  .qa__q {
    display: flex;
    /* Las dos piezas se alinean por la línea de base, no con un relleno: el
       número mide 12 px y la pregunta 20, y cualquier ajuste a mano se sale de
       la rejilla de 8 — la auditoría lo caza. */
    align-items: baseline;
    gap: var(--col-gap);
    padding: var(--space-3) 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: 1.25rem; /* 20 px */
    line-height: 1.3;
    text-wrap: pretty;
  }

  .qa__q::-webkit-details-marker {
    display: none;
  }

  .qa__n {
    flex: 0 0 1.5rem; /* 24 px */
  }

  .qa[open] .qa__n,
  .qa__q:hover .qa__n {
    color: var(--ink);
  }

  .qa__q:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }

  .qa__a {
    margin: 0 0 var(--space-3) calc(1.5rem + var(--col-gap));
    max-width: var(--measure);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  /* --- El pie del newsletter -------------------------------------------------
     Cierra la carta como en el original. El enlace sale a la página alojada de
     Klaviyo porque el formulario propio de este sitio todavía no da de alta a
     nadie: es el único camino que llega. */
  .news {
    border-top: 1px solid var(--rule);
    padding-top: var(--space-4);
  }

  .news__pre {
    font-family: var(--font-display);
    font-size: var(--text-section);
    line-height: var(--leading-section);
    letter-spacing: var(--tracking-section);
  }

  .news__cta {
    display: inline-block;
    margin-top: var(--space-3);
    border-bottom: 1px solid var(--ink-soft);
  }

  .news__cta:hover {
    border-bottom-color: currentColor;
  }

  /* --- La posdata ------------------------------------------------------------
     Encuadrada con una regla arriba, para que se lea como lo que es: una nota
     al pie de la carta, no un bloque más. */
  .pd {
    border-top: 1px solid var(--rule);
    padding-top: var(--space-4);
    max-width: var(--measure);
  }

  .pd__text {
    margin-top: var(--space-2);
    text-wrap: pretty;
  }

  .pd__firma {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
  }
</style>
