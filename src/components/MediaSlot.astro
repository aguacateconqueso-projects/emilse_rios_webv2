---
import { Image } from 'astro:assets';

/**
 * Hueco de imagen.
 *
 * Mientras no llegue el archivo, dibuja un marco con su etiqueta — una regla
 * de 1 px y el texto en mono, nunca un relleno gris, que el sistema prohíbe.
 *
 * Para poner la imagen real basta con importarla y pasarla en `src`:
 *
 *   import retrato from '../assets/img/retrato.jpg';
 *   <MediaSlot src={retrato} alt="…" ratio="3 / 4" />
 */
interface Props {
  /**
   * Imagen importada desde `src/assets`, o una URL —las fotos que Emi sube
   * desde la pestaña Tienda del panel, que viven en el bucket «tienda»—. Si
   * falta, se dibuja el marco vacío.
   */
  src?: ImageMetadata | string;
  alt?: string;
  /** Texto del marco vacío. */
  placeholder: string;
  /** Proporción CSS, por ejemplo `3 / 4`. Sin valor, ocupa todo el alto. */
  ratio?: string;
  /** Ancho de presentación en píxeles, para que Astro genere el tamaño justo. */
  width?: number;
  /**
   * Qué parte de la foto se salva cuando el marco la recorta (`object-position`).
   * Por defecto el centro, que es lo que usan hoy todas: en el retrato de
   * *Sobre mí*, que es horizontal en un marco que no lo es, Emi está en el
   * centro de la foto.
   */
  position?: string;
}
const { src, alt = '', placeholder, ratio, width = 800, position } = Astro.props;
---

<div class="slot" style={ratio ? `aspect-ratio:${ratio}` : undefined}>
  {
    typeof src === 'string' ? (
      <img
        src={src}
        alt={alt}
        loading="lazy"
        decoding="async"
        class="slot__img"
        style={position ? `object-position:${position}` : undefined}
      />
    ) : src ? (
      <Image
        src={src}
        alt={alt}
        width={width}
        densities={[1, 2]}
        class="slot__img"
        style={position ? `object-position:${position}` : undefined}
      />
    ) : (
      <span class="mono slot__label">{placeholder}</span>
    )
  }
</div>

<style>
  .slot {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 12rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--rule);
    background: var(--paper);
  }

  .slot__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Las fotografías van en blanco y negro. */
    filter: grayscale(1);
  }

  .slot__label {
    max-width: 22rem;
    padding: var(--space-3);
    color: var(--ink-soft);
    text-align: center;
    text-wrap: pretty;
  }
</style>
