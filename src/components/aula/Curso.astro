---
/**
 * El reproductor de un curso — el índice, la clase y el hilo de preguntas.
 *
 * Hace lo mismo que hacía Tutor LMS en el WordPress viejo, que es lo que Emi
 * y sus alumnas conocen: un curso, sus unidades, sus clases, y el video en el
 * centro. Lo que cambia es todo lo demás.
 *
 * Las tres decisiones que mandan sobre el resto:
 *
 * 1. **Una sola página por curso, no una por clase.** Cambiar de clase es
 *    cambiar el `#hash`, no cargar otra página. Así el índice no parpadea, la
 *    posición del scroll no se pierde y pasar de la clase 4 a la 5 es
 *    instantáneo, que es como se estudia de verdad: una detrás de otra. El
 *    hash es además una dirección que se puede pegar en un correo —
 *    `…/curso-01/#m2-l1` abre esa clase— sin que existan cuarenta páginas que
 *    mantener.
 *
 * 2. **El progreso se guarda solo.** Nadie tiene que acordarse de marcar nada:
 *    el reproductor avisa del minuto en el que va, se apunta cada pocos
 *    segundos, y al volver se retoma ahí. Pasado el 92 % la clase se da por
 *    vista sola. El botón de «marcar como vista» sigue estando, pero para
 *    corregir a la máquina, no para hacerle el trabajo.
 *
 * 3. **Un hilo de preguntas por alumna y por curso**, no uno por clase. Una
 *    duda que nace en la clase 3 casi siempre sigue en la 4, y partirla en
 *    veinte hilos de un mensaje cada uno la vuelve inservible para las dos. El
 *    botón de preguntar sí vive **en cada clase**, y lo que escribe la alumna
 *    viaja con el curso, la clase y el minuto pegados — que es exactamente lo
 *    que Emi necesita ver para responder sin tener que preguntar «¿dónde?».
 *
 * ⚠️ **Esta pantalla necesita JavaScript**, y es la única del proyecto que lo
 * necesita. Todo lo demás —la portada, la tienda, las cartas de venta— se lee
 * entero sin él. Acá no hay manera honesta de evitarlo: un reproductor que
 * recuerda el minuto es una aplicación. Sin JS se ve la primera clase y un
 * aviso que lo dice.
 *
 * ⚠️ **Los videos son de Bunny Stream**, no de Vimeo. Emi está migrando el
 * material; mientras tanto ninguna clase tiene identificador y todas se
 * dibujan como el marco vacío que ya usa el resto del sitio para las fotos que
 * faltan. Ese marco trae una barra de prueba arrastrable para poder validar el
 * guardado del avance sin un solo video subido. Ver `src/data/cursos.ts`.
 */
import type { Lang } from '../../i18n/ui';
import { useAula, escritorioPath } from '../../i18n/aula';
import { buscarProducto } from '../../data/aula';
import { bunnySrc, buscarCurso, clasesDe, reloj } from '../../data/cursos';
import Boton from './Boton.astro';

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const a = useAula(lang);

const producto = buscarProducto(slug);
const curso = buscarCurso(slug);
const nombre = producto?.copia[lang].nombre ?? slug;
const clases = curso ? clasesDe(curso) : [];
const vacio = clases.length === 0;

/**
 * El curso entero, en la forma que necesita el script: ya traducido, ya con la
 * dirección del video resuelta y ya con el número de cada clase. Todo lo que se
 * puede calcular en el build se calcula en el build; al navegador le llega el
 * resultado, no el catálogo.
 */
const paraJs = {
  slug,
  nombre,
  unidades: (curso?.unidades ?? []).map((m, im) => ({
    id: m.id,
    num: im + 1,
    titulo: m.copia[lang].titulo,
    clases: m.clases.map((l, il) => ({
      id: l.id,
      num: il + 1,
      titulo: l.copia[lang].titulo,
      resumen: l.copia[lang].resumen ?? '',
      duracion: l.duracion ?? 0,
      src: bunnySrc(l.bunny),
      recursos: (l.recursos ?? []).map((r) => ({ href: r.href, nombre: r.copia[lang].nombre })),
    })),
  })),
};

/** Los textos que el script escribe en caliente. */
const textos = {
  clase: a('course.lesson'),
  hecha: a('player.markUndone'),
  marcar: a('player.markDone'),
  siguiente: a('player.next'),
  anterior: a('player.prev'),
  retomado: a('player.resumed'),
  reiniciar: a('player.restart'),
  sinVideo: a('player.noVideo'),
  sinVideoPie: a('player.noVideoLead'),
  barraPrueba: a('player.demoBar'),
  material: a('player.resources'),
  sobre: a('player.about'),
  esperando: a('ask.waiting'),
  respondida: a('ask.answered'),
  hiloVacio: a('ask.threadEmpty'),
  borrar: a('ask.deleteOne'),
  enviada: a('ask.sent'),
  vacia: a('ask.empty'),
  en: a('ask.at'),
};

const primera = clases[0];
---

{
  vacio ? (
    /*
      Un curso sin clases cargadas no se disfraza. El resto del sitio ya hace lo
      mismo con las fotos que no han llegado: un hueco que se ve es un hueco que
      alguien arregla.
    */
    <section class="wrap wrap--narrow vacio">
      <p class="eyebrow">{nombre}</p>
      <h1 class="vacio__h">{a('course.empty')}</h1>
      <p class="vacio__lead">{a('course.emptyLead')}</p>
      <Boton href={escritorioPath(lang)} etiqueta={a('app.backDesk')} />
    </section>
  ) : (
    <>
      <section class="wrap cabeza">
        <p class="eyebrow">{a('app.courses')}</p>
        <h1 class="cabeza__h">{nombre}</h1>
        <div class="cabeza__barra">
          <div class="meter" data-cabeza-meter>
            <span class="meter__fill" />
          </div>
          <p class="cabeza__cifras soft tnum">
            <span data-cabeza-cifras>
              0 / {clases.length} {a('course.lessons')}
            </span>
          </p>
        </div>
      </section>

      <div class="wrap rejilla2">
        {/* --- La escena: el video y todo lo de esta clase ----------------- */}
        <div class="escena">
          <div class="marco" data-marco>
            {/*
              El marco lo rellena el script con el reproductor de Bunny o con el
              hueco anunciado, según tenga video o no. Lo que va acá en el HTML
              es lo que se ve si el script no llega: la primera clase, dicha con
              palabras.
            */}
            <div class="hueco">
              <p class="hueco__h">{a('player.noVideo')}</p>
              <p class="hueco__p">{a('player.noVideoLead')}</p>
            </div>
          </div>

          <noscript>
            <p class="nojs">
              {a('course.empty')} — {a('demo.lead')}
            </p>
          </noscript>

          <div class="clase">
            <p class="eyebrow" data-clase-unidad>
              {paraJs.unidades[0]?.titulo}
            </p>
            <h2 class="clase__h" data-clase-titulo>
              {primera?.copia[lang].titulo}
            </h2>
            <p class="clase__meta soft tnum" data-clase-meta>
              {reloj(primera?.duracion)}
            </p>

            <div class="clase__actos">
              <button class="marcar" type="button" data-marcar aria-pressed="false">
                <span class="marcar__caja" aria-hidden="true" />
                <span data-marcar-txt>{a('player.markDone')}</span>
              </button>
              <Boton etiqueta={a('ask.open')} pequeno data-abrir-duda />
            </div>

            <p class="clase__resumen" data-clase-resumen>
              {primera?.copia[lang].resumen}
            </p>

            <div class="material" data-material hidden>
              <p class="eyebrow">{a('player.resources')}</p>
              <ul class="material__lista" role="list" data-material-lista />
            </div>

            <nav class="pasos" aria-label={a('player.contents')}>
              <a class="pasos__a" data-paso-prev hidden>
                <span class="pasos__et">← {a('player.prev')}</span>
                <span class="pasos__t" data-paso-prev-t />
              </a>
              <a class="pasos__a pasos__a--next" data-paso-next hidden>
                <span class="pasos__et">{a('player.next')} →</span>
                <span class="pasos__t" data-paso-next-t />
              </a>
            </nav>
          </div>
        </div>

        {/* --- El índice ---------------------------------------------------- */}
        <aside class="indice" aria-label={a('player.contents')}>
          <p class="eyebrow indice__h">{a('player.contents')}</p>
          <div class="indice__cuerpo">
            {paraJs.unidades.map((m) => (
              <section class="unidad">
                <h3 class="unidad__h">
                  <span class="unidad__n soft tnum">{String(m.num).padStart(2, '0')}</span>
                  {m.titulo}
                </h3>
                <ol class="unidad__lista" role="list">
                  {m.clases.map((l) => (
                    <li>
                      <a class="fila" href={`#${l.id}`} data-fila={l.id}>
                        <span class="fila__tic" aria-hidden="true" />
                        <span class="fila__t">{l.titulo}</span>
                        <span class="fila__d soft tnum">{reloj(l.duracion)}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </section>
            ))}
          </div>
        </aside>

        {/* --- El hilo de preguntas ----------------------------------------- */}
        <section class="hilo" aria-labelledby="hilo-h">
          <div class="hilo__cab">
            <h2 class="hilo__h" id="hilo-h">
              {a('ask.thread')}
            </h2>
            <Boton etiqueta={a('ask.open')} pequeno data-abrir-duda />
          </div>
          <p class="hilo__nota soft">{a('ask.local')}</p>
          <ul class="hilo__lista" role="list" data-hilo />
        </section>
      </div>

      {/* --- El formulario de la duda -------------------------------------- */}
      <dialog class="duda" data-duda aria-labelledby="duda-h">
        <form method="dialog" class="duda__form" data-duda-form>
          <p class="eyebrow">{nombre}</p>
          <h2 class="duda__h" id="duda-h">
            {a('ask.title')}
          </h2>
          <p class="duda__lead">{a('ask.lead')}</p>

          {/*
            El contexto no se pide: ya se sabe. La alumna lo ve —y puede quitar
            el minuto si su duda no es de un punto concreto—, pero no tiene que
            escribirlo. Es la diferencia entre un formulario y un interrogatorio.
          */}
          <p class="duda__ctx" data-duda-ctx />
          <label class="duda__minuto">
            <input type="checkbox" checked data-duda-con-minuto />
            <span data-duda-minuto-txt />
          </label>

          <label class="duda__label" for="duda-texto">
            {a('ask.label')}
          </label>
          <textarea
            id="duda-texto"
            class="duda__texto"
            rows="5"
            placeholder={a('ask.placeholder')}
            data-duda-texto
          />
          <p class="duda__error" data-duda-error hidden>
            {a('ask.empty')}
          </p>

          <div class="duda__pie">
            <button class="btn-text" type="button" data-duda-cancelar>
              {a('ask.cancel')}
            </button>
            <Boton etiqueta={a('ask.send')} variante="solid" pequeno tipo="button" data-duda-enviar />
          </div>
        </form>
      </dialog>
    </>
  )
}

<script is:inline define:vars={{ CURSO: paraJs, T: textos }}>
  (function () {
    var A = window.Aula;
    if (!A || !CURSO.unidades.length) return;

    /** Todas las clases en orden, con su unidad al lado. Se calcula una vez. */
    var CLASES = [];
    CURSO.unidades.forEach(function (m) {
      m.clases.forEach(function (l) {
        CLASES.push(Object.assign({}, l, { uniTitulo: m.titulo }));
      });
    });

    var $ = function (sel) { return document.querySelector(sel); };
    var marco = $('[data-marco]');
    var actual = null; /* la clase en pantalla */

    /* =====================================================================
       Qué clase toca
       ===================================================================== */

    function desdeHash() {
      var id = decodeURIComponent((location.hash || '').replace(/^#/, ''));
      return CLASES.find(function (c) { return c.id === id; }) || null;
    }

    /**
     * Al entrar sin hash: la clase donde se quedó, no la primera.
     * Llegar al curso y que te ponga la clase 1 cuando ibas por la 9 es el
     * fallo que más se nota de estas plataformas.
     */
    function alEntrar() {
      var porHash = desdeHash();
      if (porHash) return porHash;
      var guardada = A.ultima(CURSO.slug);
      var c = CLASES.find(function (x) { return x.id === guardada; });
      return c || CLASES[0];
    }

    /* =====================================================================
       El marco: el reproductor de Bunny, o el hueco anunciado
       ===================================================================== */

    /**
     * El puente con el reproductor de Bunny Stream, que habla **player.js**
     * por `postMessage`: se le pide que avise del minuto y se le puede mandar
     * a un segundo concreto.
     *
     * ⚠️ Escrito contra la documentación de Bunny, sin un video real con el que
     * probarlo — Emi todavía está migrando desde Vimeo. El día que suba el
     * primero hay que comprobar dos cosas: que llegan los `timeupdate` y que
     * `setCurrentTime` salta de verdad. Si algo no encaja, se arregla acá y en
     * ningún otro sitio: fuera de esta función nadie sabe qué reproductor hay.
     *
     * Si el puente no contesta, el aula sigue sirviendo: lo que se pierde es el
     * guardado automático, no la clase. Por eso el botón de marcar a mano nunca
     * se esconde.
     */
    function puente(iframe, clase) {
      var listo = false;
      var ultimoGuardado = 0;

      function manda(metodo, valor) {
        if (!iframe.contentWindow) return;
        iframe.contentWindow.postMessage(
          JSON.stringify({
            context: 'player.js',
            version: '0.0.11',
            method: metodo,
            value: valor,
          }),
          '*',
        );
      }

      function suscribe(evento) {
        manda('addEventListener', evento);
      }

      function alMensaje(e) {
        /* Solo del iframe de esta clase: puede haber otros orígenes hablando. */
        if (!iframe.contentWindow || e.source !== iframe.contentWindow) return;
        var d = e.data;
        if (typeof d === 'string') {
          try { d = JSON.parse(d); } catch (err) { return; }
        }
        if (!d || d.context !== 'player.js') return;

        if (d.event === 'ready') {
          listo = true;
          suscribe('timeupdate');
          suscribe('ended');
          /* Retomar donde se quedó. Con menos de 8 s se empieza de cero: eso no
             es «por donde iba», es haberle dado sin querer. Y si la clase está
             terminada, tampoco se salta al final. */
          var p = A.de(clase.id);
          if (p.s > 8 && !p.hecho) manda('setCurrentTime', p.s);
          return;
        }

        if (d.event === 'timeupdate' && d.value) {
          var s = d.value.seconds || 0;
          var dur = d.value.duration || clase.duracion || 0;
          /* Cada cinco segundos, no en cada aviso: el reproductor avisa varias
             veces por segundo y escribir en el disco a ese ritmo es tirar
             batería sin ganar precisión. */
          if (s - ultimoGuardado >= 5 || s < ultimoGuardado) {
            ultimoGuardado = s;
            A.ver(clase.id, s, dur);
            pintarTodo();
          }
          return;
        }

        if (d.event === 'ended') {
          A.marcar(clase.id, true);
          pintarTodo();
        }
      }

      window.addEventListener('message', alMensaje);

      /* Algunos reproductores no mandan `ready` si el oyente llega tarde. Se le
         pregunta un par de veces y se deja de insistir. */
      var intentos = 0;
      var golpes = setInterval(function () {
        if (listo || intentos++ > 6) return clearInterval(golpes);
        suscribe('ready');
        suscribe('timeupdate');
      }, 400);

      return function desmontar() {
        clearInterval(golpes);
        window.removeEventListener('message', alMensaje);
      };
    }

    var soltarPuente = null;

    function pintarMarco(clase) {
      if (soltarPuente) { soltarPuente(); soltarPuente = null; }
      marco.textContent = '';

      if (clase.src) {
        var iframe = document.createElement('iframe');
        iframe.src = clase.src;
        iframe.title = clase.titulo;
        iframe.loading = 'lazy';
        iframe.allow =
          'accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen';
        iframe.allowFullscreen = true;
        marco.appendChild(iframe);
        soltarPuente = puente(iframe, clase);
        return;
      }

      /* --- El hueco anunciado, con su barra de prueba -------------------- */
      var hueco = document.createElement('div');
      hueco.className = 'hueco';

      var h = document.createElement('p');
      h.className = 'hueco__h';
      h.textContent = T.sinVideo;

      var p = document.createElement('p');
      p.className = 'hueco__p';
      p.textContent = T.sinVideoPie;

      var guardado = A.de(clase.id);
      var total = clase.duracion || 600;

      var barra = document.createElement('input');
      barra.type = 'range';
      barra.className = 'hueco__barra';
      barra.min = '0';
      barra.max = String(total);
      barra.step = '1';
      barra.value = String(Math.min(guardado.s, total));
      barra.setAttribute('aria-label', T.barraPrueba);

      var lectura = document.createElement('p');
      lectura.className = 'hueco__reloj tnum';

      function refresca() {
        lectura.textContent = A.reloj(Number(barra.value)) + ' / ' + A.reloj(total);
      }
      refresca();

      barra.addEventListener('input', refresca);
      /* Se guarda al soltar, no en cada pixel del arrastre. */
      barra.addEventListener('change', function () {
        A.ver(clase.id, Number(barra.value), total);
        pintarTodo();
      });

      var pie = document.createElement('p');
      pie.className = 'hueco__pie';
      pie.textContent = T.barraPrueba;

      hueco.append(h, p, barra, lectura, pie);
      marco.appendChild(hueco);
    }

    /* =====================================================================
       El resto de la escena
       ===================================================================== */

    function pintarClase(clase) {
      $('[data-clase-unidad]').textContent =
        clase.uniTitulo;
      $('[data-clase-titulo]').textContent = clase.titulo;

      var p = A.de(clase.id);
      var total = clase.duracion || p.d;
      var meta = A.reloj(total);
      if (p.s > 8 && !p.hecho) meta += ' · ' + T.retomado + ' ' + A.reloj(p.s);
      $('[data-clase-meta]').textContent = meta;

      var resumen = $('[data-clase-resumen]');
      resumen.textContent = clase.resumen || '';
      resumen.hidden = !clase.resumen;

      /* --- Marcar como vista ------------------------------------------- */
      var btn = $('[data-marcar]');
      btn.setAttribute('aria-pressed', p.hecho ? 'true' : 'false');
      btn.classList.toggle('is-on', p.hecho);
      $('[data-marcar-txt]').textContent = p.hecho ? T.hecha : T.marcar;

      /* --- Material ----------------------------------------------------- */
      var caja = $('[data-material]');
      var lista = $('[data-material-lista]');
      lista.textContent = '';
      if (clase.recursos.length) {
        clase.recursos.forEach(function (r) {
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.href = r.href;
          a.textContent = r.nombre;
          li.appendChild(a);
          lista.appendChild(li);
        });
        caja.hidden = false;
      } else {
        caja.hidden = true;
      }

      /* --- Anterior y siguiente ------------------------------------------ */
      var i = CLASES.findIndex(function (c) { return c.id === clase.id; });
      paso('[data-paso-prev]', '[data-paso-prev-t]', CLASES[i - 1]);
      paso('[data-paso-next]', '[data-paso-next-t]', CLASES[i + 1]);
    }

    function paso(selA, selT, clase) {
      var el = $(selA);
      if (!clase) { el.hidden = true; return; }
      el.hidden = false;
      el.href = '#' + clase.id;
      $(selT).textContent = clase.titulo;
    }

    /* =====================================================================
       El índice y la barra del curso
       ===================================================================== */

    function pintarIndice(clase) {
      var hechas = 0;
      CLASES.forEach(function (c) {
        var p = A.de(c.id);
        if (p.hecho) hechas++;
        var fila = document.querySelector('[data-fila="' + c.id + '"]');
        if (!fila) return;
        fila.classList.toggle('is-hecha', p.hecho);
        var esta = c.id === clase.id;
        fila.classList.toggle('is-aqui', esta);
        if (esta) fila.setAttribute('aria-current', 'true');
        else fila.removeAttribute('aria-current');
      });

      var pct = Math.round((hechas / CLASES.length) * 100);
      var meter = $('[data-cabeza-meter]');
      meter.querySelector('.meter__fill').style.setProperty('--pct', pct + '%');
      meter.classList.toggle('meter--done', pct === 100);
      $('[data-cabeza-cifras]').textContent =
        hechas + ' / ' + CLASES.length + ' · ' + pct + ' %';
    }

    /* =====================================================================
       El hilo de preguntas
       ===================================================================== */

    function pintarHilo() {
      var lista = $('[data-hilo]');
      if (!lista) return;
      lista.textContent = '';

      var mias = A.preguntas(CURSO.slug);
      if (!mias.length) {
        var vacio = document.createElement('li');
        vacio.className = 'hilo__vacio soft';
        vacio.textContent = T.hiloVacio;
        lista.appendChild(vacio);
        return;
      }

      mias.forEach(function (q) {
        var clase = CLASES.find(function (c) { return c.id === q.clase; });
        var li = document.createElement('li');
        li.className = 'msj';

        var cab = document.createElement('p');
        cab.className = 'msj__cab soft';
        var donde = clase ? clase.titulo : '';
        if (q.minuto != null) donde += ' · ' + T.en + ' ' + A.reloj(q.minuto);
        cab.textContent = donde;

        var txt = document.createElement('p');
        txt.className = 'msj__txt';
        txt.textContent = q.texto;

        var pie = document.createElement('p');
        pie.className = 'msj__pie';
        var estado = document.createElement('span');
        estado.className = 'msj__estado';
        estado.textContent = q.estado === 'respondida' ? T.respondida : T.esperando;
        var borrar = document.createElement('button');
        borrar.className = 'btn-text';
        borrar.type = 'button';
        borrar.textContent = T.borrar;
        borrar.addEventListener('click', function () {
          A.borrarPregunta(q.id);
          pintarHilo();
        });
        pie.append(estado, borrar);

        li.append(cab, txt, pie);
        lista.appendChild(li);
      });
    }

    /* =====================================================================
       El formulario de la duda
       ===================================================================== */

    var dlg = $('[data-duda]');

    function abrirDuda() {
      var p = A.de(actual.id);
      var minuto = Math.floor(p.s || 0);
      dlg.dataset.minuto = String(minuto);
      $('[data-duda-ctx]').textContent = actual.titulo;
      $('[data-duda-minuto-txt]').textContent = T.en + ' ' + A.reloj(minuto);
      $('[data-duda-con-minuto]').checked = minuto > 0;
      $('[data-duda-con-minuto]').closest('.duda__minuto').hidden = minuto <= 0;
      $('[data-duda-texto]').value = '';
      $('[data-duda-error]').hidden = true;
      if (typeof dlg.showModal === 'function') dlg.showModal();
      else dlg.setAttribute('open', '');
      $('[data-duda-texto]').focus();
    }

    function cerrarDuda() {
      if (typeof dlg.close === 'function') dlg.close();
      else dlg.removeAttribute('open');
    }

    document.querySelectorAll('[data-abrir-duda]').forEach(function (b) {
      b.addEventListener('click', abrirDuda);
    });
    $('[data-duda-cancelar]').addEventListener('click', cerrarDuda);

    $('[data-duda-enviar]').addEventListener('click', function () {
      var texto = $('[data-duda-texto]').value.trim();
      if (!texto) {
        $('[data-duda-error]').hidden = false;
        $('[data-duda-texto]').focus();
        return;
      }
      var conMinuto = $('[data-duda-con-minuto]').checked;
      A.preguntar({
        curso: CURSO.slug,
        clase: actual.id,
        minuto: conMinuto ? Number(dlg.dataset.minuto) : null,
        texto: texto,
      });
      cerrarDuda();
      pintarHilo();
      document.dispatchEvent(new CustomEvent('aula:pintado'));
      $('.hilo').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    /* =====================================================================
       Enganchar todo
       ===================================================================== */

    $('[data-marcar]').addEventListener('click', function () {
      var p = A.de(actual.id);
      A.marcar(actual.id, !p.hecho);
      pintarTodo();
    });

    function pintarTodo() {
      pintarClase(actual);
      pintarIndice(actual);
    }

    function ir(clase, mueveHash) {
      actual = clase;
      A.ultima(CURSO.slug, clase.id);
      if (mueveHash && location.hash !== '#' + clase.id) {
        history.replaceState(null, '', '#' + clase.id);
      }
      pintarMarco(clase);
      pintarTodo();
      document.dispatchEvent(new CustomEvent('aula:pintado'));
    }

    window.addEventListener('hashchange', function () {
      var c = desdeHash();
      if (c && (!actual || c.id !== actual.id)) {
        ir(c, false);
        /* El índice y la escena están en columnas distintas: al pulsar una
           clase del índice en móvil, la escena queda arriba y fuera de vista. */
        var escena = document.querySelector('.escena');
        if (escena && window.matchMedia('(max-width: 62rem)').matches) {
          escena.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });

    ir(alEntrar(), true);
    pintarHilo();
  })();
</script>

