---
/**
 * El reproductor de un curso — el índice, la clase y el hilo de dudas.
 *
 * Hace lo que hacía Tutor LMS en el WordPress viejo —un curso, sus bloques,
 * sus clases y el video en el centro— y lo que no hacía. Las decisiones que
 * mandan, de la maqueta del 11 sep 2026 y todas en pie:
 *
 * 1. **Una sola página por curso, no una por clase.** Cambiar de clase es
 *    cambiar el `#hash`: el índice no parpadea, el scroll no se pierde y pasar
 *    de la clase 4 a la 5 es instantáneo. El hash es además una dirección que
 *    se puede pegar en un correo.
 * 2. **El progreso se guarda solo.** El reproductor avisa del minuto, se apunta
 *    cada cinco segundos y al volver se retoma ahí. Pasado el 92 % la clase se
 *    da por vista. El botón de marcar sigue, para corregir a la máquina.
 * 3. **Entrar sin hash abre la última clase tocada**, no la primera.
 * 4. **Un hilo de dudas por alumna y por curso**, con el botón de preguntar en
 *    cada clase: la duda viaja con la clase y el minuto pegados.
 *
 * **Desde el 23 sep 2026 el curso llega por consulta** (`src/lib/aula-datos.ts`):
 * lo carga Emi desde su panel, vive en Supabase y la RLS decide quién lo ve.
 * Nada del contenido va escrito en esta página; el servidor pinta el esqueleto.
 * Y el avance y las dudas se guardan en la base de datos, atados a la persona,
 * no en el navegador: siguen ahí al cambiar de equipo.
 *
 * ⚠️ **Esta pantalla necesita JavaScript**, y es de las pocas del proyecto que
 * lo necesitan: un reproductor que recuerda el minuto es una aplicación.
 */
import type { Lang } from '../../i18n/ui';
import { useAula, escritorioPath, panelPath } from '../../i18n/aula';
import { catalogo } from '../../data/aula';
import Boton from '../Boton.astro';

interface Props {
  lang: Lang;
  /**
   * El slug, si la página es la de un curso concreto. Sin él, la pantalla lo
   * lee de `?c=` —es la página genérica de los cursos que todavía no tienen
   * ficha en Formaciones, ver `cursoLibrePath()`—.
   */
  slug?: string;
}
const { lang, slug } = Astro.props;
const a = useAula(lang);

const paraJs = {
  lang,
  slug: slug ?? null,
  nombres: Object.fromEntries(
    catalogo.filter((p) => p.tipo === 'curso').map((p) => [p.slug, p.copia[lang].nombre]),
  ),
  panel: panelPath(),
  t: {
    clases: a('course.lessons'),
    hecha: a('player.markUndone'),
    marcar: a('player.markDone'),
    retomado: a('player.resumed'),
    sinVideo: a('player.noVideo'),
    sinVideoPie: a('player.noVideoLead'),
    barraPrueba: a('player.demoBar'),
    otroIdioma: a('player.otherLang'),
    esperando: a('ask.waiting'),
    respondida: a('ask.answered'),
    hiloVacio: a('ask.threadEmpty'),
    retirar: a('ask.deleteOne'),
    vacia: a('ask.empty'),
    fallo: a('ask.failed'),
    en: a('ask.at'),
    emi: a('ask.emi'),
    borrador: a('desk.draft'),
  },
};
---

<script type="application/json" id="curso-datos" set:html={JSON.stringify(paraJs)} />

<div class="curso" data-curso-app>
  <noscript>
    <div class="app-wrap curso-estado">
      <p class="aviso">{a('player.nojs')}</p>
    </div>
  </noscript>

  {/* --- Los tres estados antes del curso ----------------------------------- */}
  <section class="app-wrap curso-estado" data-c-cargando>
    <p class="soft" role="status">{a('course.loading')}</p>
  </section>

  <section class="app-wrap curso-estado" data-c-nada hidden>
    <h1 class="app-h1 app-h1--sm">{a('course.notFound')}</h1>
    <p class="app-lead curso-estado__lead">{a('course.notFoundLead')}</p>
    <Boton href={escritorioPath(lang)}>{a('app.backDesk')}</Boton>
  </section>

  <section class="app-wrap curso-estado" data-c-vacio hidden>
    <p class="eyebrow" data-c-vacio-nombre></p>
    <h1 class="app-h1 app-h1--sm">{a('course.empty')}</h1>
    <p class="app-lead curso-estado__lead">{a('course.emptyLead')}</p>
    <Boton href={escritorioPath(lang)}>{a('app.backDesk')}</Boton>
  </section>

  {/* --- El curso ------------------------------------------------------------- */}
  <div data-c-listo hidden>
    <header class="app-wrap cabeza">
      <h1 class="app-h1 cabeza__h" data-c-nombre></h1>
      <p class="aviso cabeza__borrador" data-c-borrador hidden>
        {a('course.draft')}
        <a href={panelPath() + '#cursos'}>{a('course.editInPanel')}</a>
      </p>
      <div class="cabeza__barra">
        <div class="meter"><span class="meter__fill" data-c-fill></span></div>
        <p class="mono soft tnum cabeza__cifras" data-c-cifras></p>
      </div>
    </header>

    <div class="app-wrap rejilla2">
      {/* --- La escena: el video y todo lo de esta clase ----------------- */}
      <div class="escena">
        <div class="marco" data-marco></div>
        <p class="mono soft escena__idioma" data-otro-idioma hidden></p>

        <div class="clase">
          <p class="eyebrow" data-clase-unidad></p>
          <h2 class="clase__h" data-clase-titulo></h2>
          <p class="estado clase__borrador" data-clase-borrador hidden>{a('player.draftLesson')}</p>
          <p class="clase__meta mono soft tnum" data-clase-meta></p>

          <div class="clase__actos">
            <button class="marcar mono" type="button" data-marcar aria-pressed="false">
              <span class="marcar__caja" aria-hidden="true"></span>
              <span data-marcar-txt>{a('player.markDone')}</span>
            </button>
            <Boton class="boton--sm" type="button" data-abrir-duda>{a('ask.open')}</Boton>
          </div>

          <div class="clase__resumen" data-clase-resumen></div>

          <div class="material" data-material hidden>
            <p class="eyebrow">{a('player.resources')}</p>
            <ul class="material__lista" role="list" data-material-lista></ul>
          </div>

          <nav class="pasos" aria-label={a('player.contents')}>
            <a class="pasos__a" data-paso-prev hidden>
              <span class="mono soft">← {a('player.prev')}</span>
              <span class="pasos__t" data-paso-prev-t></span>
            </a>
            <a class="pasos__a pasos__a--next" data-paso-next hidden>
              <span class="mono soft">{a('player.next')} →</span>
              <span class="pasos__t" data-paso-next-t></span>
            </a>
          </nav>
        </div>
      </div>

      {/* --- El índice ---------------------------------------------------- */}
      <aside class="indice" aria-label={a('player.contents')}>
        <p class="eyebrow indice__h">{a('player.contents')}</p>
        <div data-indice></div>
      </aside>

      {/* --- El hilo de dudas --------------------------------------------- */}
      <section class="hilo" aria-labelledby="hilo-h">
        <div class="hilo__cab">
          <h2 class="app-h2" id="hilo-h">{a('ask.thread')}</h2>
          <Boton class="boton--sm" type="button" data-abrir-duda>{a('ask.open')}</Boton>
        </div>
        <p class="hilo__nota soft" data-hilo-maqueta hidden>{a('ask.local')}</p>
        <ul class="hilo__lista" role="list" data-hilo></ul>
      </section>
    </div>

    {/* --- El formulario de la duda ------------------------------------------ */}
    <dialog class="dialogo" data-duda aria-labelledby="duda-h">
      <form method="dialog" class="dialogo__cuerpo" data-duda-form>
        <p class="eyebrow" data-duda-curso></p>
        <h2 class="app-h2 duda__h" id="duda-h">{a('ask.title')}</h2>
        <p class="duda__lead soft">{a('ask.lead')}</p>

        {/*
          El contexto no se pide: ya se sabe. La alumna lo ve —y puede quitar el
          minuto si su duda no es de un punto concreto—, pero no lo escribe.
        */}
        <p class="duda__ctx" data-duda-ctx></p>
        <label class="casilla duda__minuto">
          <input type="checkbox" checked data-duda-con-minuto />
          <span data-duda-minuto-txt></span>
        </label>

        <label class="campo duda__campo">
          <span class="campo__t">{a('ask.label')}</span>
          <textarea rows="5" placeholder={a('ask.placeholder')} data-duda-texto></textarea>
        </label>
        <p class="error duda__error" data-duda-error hidden></p>

        <div class="dialogo__pie">
          <button class="btn-text" type="button" data-duda-cancelar>{a('ask.cancel')}</button>
          <Boton class="boton--solid" type="button" data-duda-enviar>{a('ask.send')}</Boton>
        </div>
      </form>
    </dialog>
  </div>
</div>

<script>
  import {
    datos,
    reloj,
    avanzar,
    avanceVacio,
    type Avance,
    type Clase,
    type Curso,
    type Material,
    type Pregunta,
  } from '../../lib/aula-datos';
  import { acceso } from '../../lib/aula-acceso';
  import { videoEmbed } from '../../lib/video';

  const D = JSON.parse(document.getElementById('curso-datos')!.textContent!) as {
    lang: 'es' | 'en';
    slug: string | null;
    nombres: Record<string, string>;
    panel: string;
    t: Record<string, string>;
  };
  const { lang, t } = D;
  const $ = <T extends HTMLElement = HTMLElement>(s: string, en: ParentNode = document) =>
    en.querySelector<T>(s)!;

  const tx = (es?: string | null, en?: string | null) =>
    (lang === 'en' ? en || es : es || en) || '';

  type ClaseV = Clase & { unidad: string; num: number };

  let CURSO: Curso;
  let CLASES: ClaseV[] = [];
  let AV: Record<string, Avance> = {};
  let actual: ClaseV | null = null;
  let nombreAlumna: string | null = null;

  /* =======================================================================
     Qué clase toca
     ======================================================================= */

  function desdeHash(): ClaseV | null {
    const id = decodeURIComponent(location.hash.replace(/^#/, ''));
    return CLASES.find((c) => c.id === id) ?? null;
  }

  /** Sin hash: la clase tocada más recientemente de este curso, no la primera. */
  function alEntrar(): ClaseV {
    const h = desdeHash();
    if (h) return h;
    let mejor: ClaseV | null = null;
    CLASES.forEach((c) => {
      const p = AV[c.id];
      if (p?.ts && (!mejor || p.ts > (AV[mejor.id]?.ts ?? 0))) mejor = c;
    });
    return mejor ?? CLASES[0];
  }

  const de = (id: string): Avance => AV[id] ?? avanceVacio();

  function guardar(clase: ClaseV, a: Avance) {
    AV[clase.id] = a;
    void datos.guardar(CURSO.id, clase.id, a);
  }

  /* =======================================================================
     El marco: el reproductor de Bunny, o el hueco anunciado
     ======================================================================= */

  /**
   * El puente con el reproductor de Bunny Stream, que habla **player.js** por
   * `postMessage`: se le pide que avise del minuto y se le puede mandar a un
   * segundo concreto.
   *
   * ⚠️ Escrito contra la documentación de Bunny y probado solo con su
   * protocolo, no con un video de Emi. El día que se vea el primero hay que
   * comprobar dos cosas: que llegan los `timeupdate` y que `setCurrentTime`
   * salta de verdad. Si algo no encaja, se arregla acá y en ningún otro sitio.
   * Si el puente no contesta, lo que se pierde es el guardado automático, no
   * la clase: por eso el botón de marcar a mano no se esconde nunca.
   */
  function puente(iframe: HTMLIFrameElement, clase: ClaseV) {
    let listo = false;
    let ultimo = 0;

    const manda = (method: string, value?: unknown) =>
      iframe.contentWindow?.postMessage(
        JSON.stringify({ context: 'player.js', version: '0.0.11', method, value }),
        '*',
      );
    const suscribe = (evento: string) => manda('addEventListener', evento);

    function alMensaje(e: MessageEvent) {
      if (!iframe.contentWindow || e.source !== iframe.contentWindow) return;
      let d = e.data;
      if (typeof d === 'string') {
        try {
          d = JSON.parse(d);
        } catch {
          return;
        }
      }
      if (!d || d.context !== 'player.js') return;

      if (d.event === 'ready') {
        listo = true;
        suscribe('timeupdate');
        suscribe('ended');
        /* Retomar donde se quedó. Con menos de 8 s se empieza de cero: eso no es
           «por donde iba», es haberle dado sin querer. */
        const p = de(clase.id);
        if (p.s > 8 && !p.hecho) manda('setCurrentTime', p.s);
        return;
      }

      if (d.event === 'timeupdate' && d.value) {
        const s = d.value.seconds || 0;
        const dur = d.value.duration || clase.duration_s || 0;
        /* Cada cinco segundos, no en cada aviso: el reproductor avisa varias
           veces por segundo y escribir a ese ritmo no gana precisión. */
        if (s - ultimo >= 5 || s < ultimo) {
          ultimo = s;
          guardar(clase, avanzar(de(clase.id), s, dur));
          pintarTodo();
        }
        return;
      }

      if (d.event === 'ended') {
        guardar(clase, { ...de(clase.id), hecho: true, ts: Date.now() });
        pintarTodo();
      }
    }

    window.addEventListener('message', alMensaje);

    /* Algunos reproductores no mandan `ready` si el oyente llega tarde. Se le
       pregunta un par de veces y se deja de insistir. */
    let intentos = 0;
    const golpes = window.setInterval(() => {
      if (listo || intentos++ > 6) return window.clearInterval(golpes);
      suscribe('ready');
      suscribe('timeupdate');
    }, 400);

    return () => {
      window.clearInterval(golpes);
      window.removeEventListener('message', alMensaje);
    };
  }

  let soltarPuente: (() => void) | null = null;

  function pintarMarco(clase: ClaseV) {
    soltarPuente?.();
    soltarPuente = null;
    const marco = $('[data-marco]');
    marco.textContent = '';

    /* El video del idioma de la página; si no lo hay, el del otro, y se dice.
       Un video en el otro idioma es mejor que un marco vacío. */
    const propio = lang === 'en' ? clase.video_en : clase.video_es;
    const otro = lang === 'en' ? clase.video_es : clase.video_en;
    const emb = videoEmbed(propio || otro);
    const aviso = $('[data-otro-idioma]');
    aviso.hidden = !(emb.ok && !propio && otro);
    aviso.textContent = t.otroIdioma;

    if (emb.ok) {
      const iframe = document.createElement('iframe');
      iframe.src = emb.src;
      iframe.title = tx(clase.title_es, clase.title_en);
      iframe.loading = 'lazy';
      iframe.allow = emb.allow;
      iframe.allowFullscreen = true;
      marco.appendChild(iframe);
      if (emb.provider === 'bunny') soltarPuente = puente(iframe, clase);
      return;
    }

    /* --- El hueco anunciado ------------------------------------------------ */
    const hueco = document.createElement('div');
    hueco.className = 'hueco';
    const h = document.createElement('p');
    h.className = 'hueco__h';
    h.textContent = t.sinVideo;
    hueco.appendChild(h);

    /* La barra de prueba solo en la maqueta: sirve para probar que el avance se
       guarda sin un solo video. En una clase de verdad sin video no se finge
       nada. */
    if (datos.modo === 'maqueta') {
      const p = document.createElement('p');
      p.className = 'hueco__p';
      p.textContent = t.sinVideoPie;
      const total = clase.duration_s || 600;
      const barra = document.createElement('input');
      barra.type = 'range';
      barra.className = 'hueco__barra';
      barra.min = '0';
      barra.max = String(total);
      barra.step = '1';
      barra.value = String(Math.min(de(clase.id).s, total));
      barra.setAttribute('aria-label', t.barraPrueba);
      const lectura = document.createElement('p');
      lectura.className = 'hueco__reloj mono tnum';
      const refresca = () => (lectura.textContent = `${reloj(Number(barra.value))} / ${reloj(total)}`);
      refresca();
      barra.addEventListener('input', refresca);
      barra.addEventListener('change', () => {
        guardar(clase, avanzar(de(clase.id), Number(barra.value), total));
        pintarTodo();
      });
      hueco.append(p, barra, lectura);
    }
    marco.appendChild(hueco);
  }

  /* =======================================================================
     La clase
     ======================================================================= */

  /** Párrafos separados por una línea en blanco; saltos simples, respetados. */
  function pintarTexto(caja: HTMLElement, texto: string) {
    caja.textContent = '';
    texto
      .split(/\n\s*\n/)
      .map((p) => p.trim())
      .filter(Boolean)
      .forEach((p) => {
        const el = document.createElement('p');
        el.textContent = p;
        caja.appendChild(el);
      });
    caja.hidden = !texto.trim();
  }

  const nombreMaterial = (m: Material) => tx(m.nombre_es, m.nombre_en) || 'Material';

  async function pintarMaterial(clase: ClaseV) {
    const caja = $('[data-material]');
    const lista = $('[data-material-lista]');
    lista.textContent = '';
    const mios = clase.materials.filter((m) => m.lang === 'ambos' || m.lang === lang);
    caja.hidden = mios.length === 0;
    for (const m of mios) {
      const li = document.createElement('li');
      const enlace = document.createElement('a');
      enlace.textContent = nombreMaterial(m);
      enlace.target = '_blank';
      enlace.rel = 'noopener';
      li.appendChild(enlace);
      lista.appendChild(li);
      /* Los del bucket son privados: el enlace se pide firmado, y caduca. */
      datos.enlace(m).then((url) => {
        if (url && actual?.id === clase.id) enlace.href = url;
      });
    }
  }

  function pintarClase(clase: ClaseV) {
    $('[data-clase-unidad]').textContent = clase.unidad;
    $('[data-clase-titulo]').textContent = tx(clase.title_es, clase.title_en);
    $('[data-clase-borrador]').hidden = clase.published;

    const p = de(clase.id);
    const total = clase.duration_s || p.d;
    let meta = total ? reloj(total) : '';
    if (p.s > 8 && !p.hecho) meta += `${meta ? ' · ' : ''}${t.retomado} ${reloj(p.s)}`;
    $('[data-clase-meta]').textContent = meta;

    pintarTexto($('[data-clase-resumen]'), tx(clase.summary_es, clase.summary_en));

    const btn = $('[data-marcar]');
    btn.setAttribute('aria-pressed', p.hecho ? 'true' : 'false');
    btn.classList.toggle('is-on', p.hecho);
    $('[data-marcar-txt]').textContent = p.hecho ? t.hecha : t.marcar;

    const i = CLASES.findIndex((c) => c.id === clase.id);
    paso('[data-paso-prev]', '[data-paso-prev-t]', CLASES[i - 1]);
    paso('[data-paso-next]', '[data-paso-next-t]', CLASES[i + 1]);
  }

  function paso(selA: string, selT: string, clase?: ClaseV) {
    const el = $<HTMLAnchorElement>(selA);
    if (!clase) {
      el.hidden = true;
      return;
    }
    el.hidden = false;
    el.href = `#${clase.id}`;
    $(selT).textContent = tx(clase.title_es, clase.title_en);
  }

  /* =======================================================================
     El índice y la barra del curso
     ======================================================================= */

  function armarIndice() {
    const caja = $('[data-indice]');
    caja.textContent = '';
    CURSO.unidades.forEach((u, iu) => {
      if (!u.clases.length) return;
      const sec = document.createElement('section');
      sec.className = 'unidad';
      const h = document.createElement('h3');
      h.className = 'unidad__h';
      const n = document.createElement('span');
      n.className = 'mono soft unidad__n';
      n.textContent = String(iu + 1).padStart(2, '0');
      const tt = document.createElement('span');
      tt.textContent = tx(u.title_es, u.title_en);
      h.append(n, tt);
      const ol = document.createElement('ol');
      ol.className = 'unidad__lista';
      ol.setAttribute('role', 'list');
      u.clases.forEach((l) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.className = 'fila';
        a.href = `#${l.id}`;
        a.dataset.fila = l.id;
        const tic = document.createElement('span');
        tic.className = 'fila__tic';
        tic.setAttribute('aria-hidden', 'true');
        const titulo = document.createElement('span');
        titulo.className = 'fila__t';
        titulo.textContent = tx(l.title_es, l.title_en);
        if (!l.published) {
          const b = document.createElement('span');
          b.className = 'mono soft fila__borr';
          b.textContent = ` · ${t.borrador.split('·')[0].trim()}`;
          titulo.appendChild(b);
        }
        const dur = document.createElement('span');
        dur.className = 'fila__d mono soft tnum';
        dur.textContent = reloj(l.duration_s);
        a.append(tic, titulo, dur);
        li.appendChild(a);
        ol.appendChild(li);
      });
      sec.append(h, ol);
      caja.appendChild(sec);
    });
  }

  function pintarIndice(clase: ClaseV) {
    let hechas = 0;
    CLASES.forEach((c) => {
      const p = de(c.id);
      if (p.hecho) hechas++;
      const fila = document.querySelector<HTMLElement>(`[data-fila="${c.id}"]`);
      if (!fila) return;
      fila.classList.toggle('is-hecha', p.hecho);
      const esta = c.id === clase.id;
      fila.classList.toggle('is-aqui', esta);
      if (esta) fila.setAttribute('aria-current', 'true');
      else fila.removeAttribute('aria-current');
    });
    const pct = CLASES.length ? Math.round((hechas / CLASES.length) * 100) : 0;
    $('[data-c-fill]').style.setProperty('--pct', `${pct}%`);
    $('[data-c-cifras]').textContent = `${hechas} / ${CLASES.length} ${t.clases} · ${pct} %`;
  }

  function pintarTodo() {
    if (!actual) return;
    pintarClase(actual);
    pintarIndice(actual);
  }

  /* =======================================================================
     El hilo de dudas
     ======================================================================= */

  async function pintarHilo() {
    const lista = $('[data-hilo]');
    let mias: Pregunta[] = [];
    try {
      mias = await datos.preguntas(CURSO.id);
    } catch (e) {
      console.error('[curso] no se pudieron leer las dudas', e);
    }
    lista.textContent = '';
    if (!mias.length) {
      const vacio = document.createElement('li');
      vacio.className = 'soft hilo__vacio';
      vacio.textContent = t.hiloVacio;
      lista.appendChild(vacio);
      return;
    }
    mias.forEach((q) => {
      const clase = CLASES.find((c) => c.id === q.lesson_id);
      const li = document.createElement('li');
      li.className = 'msj';

      const cab = document.createElement('p');
      cab.className = 'mono soft msj__cab';
      let donde = clase ? tx(clase.title_es, clase.title_en) : '';
      if (q.minute_s != null) donde += `${donde ? ' · ' : ''}${t.en} ${reloj(q.minute_s)}`;
      cab.textContent = donde;

      const txt = document.createElement('p');
      txt.className = 'msj__txt';
      txt.textContent = q.body;
      li.append(cab, txt);

      if (q.answer) {
        const r = document.createElement('div');
        r.className = 'msj__resp';
        const quien = document.createElement('p');
        quien.className = 'mono msj__quien';
        quien.textContent = t.emi;
        const rt = document.createElement('p');
        rt.className = 'msj__txt';
        rt.textContent = q.answer;
        r.append(quien, rt);
        li.appendChild(r);
      }

      const pie = document.createElement('p');
      pie.className = 'msj__pie';
      const estado = document.createElement('span');
      estado.className = q.answer ? 'estado estado--tinta' : 'estado';
      estado.textContent = q.answer ? t.respondida : t.esperando;
      pie.appendChild(estado);
      if (!q.answer) {
        const retirar = document.createElement('button');
        retirar.className = 'btn-text';
        retirar.type = 'button';
        retirar.textContent = t.retirar;
        retirar.addEventListener('click', async () => {
          retirar.disabled = true;
          try {
            await datos.borrarPregunta(q.id);
          } catch (e) {
            console.error('[curso] no se pudo retirar', e);
          }
          void pintarHilo();
        });
        pie.appendChild(retirar);
      }
      li.appendChild(pie);
      lista.appendChild(li);
    });
  }

  /* =======================================================================
     El formulario de la duda
     ======================================================================= */

  const dlg = $<HTMLDialogElement>('[data-duda]');

  function abrirDuda() {
    if (!actual) return;
    const minuto = Math.floor(de(actual.id).s || 0);
    dlg.dataset.minuto = String(minuto);
    $('[data-duda-curso]').textContent = $('[data-c-nombre]').textContent || '';
    $('[data-duda-ctx]').textContent = tx(actual.title_es, actual.title_en);
    $('[data-duda-minuto-txt]').textContent = `${t.en} ${reloj(minuto)}`;
    const conMinuto = $<HTMLInputElement>('[data-duda-con-minuto]');
    conMinuto.checked = minuto > 0;
    conMinuto.closest<HTMLElement>('label')!.hidden = minuto <= 0;
    $<HTMLTextAreaElement>('[data-duda-texto]').value = '';
    $('[data-duda-error]').hidden = true;
    dlg.showModal();
    $('[data-duda-texto]').focus();
  }

  document
    .querySelectorAll('[data-abrir-duda]')
    .forEach((b) => b.addEventListener('click', abrirDuda));
  $('[data-duda-cancelar]').addEventListener('click', () => dlg.close());

  $('[data-duda-enviar]').addEventListener('click', async () => {
    const texto = $<HTMLTextAreaElement>('[data-duda-texto]').value.trim();
    const error = $('[data-duda-error]');
    if (!texto) {
      error.textContent = t.vacia;
      error.hidden = false;
      $('[data-duda-texto]').focus();
      return;
    }
    const boton = $<HTMLButtonElement>('[data-duda-enviar]');
    boton.disabled = true;
    try {
      await datos.preguntar({
        curso: CURSO.id,
        clase: actual?.id ?? null,
        minuto: $<HTMLInputElement>('[data-duda-con-minuto]').checked
          ? Number(dlg.dataset.minuto)
          : null,
        texto,
        nombre: nombreAlumna,
      });
      dlg.close();
      await pintarHilo();
      $('.hilo').scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (e) {
      console.error('[curso] no se pudo enviar la duda', e);
      error.textContent = t.fallo;
      error.hidden = false;
    } finally {
      boton.disabled = false;
    }
  });

  /* =======================================================================
     Enganchar todo
     ======================================================================= */

  $('[data-marcar]').addEventListener('click', () => {
    if (!actual) return;
    const p = de(actual.id);
    guardar(actual, { ...p, hecho: !p.hecho, ts: Date.now() });
    pintarTodo();
  });

  function ir(clase: ClaseV, mueveHash: boolean) {
    actual = clase;
    if (mueveHash && location.hash !== `#${clase.id}`) {
      history.replaceState(null, '', `${location.pathname}${location.search}#${clase.id}`);
    }
    pintarMarco(clase);
    pintarTodo();
    void pintarMaterial(clase);
  }

  window.addEventListener('hashchange', () => {
    const c = desdeHash();
    if (c && (!actual || c.id !== actual.id)) {
      ir(c, false);
      /* El índice y la escena están en columnas distintas: en el teléfono, al
         pulsar una clase del índice la escena queda arriba y fuera de vista. */
      if (window.matchMedia('(max-width: 62rem)').matches) {
        document.querySelector('.escena')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  });

  /** «Ana Pérez» → «Ana P.», como en el foro de la membresía. */
  function nombreCorto(nombre: string | null): string | null {
    if (!nombre) return null;
    const [primero, segundo] = nombre.trim().split(/\s+/);
    return segundo ? `${primero} ${segundo[0].toUpperCase()}.` : primero;
  }

  /**
   * En la página genérica (`?c=`), el conmutador de idioma del menú apunta a la
   * página genérica del otro idioma, sin el curso. Se le pega acá.
   */
  function arreglarIdioma(slug: string) {
    if (D.slug) return;
    document.querySelectorAll<HTMLAnchorElement>('a[hreflang]').forEach((a) => {
      if (/\/(curso|course)\/$/.test(new URL(a.href).pathname)) {
        a.href = `${a.href.split('?')[0]}?c=${encodeURIComponent(slug)}`;
      }
    });
  }

  (async () => {
    const slug = D.slug ?? new URLSearchParams(location.search).get('c') ?? '';
    const cargando = $('[data-c-cargando]');
    try {
      const quien = await acceso();
      if (datos.modo === 'supabase' && !quien.sesion) return;
      nombreAlumna = nombreCorto(quien.nombre);

      const curso = slug ? await datos.curso(slug) : null;
      cargando.hidden = true;
      if (!curso) {
        $('[data-c-nada]').hidden = false;
        return;
      }
      CURSO = curso;
      arreglarIdioma(slug);
      const nombre = tx(curso.title_es, curso.title_en) || D.nombres[curso.slug] || curso.slug;
      document.title = document.title.replace(/^[^·]+/, `${nombre} `);

      CLASES = [];
      curso.unidades.forEach((u) =>
        u.clases.forEach((l, i) =>
          CLASES.push({ ...l, unidad: tx(u.title_es, u.title_en), num: i + 1 }),
        ),
      );
      if (!CLASES.length) {
        $('[data-c-vacio-nombre]').textContent = nombre;
        $('[data-c-vacio]').hidden = false;
        return;
      }

      const todo = await datos.avance();
      AV = {};
      Object.entries(todo).forEach(([id, a]) => {
        if (CLASES.some((c) => c.id === id)) AV[id] = a;
      });

      $('[data-c-nombre]').textContent = nombre;
      $('[data-c-borrador]').hidden = curso.published;
      $('[data-hilo-maqueta]').hidden = datos.modo !== 'maqueta';
      $('[data-c-listo]').hidden = false;

      armarIndice();
      ir(alEntrar(), true);
      void pintarHilo();
      document.dispatchEvent(new CustomEvent('botones:nuevos'));
    } catch (e) {
      console.error('[curso]', e);
      cargando.hidden = true;
      $('[data-c-nada]').hidden = false;
    }
  })();
</script>

<style>
  /* --- Antes del curso ------------------------------------------------------ */
  .curso-estado {
    padding-block: var(--space-8);
  }

  .curso-estado__lead {
    margin: var(--space-3) 0 var(--space-4);
  }

  /* --- La cabecera del curso ----------------------------------------------- */
  .cabeza {
    padding-top: var(--space-6);
  }

  .cabeza__borrador {
    margin-top: var(--space-3);
    max-width: var(--measure);
  }

  .cabeza__borrador a {
    margin-left: 0.25em;
  }

  .cabeza__barra {
    max-width: 26rem;
    margin-top: var(--space-4);
  }

  .cabeza__cifras {
    margin-top: var(--space-1);
  }

  /* --- Las columnas --------------------------------------------------------
     En el teléfono manda el orden del HTML —escena, índice, hilo—: primero el
     video, que es a lo que se viene. En pantalla ancha el índice se va a la
     izquierda y se queda pegado. */
  .rejilla2 {
    display: grid;
    gap: var(--space-6);
    align-items: start;
    margin-top: var(--space-6);
  }

  @media (min-width: 62rem) {
    .rejilla2 {
      grid-template-columns: 20rem minmax(0, 1fr);
    }

    .escena {
      grid-column: 2;
      grid-row: 1;
    }

    /* 96 px arriba: la cápsula del menú flota encima (76 px) más su aire. */
    .indice {
      grid-column: 1;
      grid-row: 1 / span 2;
      position: sticky;
      top: var(--space-12);
      max-height: calc(100vh - var(--space-12) - var(--space-3));
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .hilo {
      grid-column: 2;
      grid-row: 2;
    }
  }

  /* --- El marco del video ---------------------------------------------------
     16:9, sin sombra y sin esquinas: el video es el contenido, no una tarjeta.
     La regla de 1 px lo separa del papel, como los huecos de imagen. */
  .marco {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--paper);
  }

  .marco :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .marco :global(.hueco) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    padding: var(--space-3);
    text-align: center;
  }

  .marco :global(.hueco__h) {
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.25;
    text-wrap: balance;
  }

  .marco :global(.hueco__p) {
    max-width: 30rem;
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .marco :global(.hueco__barra) {
    width: min(26rem, 80%);
    margin-top: var(--space-1);
    accent-color: var(--ink);
    cursor: pointer;
  }

  .escena__idioma {
    margin-top: var(--space-1);
  }

  /* --- La clase -------------------------------------------------------------- */
  .clase {
    margin-top: var(--space-4);
  }

  .clase__h {
    margin-top: var(--space-1);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-anchor);
    line-height: var(--leading-anchor);
    letter-spacing: var(--tracking-section);
    text-wrap: balance;
  }

  .clase__borrador {
    margin-top: var(--space-2);
  }

  .clase__meta {
    margin-top: var(--space-1);
  }

  .clase__actos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--rule);
  }

  .clase__resumen {
    max-width: var(--measure);
    margin-top: var(--space-3);
  }

  .clase__resumen :global(p + p) {
    margin-top: var(--space-2);
  }

  /* Marcar como vista: una casilla, no un botón de acción. Se dibuja como lo
     que hace —poner o quitar un tic— y no compite con preguntar. */
  .marcar {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0;
    background: none;
    border: 0;
    color: var(--ink-soft);
    cursor: pointer;
  }

  .marcar:hover,
  .marcar.is-on {
    color: var(--ink);
  }

  .marcar__caja {
    position: relative;
    display: inline-block;
    width: 1rem;
    height: 1rem;
    border: 1px solid currentColor;
  }

  .marcar.is-on .marcar__caja {
    background: var(--ink);
  }

  /* El tic, dibujado con dos bordes girados. Sin icono, sin fuente extra. */
  .marcar.is-on .marcar__caja::after {
    content: '';
    position: absolute;
    left: 5px;
    top: 1px;
    width: 4px;
    height: 9px;
    border: solid var(--paper);
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(42deg);
  }

  /* --- Material -------------------------------------------------------------- */
  .material {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }

  .material__lista {
    display: grid;
    gap: var(--space-1);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  /* --- Anterior y siguiente ------------------------------------------------- */
  .pasos {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  .pasos__a {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-2);
    border: 1px solid var(--rule);
    transition: border-color 0.2s var(--ease-reveal);
  }

  .pasos__a:hover {
    border-color: var(--ink);
  }

  .pasos__a--next {
    text-align: right;
  }

  .pasos__t {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.25;
  }

  /* --- El índice ------------------------------------------------------------- */
  .indice__h {
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--ink);
  }

  .indice :global(.unidad) {
    margin-top: var(--space-3);
  }

  .indice :global(.unidad__h) {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .indice :global(.unidad__n) {
    flex: 0 0 auto;
  }

  .indice :global(.unidad__lista) {
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .indice :global(.fila) {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-1);
    padding: var(--space-1);
    font-size: var(--text-small);
    line-height: 1.4;
    border-bottom: 0;
    border-left: 2px solid transparent;
    transition: border-color 0.2s var(--ease-reveal);
  }

  .indice :global(.fila:hover) {
    border-left-color: var(--rule);
  }

  /* La clase en pantalla: una regla de tinta al margen. */
  .indice :global(.fila.is-aqui) {
    border-left-color: var(--ink);
  }

  /* El tic del índice: un cuadrado vacío mientras falte, de tinta al estar. */
  .indice :global(.fila__tic) {
    position: relative;
    top: 0.15em;
    width: 0.75rem;
    height: 0.75rem;
    border: 1px solid var(--ink-soft);
  }

  .indice :global(.fila.is-hecha .fila__tic) {
    background: var(--ink);
    border-color: var(--ink);
  }

  .indice :global(.fila.is-hecha .fila__t) {
    color: var(--ink-soft);
  }

  /* --- El hilo ------------------------------------------------------------- */
  .hilo {
    padding-top: var(--space-6);
    border-top: 1px solid var(--rule);
  }

  .hilo__cab {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
  }

  .hilo__nota {
    margin-top: var(--space-1);
    max-width: var(--measure);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .hilo__lista {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .hilo__lista :global(.msj) {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--rule);
  }

  .hilo__lista :global(.msj__txt) {
    margin-top: var(--space-1);
    white-space: pre-wrap;
    text-wrap: pretty;
  }

  .hilo__lista :global(.msj__resp) {
    margin-top: var(--space-2);
    padding-left: var(--space-2);
    border-left: 2px solid var(--ink);
  }

  .hilo__lista :global(.msj__pie) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding-top: var(--space-1);
    border-top: 1px solid var(--rule);
  }

  /* --- La duda --------------------------------------------------------------- */
  .duda__h {
    margin-top: var(--space-1);
  }

  .duda__lead {
    margin-top: var(--space-1);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .duda__ctx {
    margin-top: var(--space-3);
    padding: var(--space-1) var(--space-2);
    border-left: 2px solid var(--ink);
    font-family: var(--font-display);
    font-size: 1.25rem;
  }

  .duda__minuto {
    margin-top: var(--space-1);
  }

  .duda__campo {
    margin-top: var(--space-3);
  }

  .duda__error {
    margin-top: var(--space-1);
  }
</style>
