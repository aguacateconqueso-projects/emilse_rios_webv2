---
/**
 * El botón del aula — el de la carta de la membresía, tal cual.
 *
 * Al pasar el cursor, un relleno de tinta crece **desde la posición exacta del
 * cursor** y la flecha se desliza; el botón se imanta un poco hacia el puntero
 * y suelta notas musicales de colores. Es la referencia que eligió Emi y es el
 * único gesto de marca que el aula hereda entero de la carta.
 *
 * Vive en un componente y no copiado en cada pantalla porque el marcado no es
 * libre: el relleno es un `<span>` aparte —para poder animarlo sin tocar el
 * fondo del botón— y la etiqueta y la flecha van por encima de él en su propia
 * capa. Escrito a mano cada vez, un `<span>` olvidado deja un botón que no se
 * rellena y nadie sabe por qué.
 *
 * La animación la enciende el script del marco (`src/layouts/Aula.astro`)
 * buscando `.btn`, así que un botón nuevo no necesita nada más. Si aparece
 * después de cargar la página —el hilo de preguntas, por ejemplo—, quien lo
 * pinte lanza `aula:pintado` y queda armado igual.
 */
interface Props {
  /** Con `href` sale un enlace; sin él, un `<button>`. */
  href?: string;
  etiqueta: string;
  /**
   * `line` es el de siempre, contorno de tinta sobre la crema. `solid` nace
   * macizo y el relleno lo vacía a crema: se reserva para **la única acción
   * principal de cada pantalla**, y dos en la misma se pelean.
   */
  variante?: 'line' | 'solid';
  /** Pequeño, para dentro de una ficha. */
  pequeno?: boolean;
  /** Sale del sitio: añade el `rel` y marca el enlace con su flecha. */
  externo?: boolean;
  /** Para los `<button>`: el tipo del formulario. */
  tipo?: 'button' | 'submit';
}

const {
  href,
  etiqueta,
  variante = 'line',
  pequeno = false,
  externo = false,
  tipo = 'button',
  ...resto
} = Astro.props;

const clases = ['btn', variante === 'solid' && 'btn--solid', pequeno && 'btn--sm'];
---

{
  href ? (
    <a class:list={clases} href={href} rel={externo ? 'noopener' : undefined} {...resto}>
      <span class="btn__fill" aria-hidden="true" />
      <span class="btn__label">{etiqueta}</span>
      <span class="btn__ar" aria-hidden="true">
        {externo ? '↗' : '→'}
      </span>
    </a>
  ) : (
    <button class:list={clases} type={tipo} {...resto}>
      <span class="btn__fill" aria-hidden="true" />
      <span class="btn__label">{etiqueta}</span>
      <span class="btn__ar" aria-hidden="true">
        →
      </span>
    </button>
  )
}
