---
/**
 * El escritorio — la primera pantalla después de iniciar sesión.
 *
 * **«Mi escritorio», arriba y en grande** (23 sep 2026, pedido de Adrián: «al
 * comienzo, más protagonismo»). Sin saludo: el «Hola, Ana» de la maqueta se
 * quitó porque el nombre no se puede sacar del correo y uno inventado dice
 * cualquier cosa, y la frase de debajo tampoco sumaba.
 *
 * Después, en el orden en que importan:
 *   1. **Sigue por donde ibas** — la única acción grande, porque es la que
 *      hace el 90 % de las visitas: se entra a seguir, no a explorar.
 *   2. **Mis cursos**, con su avance.
 *   3. **La membresía**, si la tiene. Sin barra de avance: es un flujo que no
 *      termina —un ejercicio nuevo cada jueves—, y una barra mentiría.
 *   4. Formaciones, para quien quiere seguir aprendiendo.
 *
 * **Todo lo de los cursos llega por consulta**, no va escrito en el HTML: sale
 * de Supabase con la RLS decidiendo (`src/lib/aula-datos.ts`). Lo que pinta el
 * servidor es solo el esqueleto y las fotos de Formaciones, que son públicas.
 */
import { getImage } from 'astro:assets';
import type { Lang } from '../../i18n/ui';
import { routePath, useTranslations } from '../../i18n/ui';
import { useAula } from '../../i18n/aula';
import { ACADEMIA, catalogo } from '../../data/aula';
import Boton from '../Boton.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const a = useAula(lang);
const t = useTranslations(lang);

/**
 * Lo que el script necesita del catálogo: el nombre y la foto de cada curso
 * que tiene ficha en Formaciones, y cuáles tienen página propia en el aula.
 * Las fotos salen ya optimizadas, en el tamaño de la ficha.
 */
const deCatalogo = await Promise.all(
  catalogo
    .filter((p) => p.tipo === 'curso')
    .map(async (p) => ({
      slug: p.slug,
      nombre: p.copia[lang].nombre,
      alt: p.copia[lang].fotoAlt ?? '',
      foto: p.foto ? (await getImage({ src: p.foto, width: 720 })).src : null,
    })),
);

const paraJs = {
  lang,
  catalogo: deCatalogo,
  raiz: lang === 'es' ? '/aulavirtual/curso/' : '/en/classroom/course/',
  t: {
    clases: a('course.lessons'),
    continuar: a('desk.resumeCta'),
    empezar: a('desk.startCta'),
    hecho: a('course.done'),
    sinEmpezar: a('course.notStarted'),
    vacio: a('desk.mineEmpty'),
    error: a('desk.error'),
    borrador: a('desk.draft'),
    respuesta: a('desk.newAnswer'),
  },
};

const membresiaHref = `${ACADEMIA}/aula/`;
---

<script type="application/json" id="escritorio-datos" set:html={JSON.stringify(paraJs)} />

<header class="app-wrap desk-head">
  <h1 class="app-h1 desk-head__h">{a('app.desk')}</h1>
</header>

{/* --- Sigue por donde ibas --------------------------------------------- */}
<section class="app-wrap desk-sec" aria-labelledby="retomar-h" data-retomar hidden>
  <div class="retomar">
    <div class="retomar__txt">
      <p class="eyebrow" id="retomar-h">{a('desk.resume')}</p>
      <p class="retomar__curso mono" data-r-curso></p>
      <p class="retomar__clase" data-r-clase></p>
      <p class="retomar__meta soft tnum" data-r-meta></p>
    </div>
    <Boton class="boton--solid" href="#" data-r-cta>{a('desk.resumeCta')}</Boton>
  </div>
</section>

{/* --- Mis cursos -------------------------------------------------------- */}
<section class="app-wrap desk-sec" aria-labelledby="mios-h">
  <h2 class="eyebrow desk-sec__h" id="mios-h">{a('desk.mine')}</h2>
  <p class="soft desk-estado" data-cursos-estado role="status">{a('desk.loading')}</p>
  <ul class="fichas" role="list" data-cursos></ul>

  <template data-ficha>
    <li class="ficha">
      <a class="ficha__link" data-f-link>
        <span class="ficha__media" data-f-media>
          <img class="ficha__img" alt="" loading="lazy" data-f-img />
          <span class="mono ficha__hueco" data-f-hueco></span>
        </span>
        <span class="ficha__meta mono">
          <span class="tnum" data-f-pct>0 %</span>
          <span class="soft tnum" data-f-cifras></span>
        </span>
        <span class="meter ficha__meter"><span class="meter__fill" data-f-fill></span></span>
        <span class="ficha__nombre" data-f-nombre></span>
        <span class="ficha__resumen soft" data-f-resumen></span>
        <span class="estado ficha__estado" data-f-borrador hidden></span>
        <span class="estado estado--tinta ficha__estado" data-f-respuesta hidden></span>
      </a>
    </li>
  </template>
</section>

{/* --- La membresía ------------------------------------------------------ */}
<section class="app-wrap desk-sec" aria-labelledby="memb-h" data-membresia hidden>
  <div class="memb">
    <div class="memb__txt">
      <p class="eyebrow">{a('app.membership')}</p>
      <h2 class="app-h2 memb__h" id="memb-h">{a('desk.membershipTitle')}</h2>
      <p class="memb__lead">{a('desk.membershipLead')}</p>
      {/* El salto de dominio se avisa, no se descubre. */}
      <p class="memb__fuera soft">{a('desk.membershipAway')}</p>
    </div>
    <Boton href={membresiaHref} rel="noopener">{a('desk.membershipCta')}</Boton>
  </div>
</section>

{/* --- Formaciones -------------------------------------------------------- */}
<section class="app-wrap desk-sec desk-tienda" aria-labelledby="tienda-h">
  <div class="desk-tienda__txt">
    <h2 class="app-h2" id="tienda-h">{a('desk.storeTitle')}</h2>
    <p class="soft">{a('desk.storeLead')}</p>
  </div>
  <Boton href={routePath('products', lang)}>{t('nav.products')}</Boton>
</section>

<script>
  import { datos, clasesDe, reloj, type Curso, type Avance } from '../../lib/aula-datos';
  import { acceso } from '../../lib/aula-acceso';
  import { supabase } from '../../lib/supabase';

  type Ficha = { slug: string; nombre: string; alt: string; foto: string | null };
  const D = JSON.parse(document.getElementById('escritorio-datos')!.textContent!) as {
    lang: 'es' | 'en';
    catalogo: Ficha[];
    raiz: string;
    t: Record<string, string>;
  };
  const { lang, t } = D;
  const conPagina = D.catalogo.map((c) => c.slug);
  const $ = <T extends HTMLElement = HTMLElement>(s: string, en: ParentNode = document) =>
    en.querySelector<T>(s);

  /* Las fichas que Emi sube desde la pestaña Tienda del panel mandan sobre las
     del código: su foto es la que sale en Formaciones. Se busca por el curso
     que abre la ficha y, si no lo dice, por el nombre corto. */
  let tienda: { slug: string; course_id: string | null; nombre: string; alt: string; foto: string | null }[] = [];
  async function leerTienda() {
    if (datos.modo !== 'supabase') return;
    const { data, error } = await supabase
      .from('products')
      .select('slug, course_id, nombre_es, nombre_en, foto_url, foto_alt_es, foto_alt_en')
      .eq('tipo', 'curso');
    if (error || !data) return;
    tienda = data.map((p) => ({
      slug: p.slug,
      course_id: p.course_id,
      nombre: (lang === 'en' ? p.nombre_en || p.nombre_es : p.nombre_es || p.nombre_en) || '',
      alt: (lang === 'en' ? p.foto_alt_en || p.foto_alt_es : p.foto_alt_es) || '',
      foto: p.foto_url,
    }));
  }
  const fichaDe = (c: Curso): Ficha | undefined =>
    tienda.find((f) => f.course_id === c.id) ??
    tienda.find((f) => f.slug === c.slug) ??
    D.catalogo.find((f) => f.slug === c.slug);

  const nombreDe = (c: Curso) =>
    (lang === 'en' ? c.title_en || c.title_es : c.title_es || c.title_en) || fichaDe(c)?.nombre || c.slug;

  const resumenDe = (c: Curso) => (lang === 'en' ? c.summary_en || c.summary_es : c.summary_es) || '';

  const tituloClase = (l: { title_es: string; title_en: string }) =>
    (lang === 'en' ? l.title_en || l.title_es : l.title_es || l.title_en) || '—';

  const hrefCurso = (slug: string, clase?: string) =>
    (conPagina.includes(slug) ? `${D.raiz}${slug}/` : `${D.raiz}?c=${encodeURIComponent(slug)}`) +
    (clase ? `#${clase}` : '');

  /* --- Mis cursos ---------------------------------------------------------- */
  function pintarCursos(cursos: Curso[], avance: Record<string, Avance>, admin: boolean, nuevas: Set<string>) {
    const lista = $('[data-cursos]')!;
    const molde = $<HTMLTemplateElement>('[data-ficha]')!;
    lista.textContent = '';

    cursos.forEach((c) => {
      const clases = clasesDe(c);
      const hechas = clases.filter((l) => avance[l.id]?.hecho).length;
      const pct = clases.length ? Math.round((hechas / clases.length) * 100) : 0;
      const duracion = clases.reduce((s, l) => s + (l.duration_s ?? 0), 0);
      const ficha = fichaDe(c);

      const li = molde.content.firstElementChild!.cloneNode(true) as HTMLElement;
      $<HTMLAnchorElement>('[data-f-link]', li)!.href = hrefCurso(c.slug);
      const img = $<HTMLImageElement>('[data-f-img]', li)!;
      const hueco = $('[data-f-hueco]', li)!;
      if (ficha?.foto) {
        img.src = ficha.foto;
        img.alt = ficha.alt;
        hueco.remove();
      } else {
        img.remove();
        hueco.textContent = nombreDe(c);
      }
      $('[data-f-pct]', li)!.textContent = `${pct} %`;
      const cifras = [`${clases.length} ${t.clases}`];
      if (duracion > 0) cifras.push(reloj(duracion));
      $('[data-f-cifras]', li)!.textContent = cifras.join(' · ');
      $('[data-f-fill]', li)!.style.setProperty('--pct', `${pct}%`);
      $('[data-f-nombre]', li)!.textContent = nombreDe(c);
      const resumen = resumenDe(c);
      const r = $('[data-f-resumen]', li)!;
      if (resumen) r.textContent = resumen;
      else r.remove();
      if (admin && !c.published) {
        const b = $('[data-f-borrador]', li)!;
        b.textContent = t.borrador;
        b.hidden = false;
      }
      /* Emi respondió algo que todavía no leyó: se apaga al abrir el hilo. */
      if (nuevas.has(c.id)) {
        const n = $('[data-f-respuesta]', li)!;
        n.textContent = t.respuesta;
        n.hidden = false;
      }
      lista.appendChild(li);
    });
  }

  /* --- Por dónde iba -------------------------------------------------------
     La clase tocada más recientemente, de cualquier curso. Si ya está vista,
     la SIGUIENTE sin ver: volver a ponerle la que acaba de terminar no ayuda.
     Sin nada tocado, la primera clase del primer curso, y el botón dice
     «empezar» en vez de «continuar». */
  function pintarRetomar(cursos: Curso[], avance: Record<string, Avance>) {
    const caja = $('[data-retomar]')!;
    let mejor: { c: Curso; id: string; ts: number } | null = null;
    cursos.forEach((c) =>
      clasesDe(c).forEach((l) => {
        const p = avance[l.id];
        if (p?.ts && (!mejor || p.ts > mejor.ts)) mejor = { c, id: l.id, ts: p.ts };
      }),
    );

    let curso: Curso | undefined;
    let clase: ReturnType<typeof clasesDe>[number] | undefined;
    let empezar = false;

    if (mejor) {
      const m = mejor as { c: Curso; id: string };
      curso = m.c;
      const lista = clasesDe(curso);
      const i = lista.findIndex((l) => l.id === m.id);
      clase = lista[i];
      if (avance[m.id]?.hecho) clase = lista.slice(i + 1).find((l) => !avance[l.id]?.hecho) ?? clase;
    } else {
      curso = cursos.find((c) => clasesDe(c).length > 0);
      clase = curso ? clasesDe(curso)[0] : undefined;
      empezar = true;
    }
    if (!curso || !clase) return;

    $('[data-r-curso]', caja)!.textContent = nombreDe(curso);
    $('[data-r-clase]', caja)!.textContent = tituloClase(clase);

    const p = avance[clase.id];
    const total = clase.duration_s || p?.d || 0;
    let meta = total ? reloj(total) : t.sinEmpezar;
    if (p?.hecho) meta = t.hecho + (total ? ` · ${reloj(total)}` : '');
    else if (p && p.s > 5) meta = reloj(p.s) + (total ? ` / ${reloj(total)}` : '');
    $('[data-r-meta]', caja)!.textContent = meta;

    const cta = $<HTMLAnchorElement>('[data-r-cta]', caja)!;
    cta.href = hrefCurso(curso.slug, clase.id);
    cta.querySelector('.boton__label')!.textContent = empezar ? t.empezar : t.continuar;
    caja.hidden = false;
  }

  (async () => {
    const estado = $('[data-cursos-estado]')!;
    try {
      const quien = await acceso();
      if (datos.modo === 'supabase' && !quien.sesion) return;

      $('[data-membresia]')!.hidden = !(quien.membresia || quien.admin || datos.modo === 'maqueta');

      const [cursos, avance, nuevas] = await Promise.all([
        datos.misCursos(),
        datos.avance(),
        datos.respuestasNuevas(),
        leerTienda(),
      ]);
      pintarCursos(cursos, avance, quien.admin, nuevas);
      pintarRetomar(cursos, avance);
      estado.textContent = cursos.length ? '' : t.vacio;
      estado.hidden = cursos.length > 0;
      document.dispatchEvent(new CustomEvent('botones:nuevos'));
    } catch (e) {
      console.error('[escritorio]', e);
      estado.textContent = t.error;
    }
  })();
</script>

<style>
  /* --- El titular ---------------------------------------------------------
     La pantalla se llama como lo que es, en el tamaño de la portada de
     Formaciones. Nada encima: ni saludo ni frase. */
  .desk-head {
    padding-top: var(--space-6);
  }

  .desk-head__h {
    max-width: 14ch;
  }

  .desk-sec {
    margin-top: var(--space-8);
  }

  .desk-sec__h {
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--rule);
  }

  .desk-estado {
    margin-top: var(--space-3);
  }

  /* --- Sigue por donde ibas ------------------------------------------------
     Un recuadro de tinta, como la ficha de precio de las cartas: es lo único
     de la pantalla que hay que ver de un vistazo. */
  .retomar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding: var(--space-4);
    border: 1px solid var(--ink);
  }

  .retomar__txt {
    flex: 1 1 24rem;
    min-width: 0;
  }

  .retomar__curso {
    margin-top: var(--space-3);
  }

  .retomar__clase {
    margin-top: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-anchor);
    line-height: var(--leading-anchor);
    letter-spacing: var(--tracking-section);
    text-wrap: balance;
  }

  .retomar__meta {
    margin-top: var(--space-1);
    font-size: var(--text-small);
  }

  @media (max-width: 36rem) {
    .retomar {
      padding: var(--space-3);
    }
  }

  /* --- Mis cursos ----------------------------------------------------------
     Las fichas de Formaciones: foto enmarcada en blanco y negro que toma color
     al pasar, la línea de datos y el nombre. Más la barra de avance. */
  .fichas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 62rem) {
    .fichas {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 38rem) {
    .fichas {
      grid-template-columns: 1fr;
    }
  }

  :global(.ficha__link) {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-bottom: 0;
    color: inherit;
  }

  :global(.ficha__media) {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 3 / 2;
    overflow: clip;
    border: 1px solid var(--rule);
  }

  :global(.ficha__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition:
      filter 0.5s var(--ease-reveal),
      transform 0.5s var(--ease-reveal);
  }

  @media (hover: hover) {
    :global(.ficha__link:hover .ficha__img) {
      filter: grayscale(0);
      transform: scale(1.04);
    }
  }

  :global(.ficha__hueco) {
    padding: var(--space-3);
    color: var(--ink-soft);
    text-align: center;
  }

  :global(.ficha__meta) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  :global(.ficha__meter) {
    margin-top: var(--space-1);
  }

  :global(.ficha__nombre) {
    display: block;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-section);
    line-height: var(--leading-section);
    letter-spacing: var(--tracking-section);
  }

  :global(.ficha__resumen) {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-small);
    line-height: 1.5;
    text-wrap: pretty;
  }

  :global(.ficha__estado) {
    align-self: flex-start;
    margin-top: var(--space-2);
  }

  /* --- La membresía -------------------------------------------------------- */
  .memb {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }

  .memb__txt {
    flex: 1 1 28rem;
    min-width: 0;
  }

  .memb__h {
    margin-top: var(--space-2);
  }

  .memb__lead {
    margin-top: var(--space-1);
    max-width: var(--measure);
  }

  .memb__fuera {
    margin-top: var(--space-2);
    max-width: var(--measure);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  /* --- Formaciones -------------------------------------------------------- */
  /* La regla va en un pseudoelemento y no en el borde: la caja lleva el
     margen lateral de `.app-wrap`, y un borde saldría 24 px más ancho que la
     columna por cada lado. */
  .desk-tienda {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-top: var(--space-6);
  }

  .desk-tienda::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--space-3);
    right: var(--space-3);
    height: 1px;
    background: var(--rule);
  }

  .desk-tienda__txt {
    flex: 1 1 24rem;
  }

  .desk-tienda__txt p {
    margin-top: var(--space-1);
  }
</style>
