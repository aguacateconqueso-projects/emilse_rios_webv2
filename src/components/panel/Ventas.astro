---
/**
 * Pestaña Págs. de ventas — el texto de cada página de ventas.
 *
 * Pedido de Adrián el 23 sep 2026: «arma cartas para que redacte y publique
 * sus cartas de ventas (renombra a Págs. de Ventas)».
 *
 * **Lo que se edita es exactamente lo que la web ya sabe pintar**: el tipo
 * `Carta` de `src/data/cartas.ts`, con sus bloques (párrafo, destacado, frase
 * centrada, la frase grande, testimonio, listas, lo que trae). El editor pone
 * cada bloque en una fila con el español a la izquierda y el inglés a la
 * derecha: así los dos idiomas tienen siempre los mismos bloques en el mismo
 * orden, que es lo que pide el cambio de idioma de la carta.
 *
 * **Borrador y publicada, separadas** (migración 0010): lo que Emi escribe se
 * guarda solo, unos segundos después de dejar de escribir, en
 * `sales_page_drafts`, que la web no ve. «Publicar» lo copia a `sales_pages`,
 * y en un minuto está en la web. «Vista previa» abre la página tal como
 * quedará, con lo que haya en el editor aunque no esté guardado.
 *
 * **La primera vez**, el editor arranca con la página que la web enseña hoy
 * —la escrita en el código—, así que publicar sin tocar nada no cambia nada.
 *
 * El botón de un curso que no está «a la venta» dice «Avísame cuando abra»,
 * escriba lo que escriba la página: lo decide el estado de la ficha en la
 * Tienda (`src/lib/tienda.ts`). Así se puede dejar escrito el botón de pagar
 * y no se vende nada hasta abrir.
 */
import { cartas, AVISAME } from '../../data/cartas';

const paraJs = { cartas, avisame: AVISAME };
---

<script type="application/json" id="ventas-datos" set:html={JSON.stringify(paraJs)} />

<div class="app-wrap pest ventas" data-ventas>
  {/* --- La lista --------------------------------------------------------- */}
  <div data-v-lista-vista>
    <header class="pest-cab">
      <div>
        <p class="eyebrow">Págs. de ventas</p>
        <h1 class="app-h1 pest-cab__h">Lo que se lee antes de comprar.</h1>
      </div>
    </header>

    <p class="aviso ventas__aviso" data-v-falta hidden>
      <b>Falta un paso</b> — La base de datos todavía no tiene las páginas de ventas: hay que pegar
      <code>supabase/migrations/0010_tienda_paginas_mensajes.sql</code> en Supabase → SQL Editor, una vez.
    </p>
    <p class="aviso ventas__aviso" data-v-sin-tienda hidden>
      <b>Primero, la Tienda</b> — Cada página es la de una ficha de Formaciones, y las fichas todavía
      están en el código. Importa el catálogo en la <a href="#tienda">Tienda</a> y vuelve.
    </p>

    <ul class="filas" role="list" data-v-lista>
      <li class="filas__vacio soft">Cargando…</li>
    </ul>
  </div>

  {/* --- El editor ------------------------------------------------------------ */}
  <div class="editor" data-v-editor hidden>
    <a class="mono editor__volver" href="#ventas">← Todas las páginas</a>
    <header class="editor__cab">
      <p class="eyebrow" data-v-e-eyebrow>Página de ventas</p>
      <h1 class="app-h1 app-h1--sm" data-v-e-h></h1>
      <p class="mono soft" data-v-e-dir></p>
    </header>

    <p class="ficha-form__nota editor__origen" data-v-e-origen></p>
    <p class="ficha-form__nota" data-v-e-boton-nota hidden></p>

    <div class="editor__idiomas" aria-hidden="true">
      <span class="mono">Español</span>
      <span class="mono">English</span>
    </div>

    <div data-v-e-cuerpo></div>

    {/* La barra de abajo: siempre a mano. */}
    <div class="editor__barra">
      <p class="mono soft editor__estado" data-v-e-estado aria-live="polite"></p>
      <div class="editor__actos">
        <button class="btn-text" type="button" data-v-e-previa="es">Vista previa ES ↗</button>
        <button class="btn-text" type="button" data-v-e-previa="en">EN ↗</button>
        <button class="btn-text" type="button" data-v-e-descartar hidden>Descartar el borrador</button>
        <span data-v-e-guardar></span>
        <span data-v-e-publicar></span>
      </div>
    </div>
    <ul class="error editor__errores" data-v-e-errores hidden></ul>
  </div>
</div>

<script>
  import { supabase, isSupabaseConfigured } from '../../lib/supabase';
  import { alAbrir, armarBotones, avisar, boton, el, faltaTabla, fechaHora, hace, leerHash, ocupado } from '../../lib/panel';
  import type { Bloque, Carta } from '../../data/cartas';

  type Lang = 'es' | 'en';
  type Par<T> = { es: T; en: T };
  type Producto = {
    slug: string;
    tipo: 'curso' | 'membresia';
    estado: 'borrador' | 'proximamente' | 'venta' | 'cerrado';
    nombre_es: string;
    nombre_en: string;
    precio_es: string | null;
    precio_en: string | null;
  };

  const D = JSON.parse(document.getElementById('ventas-datos')!.textContent!) as {
    cartas: Record<string, Par<Carta>>;
    avisame: Par<Carta['boton']>;
  };
  const raiz = document.querySelector<HTMLElement>('[data-ventas]')!;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => raiz.querySelector<T>(s)!;
  const LANGS: Lang[] = ['es', 'en'];
  const NOMBRE_LANG: Record<Lang, string> = { es: 'español', en: 'inglés' };

  /* ==========================================================================
     El modelo del editor
     ==========================================================================
     Una `Carta` por idioma se parte en tres cosas que se editan en pares:
     los campos sueltos (con nombre de ruta: «boton.texto», «pd.rotulo»…), los
     bloques de la carta, los testimonios aparte y las preguntas. Al guardar
     se vuelve a armar la `Carta` de cada idioma. */

  type TipoBloque = 'parrafo' | 'fuerte' | 'grito' | 'acento' | 'testimonio' | 'lista-si' | 'lista-no' | 'puntos';
  type TxtBloque = { text: string; autor: string; titulo: string; items: string };
  type Bloq = { tipo: TipoBloque } & Par<TxtBloque>;
  type Testi = Par<{ text: string; autor: string }>;
  type Faq = Par<{ q: string; a: string; correo: string; a2: string }>;
  type Modelo = {
    campos: Par<Record<string, string>>;
    bloques: Bloq[];
    testimonios: Testi[];
    faq: Faq[];
    puertas: boolean;
  };

  const TIPOS: { v: TipoBloque; t: string }[] = [
    { v: 'parrafo', t: 'Párrafo' },
    { v: 'fuerte', t: 'Destacado' },
    { v: 'grito', t: 'Frase centrada' },
    { v: 'acento', t: 'La frase grande' },
    { v: 'testimonio', t: 'Testimonio' },
    { v: 'lista-si', t: 'Lista «para ti»' },
    { v: 'lista-no', t: 'Lista «no es para ti»' },
    { v: 'puntos', t: 'Lo que trae' },
  ];

  const vacioBloque = (): TxtBloque => ({ text: '', autor: '', titulo: '', items: '' });
  const lineas = (t: string) =>
    t
      .split('\n')
      .map((x) => x.trim())
      .filter(Boolean);

  function deBloque(b: Bloque | undefined): { tipo: TipoBloque; txt: TxtBloque } {
    const txt = vacioBloque();
    if (b === undefined) return { tipo: 'parrafo', txt };
    if (typeof b === 'string') return { tipo: 'parrafo', txt: { ...txt, text: b } };
    if (b.k === 'testimonio') return { tipo: 'testimonio', txt: { ...txt, text: b.text, autor: b.autor } };
    if (b.k === 'lista')
      return { tipo: b.tono === 'no' ? 'lista-no' : 'lista-si', txt: { ...txt, titulo: b.titulo, items: b.items.join('\n') } };
    if (b.k === 'puntos') return { tipo: 'puntos', txt: { ...txt, titulo: b.titulo ?? '', items: b.items.join('\n') } };
    return { tipo: b.k, txt: { ...txt, text: b.text } };
  }

  function aBloque(tipo: TipoBloque, t: TxtBloque): Bloque {
    const text = t.text.trim();
    switch (tipo) {
      case 'parrafo':
        return text;
      case 'testimonio':
        return { k: 'testimonio', text, autor: t.autor.trim() };
      case 'lista-si':
      case 'lista-no':
        return { k: 'lista', tono: tipo === 'lista-no' ? 'no' : 'si', titulo: t.titulo.trim(), items: lineas(t.items) };
      case 'puntos':
        return t.titulo.trim()
          ? { k: 'puntos', titulo: t.titulo.trim(), items: lineas(t.items) }
          : { k: 'puntos', items: lineas(t.items) };
      default:
        return { k: tipo, text };
    }
  }

  /** Los campos sueltos, con su ruta dentro de la `Carta`. */
  const RUTAS = [
    'metaTitle', 'metaDesc', 'title', 'subtitle', 'ledeA', 'ledeB', 'photoAlt',
    'includesH', 'titleEcho', 'priceLabel', 'price', 'pricePer', 'priceNote', 'priceNoteRest', 'priceFeatures', 'priceFoot',
    'boton.texto', 'boton.href', 'boton.fuera',
    'final', 'testimonios.titulo', 'pd.rotulo', 'pd.text',
    'faqH', 'news.pre', 'news.link',
    'puertas.closeLeadToday', 'puertas.closeLeadDay', 'puertas.payClosed',
    'puertas.closedNote', 'puertas.closedNoteNoDate', 'puertas.closedLink',
  ];
  const OPCIONALES = ['pricePer', 'priceNote', 'priceNoteRest', 'priceFoot', 'final'];

  function leerRuta(c: Carta, ruta: string): string {
    const v = ruta.split('.').reduce<any>((o, k) => (o == null ? undefined : o[k]), c);
    if (ruta === 'priceFeatures') return (v ?? []).join('\n');
    if (ruta === 'boton.fuera') return v ? '1' : '';
    return v ?? '';
  }

  function desCarta(c: Par<Carta>, tipo: Producto['tipo']): Modelo {
    const n = Math.max(c.es.carta?.length ?? 0, c.en.carta?.length ?? 0);
    const bloques: Bloq[] = [];
    for (let i = 0; i < n; i++) {
      const es = deBloque(c.es.carta?.[i]);
      const en = deBloque(c.en.carta?.[i]);
      bloques.push({ tipo: es.tipo, es: es.txt, en: en.txt });
    }
    const nt = Math.max(c.es.testimonios?.items.length ?? 0, c.en.testimonios?.items.length ?? 0);
    const nf = Math.max(c.es.faq?.length ?? 0, c.en.faq?.length ?? 0);
    const testi = (l: Lang, i: number) => ({
      text: c[l].testimonios?.items[i]?.text ?? '',
      autor: c[l].testimonios?.items[i]?.autor ?? '',
    });
    const faq = (l: Lang, i: number) => {
      const f = c[l].faq?.[i];
      return { q: f?.q ?? '', a: f?.a ?? '', correo: f?.correo ?? '', a2: f?.a2 ?? '' };
    };
    return {
      campos: {
        es: Object.fromEntries(RUTAS.map((r) => [r, leerRuta(c.es, r)])),
        en: Object.fromEntries(RUTAS.map((r) => [r, leerRuta(c.en, r)])),
      },
      bloques,
      testimonios: Array.from({ length: nt }, (_, i) => ({ es: testi('es', i), en: testi('en', i) })),
      faq: Array.from({ length: nf }, (_, i) => ({ es: faq('es', i), en: faq('en', i) })),
      puertas: Boolean(c.es.puertas || c.en.puertas) || tipo === 'membresia',
    };
  }

  function aCarta(m: Modelo): Par<Carta> {
    const hay = (r: string) => Boolean(m.campos.es[r]?.trim() || m.campos.en[r]?.trim());
    const una = (l: Lang): Carta => {
      const v = (r: string) => (m.campos[l][r] ?? '').trim();
      const c: Carta = {
        metaTitle: v('metaTitle'),
        metaDesc: v('metaDesc'),
        title: v('title'),
        subtitle: v('subtitle'),
        ledeA: v('ledeA'),
        ledeB: v('ledeB'),
        photoAlt: v('photoAlt'),
        carta: m.bloques.map((b) => aBloque(b.tipo, b[l])),
        includesH: v('includesH'),
        titleEcho: v('titleEcho'),
        priceLabel: v('priceLabel'),
        price: v('price'),
        priceFeatures: lineas(m.campos[l].priceFeatures ?? ''),
        boton: { texto: v('boton.texto'), href: v('boton.href'), ...(m.campos[l]['boton.fuera'] ? { fuera: true } : {}) },
        faqH: v('faqH'),
        faq: m.faq.map((f) => {
          const x = f[l];
          const o: Carta['faq'][number] = { q: x.q.trim(), a: x.a.trim() };
          if (x.correo.trim()) {
            o.correo = x.correo.trim();
            if (x.a2.trim()) o.a2 = x.a2.trim();
          }
          return o;
        }),
      };
      for (const r of OPCIONALES) if (hay(r)) (c as any)[r] = v(r);
      if (m.testimonios.length)
        c.testimonios = {
          titulo: v('testimonios.titulo'),
          items: m.testimonios.map((t) => ({ text: t[l].text.trim(), autor: t[l].autor.trim() })),
        };
      if (hay('pd.rotulo') || hay('pd.text')) c.pd = { rotulo: v('pd.rotulo'), text: v('pd.text') };
      if (hay('news.pre') || hay('news.link')) c.news = { pre: v('news.pre'), link: v('news.link') };
      if (m.puertas)
        c.puertas = {
          closeLeadToday: v('puertas.closeLeadToday'),
          closeLeadDay: v('puertas.closeLeadDay'),
          payClosed: v('puertas.payClosed'),
          closedNote: v('puertas.closedNote'),
          closedNoteNoDate: v('puertas.closedNoteNoDate'),
          closedLink: v('puertas.closedLink'),
        };
      return c;
    };
    return { es: una('es'), en: una('en') };
  }

  /** Una página nueva: lo mínimo para que se pinte, con el nombre y el precio de la ficha. */
  function plantilla(p: Producto): Par<Carta> {
    const puertas = p.tipo === 'membresia' ? D.cartas['estudiemos-juntos'] : undefined;
    const una = (l: Lang): Carta => ({
      metaTitle: `${(l === 'en' ? p.nombre_en : p.nombre_es) || p.nombre_es} — ${l === 'en' ? 'Emilse Rios' : 'Formación de Emilse Rios'}`,
      metaDesc: '',
      title: (l === 'en' ? p.nombre_en : p.nombre_es) || p.nombre_es,
      subtitle: '',
      ledeA: '',
      ledeB: '',
      photoAlt: '',
      carta: [''],
      includesH: l === 'en' ? 'What’s included' : 'Qué incluye',
      titleEcho: (l === 'en' ? p.nombre_es : p.nombre_en) || '',
      priceLabel: l === 'en' ? 'Price' : 'Precio',
      price: (l === 'en' ? p.precio_en : p.precio_es) ?? '',
      priceFeatures: [],
      boton: D.avisame[l],
      faqH: l === 'en' ? 'Frequently asked questions' : 'Preguntas frecuentes',
      faq: [],
      ...(puertas ? { puertas: puertas[l].puertas } : {}),
    });
    return { es: una('es'), en: una('en') };
  }

  /* ==========================================================================
     La lista
     ========================================================================== */

  let productos: Producto[] = [];
  let publicadas = new Map<string, string>();
  let borradores = new Map<string, string>();
  let arrancada = false;

  const ESTADO_FICHA: Record<Producto['estado'], string> = {
    borrador: 'Ficha en borrador',
    proximamente: 'Próximamente',
    venta: 'A la venta',
    cerrado: 'Cerrado',
  };

  function estadoPagina(slug: string): { t: string; cls: string } {
    const pub = publicadas.get(slug);
    const bor = borradores.get(slug);
    if (bor && (!pub || Date.parse(bor) > Date.parse(pub))) return { t: 'Cambios sin publicar', cls: 'estado estado--tinta' };
    if (pub) return { t: 'Publicada', cls: 'estado estado--vivo' };
    if (D.cartas[slug]) return { t: 'La del código', cls: 'estado' };
    return { t: 'Sin página', cls: 'estado' };
  }

  async function cargarLista(): Promise<boolean> {
    const [p, pub, bor] = await Promise.all([
      supabase.from('products').select('slug, tipo, estado, nombre_es, nombre_en, precio_es, precio_en').order('position').order('created_at'),
      supabase.from('sales_pages').select('slug, published_at'),
      supabase.from('sales_page_drafts').select('slug, updated_at'),
    ]);
    const ul = $('[data-v-lista]');
    ul.textContent = '';
    const error = p.error ?? pub.error ?? bor.error;
    if (error) {
      if (faltaTabla(error.message)) $('[data-v-falta]').hidden = false;
      else ul.append(el('li', { class: 'filas__vacio', text: `No se pudo cargar: ${error.message}` }));
      return false;
    }
    $('[data-v-falta]').hidden = true;
    productos = p.data as Producto[];
    publicadas = new Map((pub.data ?? []).map((x) => [x.slug, x.published_at]));
    borradores = new Map((bor.data ?? []).map((x) => [x.slug, x.updated_at]));
    $('[data-v-sin-tienda]').hidden = productos.length > 0;
    if (!productos.length) return true;

    productos.forEach((prod) => {
      const e = estadoPagina(prod.slug);
      const tienePagina = e.t !== 'Sin página';
      const pub = publicadas.get(prod.slug);
      const detalle = [
        ESTADO_FICHA[prod.estado],
        `/productos/${prod.slug}/`,
        pub ? `publicada ${cuando(pub)}` : null,
      ].filter(Boolean);
      ul.append(
        el(
          'li',
          { class: 'fila' },
          el(
            'div',
            { class: 'fila__txt' },
            el('a', { class: 'fila__t', href: `#ventas/${prod.slug}`, text: prod.nombre_es || prod.slug }),
            el('p', { class: 'mono soft', text: detalle.join(' · ') }),
          ),
          el('span', { class: e.cls, text: e.t }),
          el(
            'div',
            { class: 'fila__actos' },
            tienePagina &&
              prod.estado !== 'borrador' &&
              el('a', { class: 'mono', href: `/productos/${prod.slug}/`, target: '_blank', rel: 'noopener', text: 'Ver ↗' }),
            el('a', { class: 'mono ventas__escribir', href: `#ventas/${prod.slug}`, text: tienePagina ? 'Escribir →' : 'Empezarla →' }),
          ),
        ),
      );
    });
    return true;
  }

  /* ==========================================================================
     El editor
     ========================================================================== */

  let prod: Producto | null = null;
  let modelo: Modelo | null = null;
  let reloj: number | undefined;
  let guardando: Promise<void> | null = null;
  let sucio = false;
  const cuerpo = $('[data-v-e-cuerpo]');
  const estadoEl = $('[data-v-e-estado]');

  function crecer(t: HTMLTextAreaElement) {
    t.style.height = 'auto';
    t.style.height = `${t.scrollHeight + 2}px`;
  }

  /** Un campo de texto que escribe en el modelo al teclear. */
  function entrada(
    valor: string,
    alCambiar: (v: string) => void,
    opts: { largo?: boolean; etiqueta: string; ph?: string },
  ): HTMLInputElement | HTMLTextAreaElement {
    const n = opts.largo
      ? el('textarea', { rows: 2, 'aria-label': opts.etiqueta, placeholder: opts.ph })
      : el('input', { type: 'text', 'aria-label': opts.etiqueta, placeholder: opts.ph });
    n.value = valor;
    n.addEventListener('input', () => {
      alCambiar(n.value);
      if (n instanceof HTMLTextAreaElement) crecer(n);
      tocado();
    });
    return n;
  }

  /** Una fila ES | EN de un campo suelto. */
  function par(ruta: string, t: string, tipo: 'linea' | 'texto' | 'lineas' | 'si', ayuda?: string, ph?: Par<string>) {
    const m = modelo!;
    const fila = el('div', { class: 'par' }, el('p', { class: 'par__t', text: t }));
    for (const l of LANGS) {
      const etiqueta = `${t} (${NOMBRE_LANG[l]})`;
      if (tipo === 'si') {
        const c = el('input', { type: 'checkbox', 'aria-label': etiqueta });
        c.checked = Boolean(m.campos[l][ruta]);
        c.addEventListener('change', () => {
          m.campos[l][ruta] = c.checked ? '1' : '';
          tocado();
        });
        fila.append(el('label', { class: 'casilla par__c' }, c, el('span', { text: l === 'es' ? 'Sí' : 'Yes' })));
      } else {
        fila.append(
          el(
            'div',
            { class: 'campo par__c' },
            entrada(m.campos[l][ruta] ?? '', (v) => (m.campos[l][ruta] = v), {
              largo: tipo !== 'linea',
              etiqueta,
              ph: ph?.[l],
            }),
          ),
        );
      }
    }
    if (ayuda) fila.append(el('p', { class: 'campo__ayuda par__ayuda', text: ayuda }));
    return fila;
  }

  function seccion(h: string, nota: string, ...hijos: Node[]) {
    return el(
      'section',
      { class: 'v-sec' },
      el('h2', { class: 'app-h2 v-sec__h', text: h }),
      el('p', { class: 'v-sec__nota soft', text: nota }),
      ...hijos,
    );
  }

  /** «hace 3 min», «ayer», «el 12 sep 2026». */
  const cuando = (iso: string) => {
    const h = hace(iso);
    return h === 'ahora' ? 'hace un momento' : /^(hace|ayer)/.test(h) ? h : `el ${h}`;
  };

  /** Las flechas, duplicar y borrar de un elemento de una lista. */
  function mandos<T>(lista: T[], i: number, que: string, copiar: (x: T) => T, repintar: () => void) {
    const b = (texto: string, etiqueta: string, fn: () => void, apagado = false) => {
      const x = el('button', { class: 'btn-text', type: 'button', 'aria-label': etiqueta, text: texto });
      x.disabled = apagado;
      x.addEventListener('click', () => {
        fn();
        tocado();
        repintar();
      });
      return x;
    };
    return el(
      'div',
      { class: 'item__actos' },
      b('↑', `Subir ${que}`, () => ([lista[i - 1], lista[i]] = [lista[i], lista[i - 1]]), i === 0),
      b('↓', `Bajar ${que}`, () => ([lista[i + 1], lista[i]] = [lista[i], lista[i + 1]]), i === lista.length - 1),
      b('Duplicar', `Duplicar ${que}`, () => lista.splice(i + 1, 0, copiar(lista[i]))),
      b('Borrar', `Borrar ${que}`, () => lista.splice(i, 1)),
    );
  }

  /* --- Los bloques de la carta --------------------------------------------- */

  const listaBloques = el('ol', { class: 'items', role: 'list' });

  function camposBloque(b: Bloq, l: Lang, i: number) {
    const t = b[l];
    const et = (x: string) => `Bloque ${i + 1}, ${x} (${NOMBRE_LANG[l]})`;
    const caja = el('div', { class: 'campo par__c item__campos' });
    const texto = (largo: boolean) =>
      entrada(t.text, (v) => (t.text = v), { largo, etiqueta: et('texto') });
    switch (b.tipo) {
      case 'parrafo':
      case 'fuerte':
        caja.append(texto(true));
        break;
      case 'grito':
      case 'acento':
        caja.append(texto(true));
        break;
      case 'testimonio':
        caja.append(
          texto(true),
          entrada(t.autor, (v) => (t.autor = v), { etiqueta: et('nombre'), ph: l === 'es' ? 'Su nombre' : 'Her name' }),
        );
        break;
      default:
        caja.append(
          entrada(t.titulo, (v) => (t.titulo = v), {
            etiqueta: et('título'),
            ph: b.tipo === 'puntos' ? (l === 'es' ? 'Título (opcional)' : 'Title (optional)') : l === 'es' ? 'Título de la lista' : 'List title',
          }),
          entrada(t.items, (v) => (t.items = v), {
            largo: true,
            etiqueta: et('puntos'),
            ph: l === 'es' ? 'Un punto por renglón' : 'One item per line',
          }),
        );
    }
    return caja;
  }

  function pintarBloques() {
    const m = modelo!;
    listaBloques.textContent = '';
    m.bloques.forEach((b, i) => {
      const tipo = el('select', { 'aria-label': `Bloque ${i + 1}: qué es` });
      TIPOS.forEach((x) => tipo.append(el('option', { value: x.v, text: x.t })));
      tipo.value = b.tipo;
      tipo.addEventListener('change', () => {
        b.tipo = tipo.value as TipoBloque;
        tocado();
        pintarBloques();
      });
      const insertar = el('button', { class: 'btn-text item__mas', type: 'button', text: '+ Bloque aquí' });
      insertar.addEventListener('click', () => {
        m.bloques.splice(i + 1, 0, { tipo: 'parrafo', es: vacioBloque(), en: vacioBloque() });
        tocado();
        pintarBloques();
        listaBloques.children[i + 1]?.querySelector('textarea')?.focus();
      });
      listaBloques.append(
        el(
          'li',
          { class: `item item--${b.tipo}` },
          el(
            'div',
            { class: 'item__cab' },
            el('span', { class: 'mono soft tnum', text: String(i + 1).padStart(2, '0') }),
            el('div', { class: 'campo item__tipo' }, tipo),
            mandos(m.bloques, i, `el bloque ${i + 1}`, (x) => structuredClone(x), pintarBloques),
          ),
          el('div', { class: 'par par--sin-t' }, camposBloque(b, 'es', i), camposBloque(b, 'en', i)),
          insertar,
        ),
      );
    });
    if (!m.bloques.length) {
      const primero = el('button', { class: 'btn-text', type: 'button', text: '+ El primer bloque' });
      primero.addEventListener('click', () => {
        m.bloques.push({ tipo: 'parrafo', es: vacioBloque(), en: vacioBloque() });
        tocado();
        pintarBloques();
      });
      listaBloques.append(el('li', { class: 'filas__vacio' }, primero));
    }
    listaBloques.querySelectorAll('textarea').forEach((t) => crecer(t as HTMLTextAreaElement));
  }

