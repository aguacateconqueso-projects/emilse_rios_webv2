  /* --- Guardar solo --------------------------------------------------------- */

  function tocado() {
    sucio = true;
    estadoEl.textContent = 'Sin guardar…';
    window.clearTimeout(reloj);
    reloj = window.setTimeout(() => void guardar(), 2500);
  }

  async function guardar(): Promise<boolean> {
    window.clearTimeout(reloj);
    if (guardando) await guardando;
    if (!sucio || !prod || !modelo) return true;
    sucio = false;
    const slug = prod.slug;
    let ok = true;
    guardando = (async () => {
      estadoEl.textContent = 'Guardando…';
      const { data, error } = await supabase
        .from('sales_page_drafts')
        .upsert({ slug, carta: aCarta(modelo!) }, { onConflict: 'slug' })
        .select('updated_at')
        .single();
      if (error) {
        ok = false;
        sucio = true;
        estadoEl.textContent = `No se pudo guardar: ${error.message}`;
        return;
      }
      borradores.set(slug, data.updated_at);
      pintarEstado();
    })();
    await guardando;
    guardando = null;
    return ok;
  }

  function pintarEstado() {
    if (!prod) return;
    const pub = publicadas.get(prod.slug);
    const bor = borradores.get(prod.slug);
    const pendiente = bor && (!pub || Date.parse(bor) > Date.parse(pub));
    const partes: string[] = [];
    if (bor) partes.push(`Borrador guardado ${cuando(bor)}`);
    if (pub) partes.push(pendiente ? `publicada ${cuando(pub)}, con cambios sin publicar` : `publicada ${cuando(pub)}, al día`);
    else partes.push('todavía sin publicar');
    const txt = partes.join(' · ');
    estadoEl.textContent = txt.charAt(0).toUpperCase() + txt.slice(1);
    $('[data-v-e-descartar]').hidden = !pendiente;
  }

  window.addEventListener('beforeunload', (e) => {
    if (sucio || guardando) e.preventDefault();
  });

  /* --- Abrir una página ----------------------------------------------------- */

  async function abrirEditor(slug: string) {
    const p = productos.find((x) => x.slug === slug);
    if (!p) {
      avisar('Esa página no existe');
      location.hash = '#ventas';
      return;
    }
    $('[data-v-lista-vista]').hidden = true;
    const ed = $('[data-v-editor]');
    ed.hidden = false;
    prod = p;
    modelo = null;
    sucio = false;
    cuerpo.textContent = '';
    cuerpo.append(el('p', { class: 'soft', text: 'Cargando…' }));
    $('[data-v-e-h]').textContent = p.nombre_es || p.slug;
    $('[data-v-e-eyebrow]').textContent = `Página de ventas · ${ESTADO_FICHA[p.estado]}`;
    $('[data-v-e-dir]').textContent = `/productos/${p.slug}/`;
    $('[data-v-e-errores]').hidden = true;
    window.scrollTo({ top: 0 });

    const [bor, pub] = await Promise.all([
      supabase.from('sales_page_drafts').select('carta, updated_at').eq('slug', slug).maybeSingle(),
      supabase.from('sales_pages').select('carta, published_at').eq('slug', slug).maybeSingle(),
    ]);
    if (prod !== p) return;
    if (bor.error || pub.error) {
      cuerpo.textContent = '';
      cuerpo.append(el('p', { class: 'error', text: `No se pudo abrir: ${(bor.error ?? pub.error)!.message}` }));
      return;
    }

    let fuente: Par<Carta>;
    let origen: string;
    const codigo = D.cartas[slug];
    if (bor.data) {
      fuente = bor.data.carta;
      origen = `Estás en el borrador (guardado el ${fechaHora(bor.data.updated_at)}). ${
        pub.data
          ? `La web enseña la versión publicada el ${fechaHora(pub.data.published_at)} hasta que publiques.`
          : codigo
            ? 'La web enseña la versión escrita en el código hasta que publiques.'
            : 'La página no existe en la web hasta que publiques.'
      }`;
    } else if (pub.data) {
      fuente = pub.data.carta;
      origen = `Es la página que está en la web, publicada el ${fechaHora(pub.data.published_at)}. Lo que cambies se guarda como borrador; la web no cambia hasta que publiques.`;
    } else if (codigo) {
      fuente = structuredClone(codigo);
      origen = 'Es la página que la web enseña hoy, la escrita en el código. Lo que cambies se guarda como borrador; la web no cambia hasta que publiques. Publicarla sin tocar nada no cambia nada.';
    } else {
      fuente = plantilla(p);
      origen = 'Página nueva: empieza con el título y el precio de la ficha. Lo que escribas se guarda como borrador; la página no existe en la web hasta que publiques.';
    }
    if (bor.data) borradores.set(slug, bor.data.updated_at);
    else borradores.delete(slug);
    if (pub.data) publicadas.set(slug, pub.data.published_at);
    else publicadas.delete(slug);

    modelo = desCarta(fuente, p.tipo);
    $('[data-v-e-origen]').textContent = origen;
    const nota = $('[data-v-e-boton-nota]');
    nota.hidden = !(p.tipo === 'curso' && p.estado !== 'venta');
    nota.textContent =
      p.estado === 'borrador'
        ? 'La ficha está en borrador en la Tienda: la página no se ve en la web aunque la publiques, hasta que la ficha salga de borrador. Y mientras no esté «a la venta», su botón dice «Avísame cuando abra».'
        : 'La ficha no está «a la venta» en la Tienda: el botón de la página dice «Avísame cuando abra» y lleva al newsletter. Cuando la pongas a la venta, sale el botón que escribas acá.';
    pintarEditor();
    pintarEstado();
  }

  function cerrarEditor() {
    prod = null;
    modelo = null;
    $('[data-v-editor]').hidden = true;
    $('[data-v-lista-vista]').hidden = false;
  }

  /* --- Publicar ---------------------------------------------------------------- */

  function revisar(c: Par<Carta>): string[] {
    const faltas: string[] = [];
    for (const l of LANGS) {
      const x = c[l];
      const en = ` (${NOMBRE_LANG[l]})`;
      if (!x.title) faltas.push(`Falta el título${en}.`);
      if (!x.boton.texto || !x.boton.href) faltas.push(`Al botón le falta el texto o la dirección${en}.`);
      if (!x.metaTitle) faltas.push(`Falta el título para Google${en}.`);
      x.carta.forEach((b, i) => {
        const vacio = typeof b === 'string' ? !b : 'text' in b ? !b.text : !b.items.length;
        if (vacio) faltas.push(`El bloque ${i + 1} está vacío${en}.`);
        if (typeof b !== 'string' && b.k === 'testimonio' && !b.autor) faltas.push(`Al testimonio del bloque ${i + 1} le falta el nombre${en}.`);
      });
      x.faq.forEach((f, i) => {
        if (!f.q || !f.a) faltas.push(`A la pregunta ${i + 1} le falta la pregunta o la respuesta${en}.`);
      });
    }
    if (!c.es.carta.length) faltas.unshift('La carta no tiene ningún bloque.');
    return faltas;
  }

  const guardarB = boton('Guardar', { chico: true, flecha: false });
  const publicarB = boton('Publicar', { solido: true, chico: true });
  $('[data-v-e-guardar]').replaceWith(guardarB);
  $('[data-v-e-publicar]').replaceWith(publicarB);
  armarBotones();

  guardarB.addEventListener('click', () =>
    ocupado(guardarB, 'Guardando…', async () => {
      sucio = true;
      if (await guardar()) avisar('Borrador guardado');
    }),
  );

  publicarB.addEventListener('click', async () => {
    if (!prod || !modelo) return;
    const p = prod;
    const carta = aCarta(modelo);
    const errores = $('[data-v-e-errores]');
    const faltas = revisar(carta);
    errores.textContent = '';
    if (faltas.length) {
      faltas.slice(0, 8).forEach((f) => errores.append(el('li', { text: f })));
      if (faltas.length > 8) errores.append(el('li', { text: `Y ${faltas.length - 8} más.` }));
      errores.hidden = false;
      errores.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      return;
    }
    errores.hidden = true;
    const aviso =
      p.estado === 'borrador'
        ? `¿Publicar la página de «${p.nombre_es}»?\n\nLa ficha está en borrador: la página queda lista, pero no se ve hasta que la ficha salga de borrador en la Tienda.`
        : `¿Publicar la página de «${p.nombre_es}»?\n\nEn un minuto la ve todo el mundo en /productos/${p.slug}/.`;
    if (!window.confirm(aviso)) return;
    await ocupado(publicarB, 'Publicando…', async () => {
      sucio = true;
      if (!(await guardar())) return;
      const { data, error } = await supabase
        .from('sales_pages')
        .upsert({ slug: p.slug, carta }, { onConflict: 'slug' })
        .select('published_at')
        .single();
      if (error) {
        avisar(`No se pudo publicar: ${error.message}`);
        return;
      }
      publicadas.set(p.slug, data.published_at);
      pintarEstado();
      avisar(p.estado === 'borrador' ? 'Publicada (la ficha sigue en borrador)' : 'Publicada: en un minuto está en la web');
    });
  });

  $('[data-v-e-descartar]').addEventListener('click', async () => {
    if (!prod) return;
    if (!window.confirm('¿Descartar el borrador?\n\nSe pierden los cambios sin publicar y el editor vuelve a la versión que está en la web.')) return;
    window.clearTimeout(reloj);
    sucio = false;
    const { error } = await supabase.from('sales_page_drafts').delete().eq('slug', prod.slug);
    if (error) return avisar(`No se pudo descartar: ${error.message}`);
    avisar('Borrador descartado');
    await abrirEditor(prod.slug);
  });

  /* --- La vista previa --------------------------------------------------------
     Un formulario que se envía a una pestaña nueva: el texto entero no cabe en
     una dirección, y el token viaja en el cuerpo, no en la dirección. */
  raiz.querySelectorAll<HTMLButtonElement>('[data-v-e-previa]').forEach((b) =>
    b.addEventListener('click', async () => {
      if (!prod || !modelo) return;
      const {
        data: { session },
      } = await supabase.auth.getSession();
      if (!session) return avisar('La sesión caducó: vuelve a entrar');
      const f = el('form', { method: 'post', action: '/panel/vista-previa/', target: '_blank', hidden: true });
      const campo = (name: string, value: string) => {
        const i = el('input', { type: 'hidden', name });
        i.value = value;
        f.append(i);
      };
      campo('token', session.access_token);
      campo('slug', prod.slug);
      campo('lang', b.dataset.vEPrevia!);
      campo('carta', JSON.stringify(aCarta(modelo)));
      document.body.append(f);
      f.submit();
      f.remove();
    }),
  );

  /* ==========================================================================
     Qué se enseña: la lista o una página (`#ventas/<slug>`)
     ========================================================================== */

  async function segunHash() {
    const [p, slug] = leerHash();
    if (p !== 'ventas') {
      if (sucio) void guardar();
      return;
    }
    if (slug && slug !== prod?.slug) {
      if (sucio) await guardar();
      if (!productos.length) await cargarLista();
      await abrirEditor(slug);
    } else if (!slug) {
      if (sucio) await guardar();
      cerrarEditor();
      await cargarLista();
    }
  }

  alAbrir('ventas', async () => {
    if (!isSupabaseConfigured) {
      const ul = $('[data-v-lista]');
      ul.textContent = '';
      ul.append(el('li', { class: 'filas__vacio soft', text: 'Sin conectar: no hay de dónde leer las páginas.' }));
      return;
    }
    const ok = await cargarLista();
    arrancada = true;
    if (ok) await segunHash();
  });

  document.addEventListener('panel:pestana', () => {
    if (arrancada) void segunHash();
  });
</script>

