---
/**
 * Pestaña Mensajes — lo que le preguntan a Emi, para responderlo desde acá.
 *
 * Pedido de Adrián el 23 sep 2026: «arma los mensajes para que pueda
 * responderlos». Junta las dos bandejas que hay:
 *
 * - **Las preguntas de la membresía** (`questions` / `answers`, de la
 *   academia): cada pregunta cuelga del ejercicio de la semana. Se responde
 *   con texto, y puede haber más de una respuesta. **Privadas desde el 28 sep
 *   2026** (migración 0011): cada miembro ve solo las suyas; hasta ese día
 *   era un foro que leían todos.
 * - **Los hilos de los cursos** (`course_questions`, migración 0009): el hilo
 *   privado de cada alumna con Emi, con la clase y el minuto pegados. Se
 *   responde con **texto, video o audio**, o con una mezcla (decidido el 31 ago
 *   2026). El video es un enlace de Bunny o de Vimeo, como en las clases. El
 *   audio se graba acá mismo, con el micrófono, y va al bucket privado
 *   «cursos» en `<curso>/respuestas/<alumna>/…`: solo lo oye ella (migración
 *   0010). Al leerla, en su escritorio se apaga el aviso «Te respondí».
 *
 * **Una fila por persona, desde el 1 oct 2026** (pedido de Adrián: «aparecen
 * todas las respondidas como una lista interminable»). Hasta ese día era una
 * tarjeta por pregunta, todas seguidas. Ahora:
 *
 * - `#mensajes` es **la lista de quienes preguntaron algo**, y nadie más. Por
 *   defecto, solo quienes esperan respuesta —primero quien lleva más tiempo
 *   esperando—; «Todas» enseña también a quien ya está al día.
 * - `#mensajes/<id>` es **la conversación con esa persona**: todo lo que
 *   preguntó, en la membresía y en los cursos, con tus respuestas, de lo más
 *   nuevo a lo más viejo. Lo que espera respuesta trae su campo abierto.
 *
 * Al responder, a la persona le llega un correo avisándole (`/api/avisos`); y
 * a Emi le llega uno cada vez que alguien pregunta, con el enlace directo a
 * esa conversación. La cifra al lado de «Mensajes» en la barra son las
 * preguntas que esperan respuesta.
 */
---

<div class="app-wrap pest mensajes" data-mensajes>
  {/* --- La lista: una fila por persona ------------------------------------ */}
  <div data-m-lista-vista>
    <header class="pest-cab">
      <div>
        <p class="eyebrow">Mensajes</p>
        <h1 class="app-h1 pest-cab__h">Lo que te preguntan.</h1>
      </div>
    </header>
    <p class="mensajes__que soft">
      Una fila por persona: solo quienes te han preguntado algo. Pulsa a alguien para ver toda la conversación
      —la membresía y los cursos— y responder desde ahí.
    </p>

    <div class="mensajes__filtros">
      <div class="segmento" role="tablist" aria-label="Qué enseñar" data-m-estado>
        <button class="mono segmento__b" type="button" role="tab" data-v="pendientes" aria-selected="true">Esperan respuesta</button>
        <button class="mono segmento__b" type="button" role="tab" data-v="todas" aria-selected="false">Todas</button>
      </div>
      <label class="campo mensajes__buscar">
        <span class="visually-hidden">Buscar</span>
        <input type="search" placeholder="Buscar por nombre o correo" data-m-buscar />
      </label>
    </div>

    <p class="mono soft mensajes__cuenta" data-m-cuenta aria-live="polite"></p>
    <ul class="filas" role="list" data-m-personas>
      <li class="filas__vacio soft">Cargando…</li>
    </ul>
  </div>

  {/* --- La conversación con una persona ------------------------------------ */}
  <div data-m-conv hidden>
    <a class="mono mensajes__volver" href="#mensajes">← Todas las conversaciones</a>
    <header class="mensajes__cab">
      <p class="eyebrow">Conversación</p>
      <h1 class="app-h1 app-h1--sm" data-m-c-h></h1>
      <p class="mono soft" data-m-c-sub></p>
      <p class="mono" data-m-c-ficha></p>
    </header>
    <ol class="mensajes__lista" role="list" data-m-lista></ol>
  </div>

  <p class="aviso mensajes__aviso" data-m-sin-medios hidden>
    <b>Video y audio, en pausa</b> — Para responder en los cursos con video o con audio falta un paso en la base
    de datos: pegar <code>supabase/migrations/0010_tienda_paginas_mensajes.sql</code> en Supabase → SQL Editor.
    Mientras tanto, se responde con texto.
  </p>
</div>

<script>
  import type { Session } from '@supabase/supabase-js';
  import { supabase, isSupabaseConfigured } from '../../lib/supabase';
  import { alAbrir, armarBotones, avisar, boton, el, fechaHora, hace, leerHash, ocupado } from '../../lib/panel';
  import { normalizeVideoUrl, videoEmbed } from '../../lib/video';
  import { avisarPorCorreo } from '../../lib/avisos';

  type Msj = {
    tipo: 'foro' | 'curso';
    id: string;
    user_id: string;
    quien: string;
    correo: string | null;
    body: string;
    creada: string;
    donde: string;
    detalle: string;
    donde_id: string;
    respondida: boolean;
    /** Foro: el ejercicio ya salió del aula y ella no ve el foro. No cuenta como pendiente. */
    vencida?: boolean;
    /* Foro */
    respuestas?: { id: string; body: string; created_at: string }[];
    /* Curso */
    answer?: string | null;
    answer_video?: string | null;
    answer_audio_path?: string | null;
    answer_seen_at?: string | null;
    answered_at?: string | null;
  };

  const raiz = document.querySelector<HTMLElement>('[data-mensajes]')!;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => raiz.querySelector<T>(s)!;

  /** Una fila de la lista: alguien que preguntó, con todo lo suyo. */
  type Persona = {
    user_id: string;
    quien: string;
    correo: string | null;
    msjs: Msj[];
    /** Las que esperan respuesta. */
    esperan: number;
    /** La pregunta más vieja de las que esperan: manda en el orden. */
    esperaDesde: number | null;
    /** Lo último que pasó: su última pregunta o tu última respuesta. */
    ultima: number;
    lugares: string[];
  };

  let sesion: Session | null = null;
  let todos: Msj[] = [];
  let personas: Persona[] = [];
  type Estado = 'pendientes' | 'todas';
  let estado: Estado = 'pendientes';
  let busca = '';
  /** La persona cuya conversación está abierta (`#mensajes/<id>`), o `null`. */
  let abierta: string | null = null;
  let conMedios = true;
  let arrancada = false;

  /** Lo que espera respuesta: sin responder y que ella todavía puede leer. */
  const espera = (m: Msj) => !m.respondida && !m.vencida;

  const reloj = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

  /* ==========================================================================
     Cargar las dos bandejas
     ========================================================================== */

  const CAMPOS_CURSO =
    'id, course_id, lesson_id, user_id, author_name, minute_s, body, answer, answered_at, created_at, courses(title_es, slug), course_lessons(title_es), profiles(email, full_name)';

  async function cargar() {
    const pedirCursos = (extra: string) =>
      supabase.from('course_questions').select(CAMPOS_CURSO + extra).order('created_at', { ascending: false }).limit(1000);
    const [foro, primero] = await Promise.all([
      supabase
        .from('questions')
        .select(
          'id, body, lang, created_at, author_name, user_id, exercises(title_es, week_label, publish_at, unpublish_at, kind), answers(id, body, created_at), profiles(email, full_name)',
        )
        .order('created_at', { ascending: false })
        .limit(1000),
      pedirCursos(', answer_video, answer_audio_path, answer_seen_at'),
    ]);
    let cursos = primero;
    conMedios = !cursos.error;
    if (cursos.error && /answer_(video|audio_path|seen_at)/.test(cursos.error.message)) cursos = await pedirCursos('');
    $('[data-m-sin-medios]').hidden = conMedios || Boolean(cursos.error);

    const lista: Msj[] = [];
    if (foro.error) console.error('[mensajes] foro', foro.error);
    const ahora = Date.now();
    (foro.data ?? []).forEach((q: any) => {
      const ex = q.exercises ?? {};
      /* La misma regla que «Hoy»: el foro se ve mientras el ejercicio está en
         el aula (el bonus no caduca). */
      const vivo = Boolean(q.exercises) && Date.parse(ex.publish_at) <= ahora && (ex.kind === 'bonus' || Date.parse(ex.unpublish_at) > ahora);
      lista.push({
        tipo: 'foro',
        id: q.id,
        user_id: q.user_id,
        quien: q.profiles?.full_name || q.author_name || q.profiles?.email || '(sin nombre)',
        correo: q.profiles?.email ?? null,
        body: q.body,
        creada: q.created_at,
        donde: 'Membresía',
        detalle: [ex.week_label, ex.title_es, q.lang === 'en' ? 'en inglés' : null].filter(Boolean).join(' · '),
        donde_id: 'foro',
        respondida: Boolean(q.answers?.length),
        vencida: !vivo,
        respuestas: [...(q.answers ?? [])].sort((a: any, b: any) => Date.parse(a.created_at) - Date.parse(b.created_at)),
      });
    });
    if (cursos.error) console.error('[mensajes] cursos', cursos.error);
    (cursos.data ?? []).forEach((q: any) => {
      const titulo = q.courses?.title_es || q.courses?.slug || 'Un curso';
      lista.push({
        tipo: 'curso',
        id: q.id,
        user_id: q.user_id,
        quien: q.profiles?.full_name || q.author_name || q.profiles?.email || '(sin nombre)',
        correo: q.profiles?.email ?? null,
        body: q.body,
        creada: q.created_at,
        donde: titulo,
        detalle: [q.course_lessons?.title_es, q.minute_s != null ? `en el minuto ${reloj(q.minute_s)}` : null].filter(Boolean).join(' · '),
        donde_id: q.course_id,
        respondida: Boolean(q.answered_at),
        answer: q.answer,
        answer_video: q.answer_video ?? null,
        answer_audio_path: q.answer_audio_path ?? null,
        answer_seen_at: q.answer_seen_at ?? null,
        answered_at: q.answered_at,
      });
    });
    todos = lista;
    personas = agrupar(lista);

    document.dispatchEvent(new CustomEvent('panel:pendientes', { detail: todos.filter(espera).length }));
    pintar();
  }

  /** Las preguntas, juntadas por quien las hizo. */
  function agrupar(lista: Msj[]): Persona[] {
    const por = new Map<string, Persona>();
    lista.forEach((m) => {
      let p = por.get(m.user_id);
      if (!p) {
        p = { user_id: m.user_id, quien: m.quien, correo: m.correo, msjs: [], esperan: 0, esperaDesde: null, ultima: 0, lugares: [] };
        por.set(m.user_id, p);
      }
      p.msjs.push(m);
      const creada = Date.parse(m.creada);
      if (espera(m)) {
        p.esperan += 1;
        p.esperaDesde = p.esperaDesde === null ? creada : Math.min(p.esperaDesde, creada);
      }
      const resp = m.tipo === 'foro' ? (m.respuestas ?? []).map((r) => Date.parse(r.created_at)) : m.answered_at ? [Date.parse(m.answered_at)] : [];
      p.ultima = Math.max(p.ultima, creada, ...resp);
      if (!p.lugares.includes(m.donde)) p.lugares.push(m.donde);
    });
    /* Lo más nuevo arriba dentro de cada conversación: lo que espera suele ser
       lo último que preguntó, y debajo queda la historia. */
    por.forEach((p) => p.msjs.sort((a, b) => Date.parse(b.creada) - Date.parse(a.creada)));
    return [...por.values()];
  }

  /* ==========================================================================
     Pintar
     ========================================================================== */

  const plural = (n: number, uno: string, varios: string) => `${n} ${n === 1 ? uno : varios}`;

  /** Lo que toque según el `#hash`: la lista, o la conversación con alguien. */
  function pintar() {
    if (abierta) pintarConversacion(abierta);
    else pintarLista();
  }

  function pintarLista() {
    $('[data-m-lista-vista]').hidden = false;
    $('[data-m-conv]').hidden = true;
    const ul = $('[data-m-personas]');
    ul.textContent = '';

    const sinTilde = (t: string) =>
      t
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase();
    const q = sinTilde(busca.trim());
    const lista = personas
      .filter((p) => (estado === 'todas' ? true : p.esperan > 0))
      .filter((p) => !q || sinTilde(`${p.quien} ${p.correo ?? ''}`).includes(q))
      /* Primero quien espera, y entre quienes esperan, quien lleva más tiempo
         esperando: se contesta en orden. Después, lo más reciente. */
      .sort((a, b) => {
        if (a.esperaDesde !== null && b.esperaDesde !== null) return a.esperaDesde - b.esperaDesde;
        if (a.esperaDesde !== null) return -1;
        if (b.esperaDesde !== null) return 1;
        return b.ultima - a.ultima;
      });

    const conEspera = personas.filter((p) => p.esperan > 0).length;
    const preguntas = todos.filter(espera).length;
    $('[data-m-cuenta]').textContent = conEspera
      ? `${plural(conEspera, 'persona espera', 'personas esperan')} respuesta · ${plural(preguntas, 'pregunta', 'preguntas')} sin responder · ${plural(personas.length, 'persona', 'personas')} en total`
      : `${plural(personas.length, 'persona', 'personas')} te han preguntado algo`;

    if (!lista.length) {
      ul.append(
        el('li', {
          class: 'filas__vacio soft',
          text: q
            ? 'Nadie con ese nombre o correo.'
            : estado === 'pendientes'
              ? 'Todo respondido. Nadie espera nada.'
              : 'Todavía nadie te ha preguntado nada.',
        }),
      );
      return;
    }
    lista.forEach((p) => ul.append(filaPersona(p)));
  }

  function filaPersona(p: Persona): HTMLElement {
    const href = `#mensajes/${p.user_id}`;
    const datos = [
      p.correo && p.correo !== p.quien ? p.correo : null,
      p.lugares.join(' · '),
      plural(p.msjs.length, 'pregunta', 'preguntas'),
      `lo último ${hace(new Date(p.ultima).toISOString())}`,
    ].filter(Boolean);
    return el(
      'li',
      { class: 'fila' },
      el('div', { class: 'fila__txt' }, el('a', { class: 'fila__t', href, text: p.quien }), el('p', { class: 'mono-plain soft', text: datos.join(' · ') })),
      el('span', {
        class: p.esperan ? 'estado estado--tinta' : 'estado',
        text: p.esperan ? `${p.esperan} sin responder` : 'Al día',
      }),
      el('div', { class: 'fila__actos' }, el('a', { class: 'mono', href, text: 'Abrir →' })),
    );
  }

  function pintarConversacion(id: string) {
    $('[data-m-lista-vista]').hidden = true;
    $('[data-m-conv]').hidden = false;
    const p = personas.find((x) => x.user_id === id);
    const ul = $('[data-m-lista]');
    ul.textContent = '';
    $('[data-m-c-h]').textContent = p?.quien ?? 'Sin mensajes';
    $('[data-m-c-sub]').textContent = p
      ? [
          p.correo && p.correo !== p.quien ? p.correo : null,
          plural(p.msjs.length, 'pregunta', 'preguntas'),
          p.esperan ? `${p.esperan} sin responder` : 'todo respondido',
        ]
          .filter(Boolean)
          .join(' · ')
      : '';
    $('[data-m-c-ficha]').replaceChildren(el('a', { href: `#personas/${id}`, text: 'Ver su ficha en Personas →' }));
    if (!p) {
      ul.append(el('li', { class: 'filas__vacio soft', text: 'No queda nada en esta conversación: sus preguntas se borraron.' }));
      return;
    }
    p.msjs.forEach((m) => ul.append(tarjeta(m)));
    armarBotones();
  }

  function tarjeta(m: Msj): HTMLElement {
    const li = el('li', { class: `msj-card${espera(m) ? ' msj-card--pendiente' : ''}` });
    const borrar = el('button', { class: 'btn-text msj-card__borrar', type: 'button', text: 'Borrar la pregunta' });
    borrar.addEventListener('click', () => borrarPregunta(m));
    li.append(
      el(
        'div',
        { class: 'msj-card__cab' },
        el('p', { class: 'mono' }, m.donde, m.detalle ? el('span', { class: 'soft', text: ` · ${m.detalle}` }) : null),
        el('p', { class: 'mono soft', title: fechaHora(m.creada), text: hace(m.creada) }),
      ),
      el('p', { class: 'msj-card__txt', text: m.body }),
    );
    if (m.vencida && !m.respondida)
      li.append(el('p', { class: 'ficha-form__nota', text: 'Ese ejercicio ya salió del aula, así que no cuenta como pendiente. Igual la ve en «Tus preguntas», y si respondes le llega el correo.' }));

    if (m.tipo === 'foro') {
      (m.respuestas ?? []).forEach((r) => li.append(respuestaForo(r)));
      const otra = !m.respondida && !m.vencida;
      const comp = compositorForo(m);
      if (otra) li.append(comp);
      else {
        const mas = el('button', { class: 'btn-text', type: 'button', text: m.respondida ? 'Añadir otra respuesta' : 'Responder igual' });
        mas.addEventListener('click', () => {
          mas.replaceWith(comp);
          comp.querySelector('textarea')?.focus();
          armarBotones();
        });
        li.append(el('div', { class: 'msj-card__pie' }, mas, borrar));
        return li;
      }
    } else {
      if (m.respondida) {
        li.append(respuestaCurso(m));
        const editar = el('button', { class: 'btn-text', type: 'button', text: 'Cambiar la respuesta' });
        editar.addEventListener('click', () => {
          const comp = compositorCurso(m);
          editar.parentElement!.replaceWith(comp);
          comp.querySelector('textarea')?.focus();
          armarBotones();
        });
        li.append(
          el(
            'div',
            { class: 'msj-card__pie' },
            editar,
            el('span', { class: 'mono soft', text: m.answer_seen_at ? `La vio ${hace(m.answer_seen_at)}` : 'Todavía no la vio' }),
            borrar,
          ),
        );
        return li;
      }
      li.append(compositorCurso(m));
    }
    li.append(el('div', { class: 'msj-card__pie msj-card__pie--fin' }, borrar));
    return li;
  }

  /* --- Foro ------------------------------------------------------------------ */

  function respuestaForo(r: { id: string; body: string; created_at: string }) {
    const quitar = el('button', { class: 'btn-text', type: 'button', text: 'Borrar' });
    quitar.addEventListener('click', async () => {
      if (!window.confirm('¿Borrar esta respuesta? Deja de verla en la membresía.')) return;
      const { error } = await supabase.from('answers').delete().eq('id', r.id);
      if (error) return avisar(`No se pudo borrar: ${error.message}`);
      avisar('Respuesta borrada');
      await cargar();
    });
    return el(
      'div',
      { class: 'msj-card__resp' },
      el('p', { class: 'mono msj-card__emi' }, 'Tú', el('span', { class: 'soft', text: ` · ${hace(r.created_at)}` })),
      el('p', { class: 'msj-card__txt', text: r.body }),
      el('div', { class: 'msj-card__resp-actos' }, quitar),
    );
  }

  function compositorForo(m: Msj) {
    const ta = el('textarea', { rows: 4, 'aria-label': `Tu respuesta a ${m.quien}`, placeholder: 'Tu respuesta…' });
    const err = el('p', { class: 'error', hidden: true });
    const enviar = boton('Responder', { solido: true, chico: true });
    enviar.addEventListener('click', () =>
      ocupado(enviar, 'Enviando…', async () => {
        err.hidden = true;
        const texto = ta.value.trim();
        if (!texto) {
          err.textContent = 'Escribe la respuesta antes de enviarla.';
          err.hidden = false;
          return;
        }
        const { data: nueva, error } = await supabase
          .from('answers')
          .insert({ question_id: m.id, user_id: sesion?.user.id, body: texto })
          .select('id')
          .single();
        if (error) {
          err.textContent = `No se pudo enviar: ${error.message}`;
          err.hidden = false;
          return;
        }
        /* Le llega un correo avisándole que le respondiste. */
        avisarPorCorreo('respuesta', 'foro', nueva?.id);
        avisar('Respondida: le llega un correo avisándole');
        await cargar();
      }),
    );
    return el(
      'div',
      { class: 'msj-card__comp' },
      el('div', { class: 'campo' }, ta),
      el('p', { class: 'campo__ayuda', text: 'La ve en «Tus preguntas» de la membresía, debajo de su pregunta, y le llega un correo avisándole. En la membresía se responde con texto.' }),
      err,
      el('div', { class: 'msj-card__comp-actos' }, enviar),
    );
  }

  /* --- Cursos ----------------------------------------------------------------- */

  function respuestaCurso(m: Msj) {
    const r = el(
      'div',
      { class: 'msj-card__resp' },
      el('p', { class: 'mono msj-card__emi' }, 'Tú', m.answered_at ? el('span', { class: 'soft', text: ` · ${hace(m.answered_at)}` }) : null),
    );
    if (m.answer) r.append(el('p', { class: 'msj-card__txt', text: m.answer }));
    const emb = m.answer_video ? videoEmbed(m.answer_video) : null;
    if (emb?.ok) {
      const marco = el('div', { class: 'msj-card__video' });
      const iframe = el('iframe', { src: emb.src, title: 'Tu respuesta en video', loading: 'lazy', allow: emb.allow, allowfullscreen: true });
      marco.append(iframe);
      r.append(marco);
    } else if (m.answer_video) {
      r.append(el('p', { class: 'error', text: `No se reconoce el enlace del video: ${m.answer_video}` }));
    }
    if (m.answer_audio_path) {
      const audio = el('audio', { class: 'msj-card__audio', controls: true, preload: 'none' });
      r.append(audio);
      void supabase.storage
        .from('cursos')
        .createSignedUrl(m.answer_audio_path, 3600)
        .then(({ data }) => {
          if (data?.signedUrl) audio.src = data.signedUrl;
        });
    }
    return r;
  }

  /** La grabadora: micrófono → un audio que se escucha antes de mandarlo. */
  function grabadora() {
    const caja = el('div', { class: 'grab' });
    let blob: Blob | null = null;
    let rec: MediaRecorder | null = null;
    let partes: Blob[] = [];
    let t0 = 0;
    let tic: number | undefined;

    const pintar = (fase: 'nada' | 'grabando' | 'listo', msg?: string) => {
      caja.textContent = '';
      window.clearInterval(tic);
      if (fase === 'nada') {
        const b = el('button', { class: 'btn-text grab__b', type: 'button' }, el('span', { class: 'grab__punto', 'aria-hidden': 'true' }), 'Grabar un audio');
        b.addEventListener('click', empezar);
        caja.append(b);
        if (msg) caja.append(el('span', { class: 'error grab__err', text: msg }));
      } else if (fase === 'grabando') {
        const t = el('span', { class: 'mono tnum grab__t', text: '0:00' });
        const b = el('button', { class: 'btn-text grab__b grab__b--vivo', type: 'button' }, el('span', { class: 'grab__cuadro', 'aria-hidden': 'true' }), 'Detener');
        b.addEventListener('click', () => rec?.stop());
        tic = window.setInterval(() => (t.textContent = reloj((Date.now() - t0) / 1000)), 250);
        caja.append(b, t, el('span', { class: 'mono soft', text: 'Grabando…' }));
      } else {
        const audio = el('audio', { controls: true, src: URL.createObjectURL(blob!) });
        const otra = el('button', { class: 'btn-text', type: 'button', text: 'Volver a grabar' });
        const quitar = el('button', { class: 'btn-text', type: 'button', text: 'Quitar el audio' });
        otra.addEventListener('click', empezar);
        quitar.addEventListener('click', () => {
          blob = null;
          pintar('nada');
        });
        caja.append(audio, otra, quitar);
      }
    };

    async function empezar() {
      if (!navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === 'undefined')
        return pintar('nada', 'Este navegador no deja grabar. Prueba con Chrome, Safari o Firefox al día.');
      let flujo: MediaStream;
      try {
        flujo = await navigator.mediaDevices.getUserMedia({ audio: true });
      } catch {
        return pintar('nada', 'No hay permiso para el micrófono. Dáselo en la barra de la dirección y vuelve a intentarlo.');
      }
      const tipo = ['audio/webm;codecs=opus', 'audio/mp4', 'audio/ogg;codecs=opus'].find((x) => MediaRecorder.isTypeSupported(x));
      rec = new MediaRecorder(flujo, tipo ? { mimeType: tipo } : undefined);
      partes = [];
      rec.addEventListener('dataavailable', (e) => e.data.size && partes.push(e.data));
      rec.addEventListener('stop', () => {
        flujo.getTracks().forEach((x) => x.stop());
        blob = new Blob(partes, { type: rec?.mimeType || tipo || 'audio/webm' });
        pintar(blob.size ? 'listo' : 'nada', blob.size ? undefined : 'No se grabó nada.');
      });
      t0 = Date.now();
      rec.start(1000);
      pintar('grabando');
    }

    pintar('nada');
    return {
      caja,
      audio: () => blob,
      grabando: () => rec?.state === 'recording',
    };
  }

  function compositorCurso(m: Msj) {
    const ta = el('textarea', { rows: 4, 'aria-label': `Tu respuesta a ${m.quien}`, placeholder: 'Tu respuesta…' });
    ta.value = m.answer ?? '';
    const video = el('input', { type: 'text', 'aria-label': 'Video de la respuesta', placeholder: 'Enlace del video en Bunny o Vimeo (opcional)', spellcheck: 'false' });
    video.value = m.answer_video ?? '';
    const g = grabadora();
    let quitarAudioViejo = false;
    const err = el('p', { class: 'error', hidden: true });
    const enviar = boton(m.respondida ? 'Guardar la respuesta' : 'Responder', { solido: true, chico: true });

    const medios = el('div', { class: 'msj-card__medios' });
    if (conMedios) {
      medios.append(el('div', { class: 'campo' }, video));
      if (m.answer_audio_path) {
        const viejo = el('p', { class: 'mono soft msj-card__viejo' }, 'Ya tiene un audio. ');
        const q = el('button', { class: 'btn-text', type: 'button', text: 'Quitarlo' });
        q.addEventListener('click', () => {
          quitarAudioViejo = true;
          viejo.replaceChildren('El audio de antes se quita al guardar.');
        });
        viejo.append(q, ' · Si grabas otro, lo reemplaza.');
        medios.append(viejo);
      }
      medios.append(g.caja);
    }

    enviar.addEventListener('click', () =>
      ocupado(enviar, 'Enviando…', async () => {
        err.hidden = true;
        const falla = (t: string) => {
          err.textContent = t;
          err.hidden = false;
        };
        if (g.grabando()) return falla('Detén la grabación antes de enviar.');
        const texto = ta.value.trim();
        const enlace = video.value.trim();
        const nuevoAudio = g.audio();
        const audioQueda = !quitarAudioViejo && !nuevoAudio ? m.answer_audio_path ?? null : null;
        if (!texto && !enlace && !nuevoAudio && !audioQueda) return falla('Escribe algo, pon un video o graba un audio.');
        if (enlace && !videoEmbed(enlace).ok) return falla('No reconozco ese enlace de video. Copia el de Bunny («Embed» o la dirección del video) o el de Vimeo.');

        let ruta = audioQueda;
        if (nuevoAudio) {
          const ext = nuevoAudio.type.includes('mp4') ? 'm4a' : nuevoAudio.type.includes('ogg') ? 'ogg' : 'webm';
          ruta = `${m.donde_id}/respuestas/${m.user_id}/${m.id}-${Date.now()}.${ext}`;
          const up = await supabase.storage.from('cursos').upload(ruta, nuevoAudio, { contentType: nuevoAudio.type || 'audio/webm' });
          if (up.error) return falla(`No se pudo subir el audio: ${up.error.message}`);
        }
        const cambios: Record<string, unknown> = { answer: texto || null, answered_at: new Date().toISOString() };
        if (conMedios) {
          cambios.answer_video = enlace ? normalizeVideoUrl(enlace) : null;
          cambios.answer_audio_path = ruta;
          /* Si la cambias, le vuelve a salir «Te respondí». */
          cambios.answer_seen_at = null;
        }
        const { error } = await supabase.from('course_questions').update(cambios).eq('id', m.id);
        if (error) return falla(`No se pudo guardar: ${error.message}`);
        /* El audio de antes, si se quitó o se reemplazó, se borra del bucket. */
        if (m.answer_audio_path && m.answer_audio_path !== ruta) await supabase.storage.from('cursos').remove([m.answer_audio_path]);
        /* El correo sale con la primera respuesta, no cuando la cambias. */
        if (!m.respondida) avisarPorCorreo('respuesta', 'curso', m.id);
        avisar(m.respondida ? 'Respuesta cambiada' : 'Respondida: le llega un correo avisándole');
        await cargar();
      }),
    );

    return el(
      'div',
      { class: 'msj-card__comp' },
      el('div', { class: 'campo' }, ta),
      medios,
      el('p', {
        class: 'campo__ayuda',
        text: 'La ve en el hilo del curso, debajo de su pregunta; en su escritorio le sale «Te respondí» y le llega un correo avisándole (solo la primera vez, no si la cambias). Puedes mandar texto, video, audio o varios.',
      }),
      err,
      el('div', { class: 'msj-card__comp-actos' }, enviar),
    );
  }

  /* --- Borrar una pregunta ------------------------------------------------------ */

  async function borrarPregunta(m: Msj) {
    if (!window.confirm(`¿Borrar la pregunta de ${m.quien}${m.respondida ? ' y tu respuesta' : ''}?\n\nDesaparece para ella también. Para spam o para lo que se mandó por error.`)) return;
    const { error } =
      m.tipo === 'foro'
        ? await supabase.from('questions').delete().eq('id', m.id)
        : await supabase.from('course_questions').delete().eq('id', m.id);
    if (error) return avisar(`No se pudo borrar: ${error.message}`);
    if (m.answer_audio_path) await supabase.storage.from('cursos').remove([m.answer_audio_path]);
    avisar('Pregunta borrada');
    await cargar();
  }

  /* ==========================================================================
     Filtros y arranque
     ========================================================================== */

  raiz.querySelectorAll<HTMLElement>('[data-m-estado] [data-v]').forEach((b) =>
    b.addEventListener('click', () => {
      estado = b.dataset.v as Estado;
      raiz.querySelectorAll<HTMLElement>('[data-m-estado] [data-v]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      pintarLista();
    }),
  );
  $<HTMLInputElement>('[data-m-buscar]').addEventListener('input', (e) => {
    busca = (e.target as HTMLInputElement).value;
    pintarLista();
  });

  /** Lo que diga el `#hash`: `#mensajes` o `#mensajes/<id>`. */
  function segunHash(): boolean {
    const [pest, id] = leerHash();
    if (pest !== 'mensajes') return false;
    const cambia = id !== abierta;
    abierta = id;
    if (cambia) {
      pintar();
      window.scrollTo({ top: 0 });
    }
    return true;
  }

  alAbrir('mensajes', async (s) => {
    sesion = s;
    if (!isSupabaseConfigured) {
      const ul = $('[data-m-personas]');
      ul.textContent = '';
      ul.append(el('li', { class: 'filas__vacio soft', text: 'Sin conectar: no hay de dónde leer los mensajes.' }));
      return;
    }
    abierta = leerHash()[1];
    await cargar();
    arrancada = true;
  });

  /* Al volver a la pestaña, o al pasar de la lista a una conversación: se
     pinta enseguida con lo que hay y se relee por detrás —pudo llegar algo
     mientras Emi estaba en otra parte—. No mientras escribe: si hay un campo
     de respuesta con texto, se deja como está. */
  document.addEventListener('panel:pestana', (e) => {
    if ((e as CustomEvent).detail !== 'mensajes' || !arrancada) return;
    if (!segunHash()) return;
    const escribiendo = Array.from(raiz.querySelectorAll<HTMLTextAreaElement>('.msj-card__comp textarea')).some((t) => t.value.trim());
    if (!escribiendo) void cargar();
  });
</script>

