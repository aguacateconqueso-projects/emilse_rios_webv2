---
/**
 * La consola de Emi — el portero, la barra de pestañas y las pestañas.
 *
 * Cada pestaña es **su propio componente** (`Hoy`, `Membresia`, `Cursos`…) y
 * se habla con las demás solo por `src/lib/panel.ts`. El panel de la academia
 * era un fichero de 1.059 líneas con tres pestañas; con ocho no se sostiene.
 *
 * **Solo en español.** Lo usan dos personas y las dos hablan español. El
 * contenido que se escribe desde acá sí es bilingüe; la herramienta no.
 *
 * ⚠️ **El portero de esta pantalla NO es la seguridad.** Decide qué se dibuja.
 * Quien protege los datos es la RLS con `is_admin()`: alguien que fuerce este
 * gate desde la consola del navegador verá pestañas vacías, porque las
 * consultas se las rechaza Supabase. Y las rutas de API empiezan todas por
 * comprobar el rol en el servidor.
 */
import { useAula, escritorioPath, entrarPath, salirPath } from '../../i18n/aula';
import { isSupabaseConfigured } from '../../lib/supabase';
import Boton from '../Boton.astro';
import { secciones } from '../../data/panel';
import Inicio from './Inicio.astro';
import Hoy from './Hoy.astro';
import Membresia from './Membresia.astro';
import Cursos from './Cursos.astro';
import Tienda from './Tienda.astro';
import Ventas from './Ventas.astro';
import Personas from './Personas.astro';
import Mensajes from './Mensajes.astro';

const lang = 'es' as const;
const a = useAula(lang);

/**
 * Las pestañas, en el orden de la barra: la vista general primero —es la
 * pantalla con la que se abre el panel— y después las secciones de
 * `src/data/panel.ts`.
 */
const pestanas = [{ id: 'inicio', titulo: 'Inicio' }, ...secciones];
---

<div
  class="consola"
  data-consola
  data-gate-needed={a('gate.needed')}
  data-gate-needed-lead={a('gate.neededLead')}
  data-gate-admin={a('gate.adminOnly')}
  data-gate-admin-lead={a('gate.adminOnlyLead')}
>
  {/* --- El portero ---------------------------------------------------- */}
  <div class="porton" data-porton>
    <div class="porton__caja">
      <img class="porton__logo" src="/logo.svg" alt="Emilse Ríos" width="1631" height="487" />
      <p class="eyebrow">{a('panel.title')}</p>
      <h1 class="porton__h" data-porton-h>{a('gate.checking')}</h1>
      <p class="porton__p" data-porton-p>{a('gate.wait')}</p>
      <div class="porton__actos" data-porton-actos hidden>
        <span data-porton-entrar>
          <Boton class="boton--solid" href={entrarPath(lang)}>{a('gate.signin')}</Boton>
        </span>
        <Boton href={escritorioPath(lang)}>{a('app.desk')}</Boton>
      </div>
    </div>
  </div>

  {/* --- La consola, oculta hasta que el portero abre -------------------- */}
  <div class="consola__cuerpo" data-cuerpo hidden>
    <header class="pbar">
      <div class="pbar__in">
        <a class="pbar__logo" href="/panel/#inicio" aria-label="Panel · Vista general">
          <img src="/logo.svg" alt="Emilse Ríos" width="1631" height="487" />
          <span class="mono">{a('panel.title')}</span>
        </a>

        <nav class="pbar__tabs" aria-label="Secciones del panel">
          {
            pestanas.map((p) => (
              <a class="mono pbar__tab" href={`#${p.id}`} data-ir-pestana={p.id}>
                {p.titulo}
                {p.id === 'mensajes' && <span class="pbar__cuenta tnum" data-pendientes hidden />}
              </a>
            ))
          }
        </nav>

        <div class="pbar__fin">
          {/* El enlace que Emi ya conoce, en el mismo sitio que en la academia. */}
          <a class="mono" href={escritorioPath(lang)}>{a('panel.seeAula')}</a>
          <a class="mono" href={salirPath(lang)}>{a('app.leave')}</a>
        </div>
      </div>
    </header>

    {
      !isSupabaseConfigured && (
        <div class="app-wrap consola__aviso">
          <p class="aviso">
            <b>{a('off.badge')}</b> — El panel no está conectado a la base de datos, así que no
            tiene nada que enseñar ni dónde guardar. Faltan las variables de Supabase en este
            despliegue.
          </p>
        </div>
      )
    }

    <main class="consola__main" id="contenido">
      <section data-pestana="inicio" hidden><Inicio /></section>
      <section data-pestana="hoy" hidden><Hoy /></section>
      <section data-pestana="membresia" hidden><Membresia /></section>
      <section data-pestana="cursos" hidden><Cursos /></section>
      <section data-pestana="tienda" hidden><Tienda /></section>
      <section data-pestana="ventas" hidden><Ventas /></section>
      <section data-pestana="personas" hidden><Personas /></section>
      <section data-pestana="mensajes" hidden><Mensajes /></section>
    </main>
  </div>
</div>

<script>
  import { supabase, isSupabaseConfigured } from '../../lib/supabase';
  import { arrancar, mostrar, leerHash } from '../../lib/panel';

  const caja = document.querySelector<HTMLElement>('[data-consola]');
  if (caja) {
    const $ = (s: string) => caja.querySelector<HTMLElement>(s)!;
    const porton = $('[data-porton]');
    const cuerpo = $('[data-cuerpo]');

    const abrir = () => {
      porton.hidden = true;
      cuerpo.hidden = false;
      mostrar(leerHash()[0]);
    };

    const cerrar = (titulo: string, texto: string, ofrecerEntrar: boolean) => {
      $('[data-porton-h]').textContent = titulo;
      $('[data-porton-p]').textContent = texto;
      $('[data-porton-actos]').hidden = false;
      $('[data-porton-entrar]').hidden = !ofrecerEntrar;
    };

    window.addEventListener('hashchange', () => mostrar(leerHash()[0]));

    /* Cuántas preguntas esperan respuesta, al lado de «Mensajes». Lo avisan la
       vista general y la propia pestaña cada vez que cuentan. */
    document.addEventListener('panel:pendientes', (e) => {
      const n = Number((e as CustomEvent).detail) || 0;
      const b = caja.querySelector<HTMLElement>('[data-pendientes]');
      if (!b) return;
      b.textContent = String(n);
      b.hidden = n === 0;
    });

    (async () => {
      /* Sin backend no hay a quién preguntarle el rol: se abre, y cada pestaña
         dice que no tiene de dónde leer. */
      if (!isSupabaseConfigured) {
        abrir();
        arrancar(null);
        return;
      }

      const {
        data: { session },
      } = await supabase.auth.getSession();

      if (!session) {
        cerrar(caja.dataset.gateNeeded!, caja.dataset.gateNeededLead!, true);
        return;
      }

      const { data: perfil, error } = await supabase
        .from('profiles')
        .select('role')
        .eq('id', session.user.id)
        .maybeSingle();

      if (error) console.error('[panel] no se pudo leer el perfil', error);
      if (perfil?.role !== 'admin') {
        cerrar(caja.dataset.gateAdmin!, caja.dataset.gateAdminLead!, false);
        return;
      }

      abrir();
      arrancar(session);
    })();
  }
</script>

<style>
  /* --- La barra -------------------------------------------------------------
     Pegada arriba, sobre papel —sin cristal: el cristal es de la cápsula del
     menú del sitio, y acá no hay cápsula—. El logo, las pestañas en mono y los
     dos enlaces de siempre. En el teléfono las pestañas se deslizan de lado. */
  .pbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .pbar__in {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    max-width: var(--width-full);
    min-height: 4rem;
    margin-inline: auto;
    padding-inline: var(--space-3);
  }

  .pbar__logo {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex: 0 0 auto;
    border-bottom: 0;
  }

  .pbar__logo img {
    width: auto;
    height: 1.5rem;
  }

  .pbar__tabs {
    display: flex;
    gap: var(--space-3);
    flex: 1 1 auto;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .pbar__tabs::-webkit-scrollbar {
    display: none;
  }

  .pbar__tab {
    flex: 0 0 auto;
    padding-block: var(--space-3);
    border-bottom: 1px solid transparent;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .pbar__tab:hover {
    color: var(--ink);
  }

  .pbar__tab[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  /* Las preguntas que esperan respuesta, al lado de «Mensajes»: la cifra en
     tinta invertida, que es lo que hay que ver de un vistazo. */
  .pbar__cuenta {
    display: inline-block;
    min-width: var(--space-3);
    margin-left: var(--space-1);
    padding-inline: var(--space-1);
    background: var(--ink);
    color: var(--paper);
    text-align: center;
  }

  .pbar__fin {
    display: flex;
    gap: var(--space-3);
    flex: 0 0 auto;
  }

  .pbar__fin a {
    border-bottom: 0;
    color: var(--ink-soft);
  }

  .pbar__fin a:hover {
    color: var(--ink);
  }

  @media (max-width: 56rem) {
    .pbar__in {
      flex-wrap: wrap;
      gap: 0 var(--space-3);
      padding-top: var(--space-2);
    }

    .pbar__logo {
      flex: 1 1 auto;
    }

    .pbar__tabs {
      order: 3;
      flex-basis: 100%;
    }

    .pbar__tab {
      padding-block: var(--space-2);
    }
  }

  .consola__aviso {
    margin-top: var(--space-3);
  }

  .consola__main {
    padding-bottom: var(--space-16);
  }
</style>
