---
/**
 * Las pestañas del panel que todavía no están hechas: Tienda, Cartas,
 * Personas y Mensajes.
 *
 * Se anuncian, no se fingen: cada una dice qué va a hacer y, mientras tanto,
 * dónde se hace eso hoy. Es la regla del resto del sitio —un hueco que se ve
 * es un hueco que alguien arregla—.
 */
import { ACADEMIA } from '../../data/aula';

interface Props {
  cual: 'tienda' | 'cartas' | 'personas' | 'mensajes';
}
const { cual } = Astro.props;

const textos = {
  tienda: {
    titulo: 'Tienda',
    que: 'Lo que se ve en Formaciones, desde acá: el orden de las fichas, el precio, la foto y el estado de cada curso —borrador, próximamente, a la venta o cerrado—. Cerrar un curso quita el botón de comprar, nunca el acceso de quien ya lo compró.',
    hoy: 'Hoy el catálogo vive en el código del sitio: cualquier cambio en una ficha lo hacemos nosotros. Lo que se cobra y lo que se ha vendido está en Stripe.',
    enlace: { href: 'https://dashboard.stripe.com/payments', t: 'Abrir Stripe ↗' },
  },
  cartas: {
    titulo: 'Cartas',
    que: 'El texto de la carta de venta de cada curso, bloque a bloque y en los dos idiomas, sin tocar el diseño: se elige el tipo de bloque —entrada, párrafo, lista, preguntas frecuentes, botón— y se rellena.',
    hoy: 'Hoy las cartas viven en el código del sitio. Los cambios se mandan por mensaje y los subimos nosotros.',
    enlace: null,
  },
  personas: {
    titulo: 'Personas',
    que: 'Quién está dentro y desde cuándo: las miembros de la membresía con su suscripción, y quién tiene cada curso. Dar y quitar acceso a mano, a la membresía o a un curso, sin pasar por el pago.',
    hoy: 'Mientras tanto, las altas y bajas manuales de la membresía siguen en la pestaña Miembros del panel de la academia.',
    enlace: { href: `${ACADEMIA}/panel/`, t: 'Panel de la academia ↗' },
  },
  mensajes: {
    titulo: 'Mensajes',
    que: 'Todas las preguntas en un solo sitio: el foro de la membresía y los hilos privados de cada curso, con la clase y el minuto de cada duda pegados. Se responde desde acá.',
    hoy: 'Mientras tanto, el foro de la membresía se responde en la pestaña Foro del panel de la academia. Las dudas de los cursos ya se guardan; se cuentan en «Hoy».',
    enlace: { href: `${ACADEMIA}/panel/`, t: 'Panel de la academia ↗' },
  },
} as const;

const t = textos[cual];
---

<div class="app-wrap pronto">
  <p class="eyebrow">Próximamente</p>
  <h1 class="app-h1 pronto__h">{t.titulo}</h1>
  <p class="pronto__que">{t.que}</p>
  <div class="pronto__hoy">
    <p class="eyebrow">Mientras tanto</p>
    <p>{t.hoy}</p>
    {
      t.enlace && (
        <p class="pronto__enlace">
          <a class="mono" href={t.enlace.href} rel="noopener">
            {t.enlace.t}
          </a>
        </p>
      )
    }
  </div>
</div>

<style>
  .pronto {
    padding-top: var(--space-8);
  }

  .pronto__h {
    margin-top: var(--space-2);
  }

  .pronto__que {
    max-width: var(--measure);
    margin-top: var(--space-4);
    text-wrap: pretty;
  }

  .pronto__hoy {
    max-width: var(--measure);
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }

  .pronto__hoy p + p {
    margin-top: var(--space-1);
  }

  .pronto__enlace {
    margin-top: var(--space-2);
  }
</style>
