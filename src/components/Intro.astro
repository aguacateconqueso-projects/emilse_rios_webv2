---
/**
 * Animación de entrada — 2,0 s, una sola vez por sesión, solo en la Home.
 *
 * 0,0 – 1,1 s  La firma se escribe de izquierda a derecha sobre negro pleno.
 * 1,1 – 1,4 s  Pausa con la firma completa en pantalla.
 * 1,4 – 2,0 s  El panel negro sale hacia arriba. Detrás, la Home ya montada.
 */
import Logo from './Logo.astro';

interface Props {
  name: string;
}
const { name } = Astro.props;
---

<div class="intro" aria-hidden="true">
  <div class="intro__signature"><Logo name={name} /></div>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
    align-items: center;
    justify-content: center;
    background: var(--ink);
    animation: intro-panel 0.6s var(--ease-panel) 1.4s forwards;
  }

  /* El script de <head> marca el documento antes de pintar: sin parpadeo. */
  :global([data-intro='play']) .intro {
    display: flex;
  }

  .intro__signature {
    /* El alto sale del ancho que se le quiere dar, no al revés: la firma es
       una línea larga y lo que manda es cuánto ocupa a lo ancho. */
    --logo-height: calc(min(72vw, 40rem) * 487 / 1631);
    color: var(--paper);
    clip-path: polygon(-20% 0, 0% 0, -12% 100%, -20% 100%);
    animation: intro-write 1.1s var(--ease-write) forwards;
  }

  /* El filo del barrido va inclinado al mismo ángulo que la letra: la firma
     no aparece, se escribe. */
  @keyframes intro-write {
    from {
      clip-path: polygon(-20% 0, 0% 0, -12% 100%, -20% 100%);
    }
    to {
      clip-path: polygon(-20% 0, 120% 0, 108% 100%, -20% 100%);
    }
  }

  @keyframes intro-panel {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-101%);
    }
  }

  /* Quien pide menos movimiento no ve la entrada en absoluto. */
  @media (prefers-reduced-motion: reduce) {
    :global([data-intro='play']) .intro {
      display: none;
    }
  }
</style>

<script>
  // El panel se retira del DOM al terminar para que no quede capturando
  // clics ni scroll por encima de la página.
  const intro = document.querySelector<HTMLElement>('.intro');
  const root = document.documentElement;

  if (intro && root.dataset.intro === 'play') {
    root.style.overflow = 'hidden';

    const finish = () => {
      root.style.overflow = '';
      root.dataset.intro = 'done';
      intro.remove();
    };

    intro.addEventListener('animationend', (event) => {
      if ((event as AnimationEvent).animationName.startsWith('intro-panel')) finish();
    });

    // Red de seguridad: si la animación no llega a dispararse, la página
    // no se queda bloqueada detrás de un panel negro.
    setTimeout(finish, 2600);
  }
</script>
