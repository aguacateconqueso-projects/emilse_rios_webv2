---
/**
 * El botón de una carta de curso, con la línea de debajo. Sale dos veces en
 * cada carta —en la tarjeta de precio y al final—, como el de la membresía.
 *
 * Sin `href`, **en gris y sin enlace**: es un `<span>`, no un `<a>`, así que ni
 * con el teclado ni copiando el enlace lleva a ningún sitio. Es lo que pidió
 * Adrián para los cursos que todavía no se venden («botones en gris»), y es
 * el mismo gris de las puertas cerradas de la membresía.
 */
import type { CartaCurso } from '../../data/cartas';
import { NEWSLETTER } from '../../data/cartas';

interface Props {
  t: CartaCurso;
}
const { t } = Astro.props;
const fuera = t.boton.fuera ? { target: '_blank', rel: 'noopener' } : {};
---

{
  t.boton.href ? (
    <a class="btn" href={t.boton.href} {...fuera}>
      <span class="btn__fill" aria-hidden="true" />
      <span class="btn__label">{t.boton.texto}</span>
      <span class="btn__ar" aria-hidden="true">→</span>
    </a>
  ) : (
    <span class="btn btn--off" aria-disabled="true">
      <span class="btn__label">{t.boton.texto}</span>
    </span>
  )
}
<p class="pronto">
  {t.pronto}
  {
    t.avisame && (
      <a class="pronto__news" href={NEWSLETTER} target="_blank" rel="noopener">
        {t.avisame} →
      </a>
    )
  }
</p>
