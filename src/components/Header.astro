---
import { type Lang, type Route, useTranslations, routePath } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
  /** Página actual, para que el conmutador de idioma no te saque de ella. */
  route?: Route;
}
const { lang, route = 'home' } = Astro.props;
const t = useTranslations(lang);
---

<header class="header">
  <div class="header__inner">
    <a class="header__mark" href={routePath('home', lang)} title={t('nav.home')}>
      <Logo name={t('site.name')} />
    </a>

    <nav class="header__nav mono" aria-label={t('site.title')}>
      <a
        class="header__link"
        href={routePath('about', lang)}
        aria-current={route === 'about' ? 'page' : undefined}>{t('nav.about')}</a
      >
      <span class="header__link header__link--muted" aria-disabled="true" title={t('nav.aulaSoon')}>
        {t('nav.aula')}
      </span>
      <LangSwitch lang={lang} hrefEs={routePath(route, 'es')} hrefEn={routePath(route, 'en')} />
    </nav>
  </div>
  <div class="header__rule"></div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(8px);
  }

  .header__inner {
    max-width: var(--width-full);
    margin-inline: auto;
    padding: var(--space-2) var(--space-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .header__mark {
    --logo-height: 32px;
    display: flex;
    border-bottom: 0;
  }

  .header__mark:hover {
    color: var(--ink-soft);
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .header__link {
    border-bottom: 0;
    white-space: nowrap;
  }

  .header__link:hover {
    color: var(--ink-soft);
  }

  .header__link--muted {
    color: var(--ink-soft);
    cursor: default;
  }

  .header__rule {
    height: 1px;
    background: var(--rule);
  }

  /* En móvil el Aula Virtual sobra: aún no lleva a ninguna parte. */
  @media (max-width: 36rem) {
    .header__link--muted {
      display: none;
    }

    .header__mark {
      --logo-height: 24px;
    }
  }
</style>
