---
/**
 * Cabecera — una cápsula de cristal flotando sobre la página.
 *
 * Copia el comportamiento del sitio de referencia que pasó Emi: la firma
 * centrada dentro de una cápsula translúcida que, al pulsarla, crece hacia
 * abajo y descubre el menú. Las opciones que antes estaban sueltas a la
 * derecha viven dentro; «Inicio» es la primera, porque la firma dejó de ser
 * enlace y el logo del pie tampoco lo es.
 *
 * **La cabecera ya no es una barra.** No tiene fondo, ni regla, ni filtro
 * propio: es solo un contenedor fijo, transparente y sin capturar el ratón,
 * que coloca la cápsula. El cristal está únicamente en la cápsula. Eso no es
 * estética: la barra tenía su propio `backdrop-filter` y el panel otro dentro,
 * y un `backdrop-filter` anidado dentro de otro es justo lo que repintaba de
 * negro el marco superior. Encima, la barra muestreaba la entrada —un panel
 * negro a pantalla completa, `z-index: 200`— mientras se desvanecía. Sin
 * barra no hay ninguna de las dos cosas.
 *
 * Abre y cierra con animación en los dos sentidos. Eso pide JavaScript: el
 * `<details>` nativo quita su contenido de golpe y no hay salida que animar.
 * El truco es no dejarle cerrar todavía —`preventDefault()`—, animar, y poner
 * `open = false` cuando la transición termina. Por eso el elemento se marca
 * con `data-js` desde el propio script: sin él, el CSS deja el menú abierto en
 * cuanto `<details>` lo está, y todo sigue funcionando sin una línea de
 * script, solo que sin animación.
 */
import { type Lang, type Route, useTranslations, routePath } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';
import Logo from './Logo.astro';
import { entrarHref } from '../data/aula';

interface Props {
  lang: Lang;
  /** Sección actual, para marcar la opción del menú. */
  route?: Route;
  /** Esta misma página en cada idioma, ya localizada. */
  hrefEs: string;
  hrefEn: string;
}
const { lang, route = 'home', hrefEs, hrefEn } = Astro.props;
const t = useTranslations(lang);

/*
  El botón de ingresar sale solo dentro del aula. En la Home y en Sobre mí no
  pinta nada: quien llega ahí viene a leer, no a entrar a estudiar. Y hoy lleva
  fuera del sitio, a la academia, que es donde el aula funciona de verdad.
*/
const enAula = route === 'aula';
const entrar = entrarHref[lang];
---

<header class:list={['header', enAula && 'header--aula']}>
  <details class="menu" data-menu>
    <summary class="menu__trigger" title={t('nav.menu')}>
      {/*
        Hueco. La cápsula es una rejilla de tres columnas con las dos de fuera
        iguales, y esto ocupa la primera: así la firma queda centrada de verdad
        aunque solo haya etiqueta a un lado. */}
      <span aria-hidden="true"></span>

      <Logo name={t('site.name')} />

      {/*
        La firma sola no dice que se abra, y el sistema prohíbe iconos, así que
        la pista es texto. Es lo que en la referencia hacen las etiquetas que
        flanquean el logotipo.
      */}
      <span class="mono menu__hint" aria-hidden="true">
        <span class="menu__hint--open">{t('nav.menu')}</span>
        <span class="menu__hint--close">{t('nav.close')}</span>
      </span>

      {/* El nombre lo pone el logo; esto añade de qué es el tirador. Si abre o
          cierra no hace falta decirlo: `<details>` ya lo anuncia solo. */}
      <span class="visually-hidden">{t('nav.menu')}</span>
    </summary>

    {/*
      Dos capas para poder animar el alto sin saberlo de antemano: la de fuera
      va de `0fr` a `1fr` en una rejilla, la de dentro recorta. Es la única
      forma de llevar un alto automático a cero con transición.
    */}
    <div class="menu__wrap">
      <div class="menu__clip">
        <nav class="menu__nav mono" aria-label={t('site.title')}>
          <a
            class="menu__item"
            href={routePath('home', lang)}
            aria-current={route === 'home' ? 'page' : undefined}>{t('nav.start')}</a
          >
          <a
            class="menu__item"
            href={routePath('about', lang)}
            aria-current={route === 'about' ? 'page' : undefined}>{t('nav.about')}</a
          >
          <a
            class="menu__item"
            href={routePath('aula', lang)}
            aria-current={route === 'aula' ? 'page' : undefined}>{t('nav.aula')}</a
          >
          {/*
            Debajo de 56rem no cabe la cápsula de ingresar al lado de la del
            menú sin que se pisen, así que ahí la opción vive dentro del panel.
            Es la misma puerta por otra puerta, no una segunda cosa.
          */}
          {
            enAula && (
              <a class="menu__item menu__item--enter" href={entrar} rel="noopener">
                {t('nav.enter')}
              </a>
            )
          }
          <div class="menu__item menu__item--lang">
            <LangSwitch lang={lang} hrefEs={hrefEs} hrefEn={hrefEn} />
          </div>
        </nav>
      </div>
    </div>
  </details>

  {
    enAula && (
      <a class="mono enter" href={entrar} rel="noopener">
        {t('nav.enter')}
      </a>
    )
  }
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
  const tirador = menu?.querySelector<HTMLElement>('summary');
  const capa = menu?.querySelector<HTMLElement>('.menu__wrap');

  if (menu && tirador && capa) {
    /*
      Desde acá manda la clase, no el atributo `open`. Marcarlo con script y no
      en el HTML es lo que hace que sin JavaScript el menú siga abriéndose:
      entonces este atributo no existe y el CSS se queda con la regla de
      `[open]`, sin animación pero entero.
    */
    menu.dataset.js = '';

    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)');

    /** Cierra dejando correr la animación; sin ella, de una vez. */
    const cerrar = () => {
      if (!menu.open || !menu.classList.contains('is-open')) return;
      menu.classList.remove('is-open');

      if (quieto.matches) {
        menu.open = false;
        return;
      }
      /*
        `transitionend` puede no llegar (pestaña de fondo): con red de
        seguridad. Y hay que mirar QUÉ terminó: estos eventos burbujean, así
        que el fundido del contenido —0,14 s, más corto que el alto— llegaba
        acá y cerraba de golpe a mitad de la animación.
      */
      let hecho = false;
      const rematar = () => {
        if (hecho) return;
        hecho = true;
        capa.removeEventListener('transitionend', alTerminar);
        menu.open = false;
      };
      const alTerminar = (event: TransitionEvent) => {
        if (event.target !== capa || event.propertyName !== 'grid-template-rows') return;
        rematar();
      };
      capa.addEventListener('transitionend', alTerminar);
      window.setTimeout(rematar, 800);
    };

    const abrir = () => {
      menu.open = true;
      /* Un fotograma de margen: si no, el navegador no ve el cambio y no anima. */
      requestAnimationFrame(() => menu.classList.add('is-open'));
    };

    tirador.addEventListener('click', (event) => {
      event.preventDefault(); /* el estado lo llevamos nosotros */
      if (menu.open) cerrar();
      else abrir();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      cerrar();
      /* El foco vuelve al tirador: si no, se queda en el aire. */
      tirador.focus();
    });

    document.addEventListener('pointerdown', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) cerrar();
    });
  }
</script>

<style>
  /* --- La cabecera: solo coloca -------------------------------------------
     Sin fondo, sin regla y sin filtro. Y sin capturar el ratón, que si no una
     banda invisible de lado a lado se comería los clics de la página. */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: var(--space-2);
    pointer-events: none;
  }

  /* --- La cápsula de cristal ----------------------------------------------
     Acá está todo el efecto, y es lo único que filtra en toda la cabecera.
     El velo lo manda `--menu-veil`: es el mando del contraste, y está en el
     valor más bajo que aguanta AA con el bloque negro del cierre por detrás.
     Cualquier cambio se vuelve a medir con `npm run audit:menu`.

     Sin prefijos `-webkit-` escritos a mano: los pone el minificador. */
  .menu {
    pointer-events: auto;
    width: min(100% - var(--space-2), var(--menu-width));
    border-radius: var(--menu-radius);
    background: color-mix(in srgb, var(--paper) var(--menu-veil), transparent);
    backdrop-filter: blur(var(--menu-blur)) saturate(1.6);
    box-shadow: var(--menu-shadow);
    /* Para que el contenido no se salga por las esquinas redondeadas. */
    overflow: hidden;
  }

  /* Píldora ancha y fina, como la de la referencia: la firma en el centro y la
     etiqueta a un lado. Las dos columnas de fuera miden lo mismo, y por eso la
     firma cae en el centro exacto de la cápsula y no desplazada. */
  .menu__trigger {
    /* Sin el triángulo del desplegable nativo: la firma es el tirador. */
    list-style: none;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    --logo-height: 28px;
  }

  .menu__hint {
    justify-self: end;
    white-space: nowrap;
  }

  .menu__trigger::-webkit-details-marker {
    display: none;
  }

  .menu__trigger:hover {
    color: var(--ink-soft);
  }

  .menu__trigger:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -4px;
  }

  .menu__hint,
  .menu__hint span {
    color: var(--ink-soft-glass);
  }

  /* --- Crecer y encogerse --------------------------------------------------
     `grid-template-rows` de `0fr` a `1fr` es lo que permite animar un alto que
     no se conoce. La capa de dentro recorta mientras tanto.

     Sin JavaScript no hay `data-js`, y entonces manda la primera regla: con
     `<details>` abierto el menú está a la vista, sin animación. */
  .menu__wrap {
    display: grid;
    grid-template-rows: 1fr;
  }

  .menu__clip {
    overflow: hidden;
  }

  .menu[data-js] .menu__wrap {
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--menu-duration) var(--ease-panel);
  }

  .menu[data-js].is-open .menu__wrap {
    grid-template-rows: 1fr;
  }

  /* El contenido entra un pelo después del alto, y se va antes: así no se ve
     el texto apretándose contra el borde mientras la cápsula se cierra. */
  .menu[data-js] .menu__nav {
    opacity: 0;
    transition: opacity 0.14s ease;
  }

  .menu[data-js].is-open .menu__nav {
    opacity: 1;
    transition-duration: 0.2s;
    transition-delay: 0.08s;
  }

  /* La palabra del tirador. Sin JavaScript la manda `[open]`; con él, la clase,
     para que cambie a la vez que la animación y no antes. */
  .menu__hint--close {
    display: none;
  }

  .menu[open] .menu__hint--open {
    display: none;
  }

  .menu[open] .menu__hint--close {
    display: inline;
  }

  .menu[data-js][open] .menu__hint--open {
    display: inline;
  }

  .menu[data-js][open] .menu__hint--close {
    display: none;
  }

  .menu[data-js].is-open .menu__hint--open {
    display: none;
  }

  .menu[data-js].is-open .menu__hint--close {
    display: inline;
  }

  /* --- Las opciones --------------------------------------------------------
     Todas en tinta plena. La página actual se marca con un fondo apenas
     insinuado, no aclarando el texto: sobre cristal, aclarar es justo lo que
     tira el contraste al suelo. */
  .menu__nav {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--rule);
  }

  .menu__item {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    text-align: center;
  }

  .menu__item:last-child {
    border-bottom: 0;
  }

  a.menu__item:hover {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  a.menu__item[aria-current='page'] {
    background: color-mix(in srgb, var(--ink) 4%, transparent);
  }

  .menu__item--lang {
    display: flex;
    justify-content: center;
    /* La tinta secundaria del conmutador se sube: sobre cristal, la de siempre
       no llega a AA. `LangSwitch` lee esta variable y si no está usa la suya. */
    --lang-soft: var(--ink-soft-glass);
  }

  /* --- La puerta del aula --------------------------------------------------
     Segunda cápsula, a la derecha, con el mismo cristal que la del menú: es un
     objeto flotante de la misma familia, así que hereda la enmienda del radio
     y de la sombra y no abre ninguna nueva. Va posicionada y no como hermana
     en el flujo, porque la del menú tiene que quedarse centrada en la página,
     no centrada en lo que sobre.

     Solo aparece en el aula. La cabecera no captura el ratón, así que esta
     recupera el suyo, igual que hace la cápsula del menú. */
  .enter {
    position: absolute;
    right: var(--space-2);
    top: var(--space-2);
    pointer-events: auto;
    display: none;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--menu-radius);
    border-bottom: 0;
    background: color-mix(in srgb, var(--paper) var(--menu-veil), transparent);
    backdrop-filter: blur(var(--menu-blur)) saturate(1.6);
    box-shadow: var(--menu-shadow);
    color: var(--ink);
    /* Que mida lo mismo de alto que la cápsula del menú: 28 px de firma más
       los 16 de arriba y abajo. La línea del mono es más corta, así que se
       fuerza el alto de la caja. */
    line-height: 28px;
  }

  .enter:hover {
    color: var(--ink-soft-glass);
  }

  /* El corte está medido, no elegido a ojo. La cápsula del menú mide 384 px y
     va centrada en la ventana, así que su borde derecho avanza a la mitad de
     lo que crece la pantalla, mientras que esta está clavada al margen: las
     dos se acercan hasta pisarse. Medido con las dos etiquetas —la inglesa,
     ENTER THE CLASSROOM, es la larga—, a 832 px todavía se solapaban 4 px y a
     864 quedaban 12. A 56 rem hay 28 px de aire en inglés y 54 en español.

     Por debajo, la puerta se va dentro del panel, que es donde está su gemela
     `menu__item--enter`. Si algún día cambia el texto del botón o el ancho de
     la cápsula, este número se vuelve a medir. */
  @media (min-width: 56rem) {
    .enter {
      display: block;
    }

    .header--aula .menu__item--enter {
      display: none;
    }
  }

  /* Dentro del panel es la última opción antes del idioma, y es la única en
     negativo: es el final del recorrido, igual que el botón de comprar. */
  .menu__item--enter {
    background: var(--ink);
    color: var(--paper);
  }

  a.menu__item--enter:hover {
    background: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu[data-js] .menu__wrap,
    .menu[data-js] .menu__nav {
      transition: none;
    }
  }

  @media (max-width: 36rem) {
    .menu__trigger {
      --logo-height: 24px;
    }
  }
</style>
