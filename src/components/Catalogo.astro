---
/**
 * El catálogo de Productos — la portada de la tienda.
 *
 * Vive **afuera del aula y no pide nada**: es lo que ve quien todavía no ha
 * pagado. El aula, que es lo que se compra, quedó del otro lado del inicio de
 * sesión. Por eso el único enlace de esta página hacia
 * dentro es la línea de «¿ya compraste?», que es un atajo para quien vuelve,
 * no una puerta abierta.
 *
 * Cada producto lleva su foto arriba, el nombre, una línea de qué es y su
 * estado. La forma es la que pidió Emi con el sitio viejo delante: una rejilla
 * de tres columnas, imagen, título y texto. La llamada de debajo —«Ver la
 * membresía»— salió el 23 sep 2026: pinchar la foto ya es lo intuitivo, y
 * menos opciones es más.
 *
 * Lo que **no** se copia de esa referencia es la ropa: allí las fichas son
 * cajas negras con esquinas redondeadas y botones de píldora, y acá el sistema
 * dice radios cero y sombras cero. Así que la ficha no es una caja: es una
 * columna con su foto enmarcada por una regla de 1 px, igual que los huecos de
 * imagen del resto del sitio. Las fotos van en blanco y negro, como la lámina
 * de la Home — de eso se encarga `MediaSlot`.
 *
 * Las fichas que tienen página son enlaces: las de lo que está a la venta y,
 * desde el 23 sep 2026, las de los cursos que todavía no se venden pero ya
 * tienen su carta escrita (`tienePagina`). Las de lo que está por llegar y no
 * tiene carta **no lo son**, y se ven apagadas.
 */
import { type Lang, useTranslations, productPath } from '../i18n/ui';
import { entrarHref } from '../data/aula';
import type { Ficha as FichaTienda } from '../lib/tienda';
import MediaSlot from './MediaSlot.astro';

interface Props {
  lang: Lang;
  /**
   * Las fichas, ya leídas —de la base de datos o del código— por la página.
   * Desde el 23 sep 2026 las maneja Emi desde la pestaña Tienda del panel.
   */
  fichas: FichaTienda[];
}
const { lang, fichas } = Astro.props;
const t = useTranslations(lang);
---

{/*
  La entrada comparte el ancho de la rejilla, no el de la columna de lectura:
  si no, el titular arrancaría a media pantalla de la primera foto y se vería
  la costura entre dos anchos distintos.

  Hasta el 23 sep 2026 llevaba encima el numeral `00`. Salió a pedido de
  Adrián —«no pinta nada»—, lo mismo que los de la Home y *Sobre mí* el 21 sep.
  Los números de las fichas se quedan: esos sí ordenan algo.
*/}
<section class="tienda__wrap tienda__head">
  {/* La entrada (24 sep 2026): el titular y sus renglones suben en escalera al
      cargar, como en *Sobre mí*. Hasta ese día la cabecera llevaba el
      revelado del scroll, que al estar ya en pantalla se leía como nada. */}
  <h1 class="tienda__title entrada" style="--i:0">{t('products.heading')}</h1>
  <p class="tienda__lead entrada" style="--i:1">{t('products.lead')}</p>
  <p class="tienda__lead tienda__lead--close entrada" style="--i:2">{t('products.close')}</p>
  <a class="mono tienda__in entrada" style="--i:3" href={entrarHref[lang]}>{t('products.enrolled')}</a>
</section>

<section class="tienda__wrap block">
  <ul class="cat" role="list">
    {
      fichas.map((producto) => {
        const copia = producto.copia[lang];
        const venta = producto.estado === 'venta';
        const pagina = producto.conPagina;
        const Ficha = pagina ? 'a' : 'div';
        return (
          <li class:list={['cat__item', 'reveal', !pagina && 'is-soon']}>
            <Ficha
              class="cat__link"
              href={pagina ? productPath(producto.slug, lang) : undefined}
              aria-disabled={pagina ? undefined : 'true'}
            >
              <span class="cat__media">
                <MediaSlot
                  src={producto.foto}
                  alt={copia.fotoAlt ?? ''}
                  placeholder={copia.fotoPie}
                  ratio="3 / 2"
                  width={520}
                />
              </span>

              <span class="cat__meta mono">
                <span class="cat__num" aria-hidden="true">{producto.num}</span>
                {
                  venta ? (
                    <span class="cat__price">
                      {copia.precio} <span class="soft">{copia.cadencia}</span>
                    </span>
                  ) : (
                    <span class="soft">
                      {producto.estado === 'cerrado' ? t('products.closed') : t('products.soon')}
                    </span>
                  )
                }
              </span>

              <span class="cat__name">{copia.nombre}</span>
              <span class="cat__sum">{copia.resumen}</span>
            </Ficha>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  /* El hueco que dejó el `00`: su renglón, 17 px, redondeado a la rejilla.
     Sumado al margen del titular son 40 px, así que el titular se queda
     donde estaba y no sube a pegarse a la píldora del menú. */
  .tienda__head {
    padding-top: var(--space-2);
  }

  .tienda__title {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-hero);
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-hero);
  }

  .tienda__lead {
    margin-top: var(--space-3);
    max-width: var(--measure);
    text-wrap: pretty;
  }

  /* El remate de la entrada va pegado al párrafo, no a un bloque de
     distancia: es la misma idea dicha en corto. */
  .tienda__lead--close {
    margin-top: var(--space-2);
  }

  /* El atajo de quien ya pagó. Va acá arriba y no abajo del todo: quien vuelve
     a comprar entra por esta página, y hacerle bajar siete fichas para
     encontrar la puerta es hacerle buscar lo que ya tiene. */
  .tienda__in {
    display: inline-block;
    margin-top: var(--space-3);
    border-bottom: 1px solid var(--ink-soft);
  }

  .tienda__in:hover {
    border-bottom-color: currentColor;
  }

  /* --- La rejilla ----------------------------------------------------------
     Tres columnas donde caben, dos en tableta, una en el teléfono. El hueco es
     de 48 px, que está en la rejilla de 8. */
  .tienda__wrap {
    max-width: var(--width-full);
    margin-inline: auto;
    padding-inline: var(--space-3);
  }

  .cat {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8) var(--space-6);
  }

  @media (max-width: 62rem) {
    .cat {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 38rem) {
    .cat {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  /* La ficha entera es la zona pulsable, no solo el nombre. Sin borde inferior:
     el subrayado de los enlaces del sitio no tiene sentido en una columna. */
  .cat__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-bottom: 0;
    color: inherit;
  }

  .cat__media {
    display: block;
  }

  /* La línea de datos, entre la foto y el nombre: el número al margen y el
     precio o el estado al otro lado. */
  .cat__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--rule);
  }

  .cat__num {
    color: var(--ink-soft);
  }

  .cat__price {
    white-space: nowrap;
  }

  .cat__name {
    display: block;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-section);
    line-height: var(--leading-section);
    letter-spacing: var(--tracking-section);
  }

  .cat__sum {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-small);
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* --- Lo que todavía no está ---------------------------------------------
     Apagado y sin enlace. Se dice que llega, no se finge que existe. */
  .is-soon .cat__name,
  .is-soon .cat__sum {
    color: var(--ink-soft);
  }

  .is-soon .cat__link {
    cursor: default;
  }

  /* --- La foto al pasar por encima -----------------------------------------
     Toma color y se acerca un poco, **dentro de su marco**. Lo pidió Adrián el
     23 sep 2026, «como en el *Sobre mí*»: el mismo color, la misma curva y el
     mismo medio segundo que el retrato de allí. Lo que cambia es el gesto. El
     retrato se levanta 8 px; acá la foto se acerca y el marco no se mueve,
     porque una ficha entera que se levanta es una tarjeta, y el sistema las
     prohíbe.

     Cuatro centésimas, y recortado por el marco: la regla de 1 px no se mueve
     y la foto no se sale de ella. `clip` y no `hidden`, por lo mismo que en la
     lámina de la Home: recorta sin crear un contenedor de scroll.

     Lo dispara la ficha entera, no solo la foto, porque en las que son enlace
     la zona pulsable es la ficha entera. **Y va en todas las fichas, también
     en las que están por llegar.** Hasta el 23 sep 2026 era solo en los
     enlaces, para no prometer un clic que no lleva a ningún sitio; ese día
     llegaron las fotos de los tres cursos, que están por llegar, y la regla
     dejaba quietas tres de cuatro fotos. En esas la flecha sigue siendo la
     de siempre —`cursor: default`— y no hay subrayado que invite a pulsar: la
     foto responde, la ficha no promete nada.

     Con el teclado, el mismo color y el mismo acercamiento al enfocar la
     ficha. El resto, como en *Sobre mí*: solo con cursor de verdad —en una
     pantalla táctil el `:hover` se queda pegado— y sin movimiento para quien
     lo pide, que se queda con el color. `:global` porque el marco y la imagen
     son de `MediaSlot`. */
  .cat__media :global(.slot) {
    overflow: clip;
  }

  .cat__media :global(.slot__img) {
    transition:
      filter 0.5s var(--ease-reveal),
      transform 0.5s var(--ease-reveal);
  }

  a.cat__link:focus-visible :global(.slot__img) {
    filter: grayscale(0);
    transform: scale(1.04);
  }

  @media (hover: hover) {
    .cat__link:hover :global(.slot__img) {
      filter: grayscale(0);
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cat__link:hover :global(.slot__img),
    a.cat__link:focus-visible :global(.slot__img) {
      transform: none;
    }
  }
</style>
