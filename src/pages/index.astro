---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import { metaPaginas } from '../data/seo';

const lang = 'es' as const;
---

<Base
  lang={lang}
  title={metaPaginas[lang].home.title}
  description={metaPaginas[lang].home.description}
  intro
  backdrop
  entrada={false}
  ogImagen
>
  <Home lang={lang} />
</Base>
