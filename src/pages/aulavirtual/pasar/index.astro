---
/**
 * El puente de traspaso, en español. Aterriza acá la sesión que trae la
 * alumna desde `emilseriosacademy.com/pasar/`.
 *
 * Va en su propia carpeta y no como `pasar.astro` porque la ruta tiene que
 * terminar en barra: es una de las Redirect URLs de Supabase, y ahí la
 * dirección se escribe exacta.
 */
import Acceso from '../../../layouts/Acceso.astro';
import Pasar from '../../../components/acceso/Pasar.astro';
import { useAula, pasarPath } from '../../../i18n/aula';

const lang = 'es' as const;
const a = useAula(lang);
---

<Acceso
  lang={lang}
  title={a('pass.bridgeTitle')}
  pathEs={pasarPath('es')}
  pathEn={pasarPath('en')}
>
  <Pasar lang={lang} />
</Acceso>
