---
/** Poner la contraseña, en español. Destino del enlace del correo. */
import Acceso from '../../layouts/Acceso.astro';
import NuevaClave from '../../components/acceso/NuevaClave.astro';
import { useAula, clavePath } from '../../i18n/aula';

const lang = 'es' as const;
const a = useAula(lang);
---

<Acceso lang={lang} title={a('pass.title')} pathEs={clavePath('es')} pathEn={clavePath('en')}>
  <NuevaClave lang={lang} />
</Acceso>
