---
/**
 * El aula de la membresía, en español. Hasta el 27 sep 2026 vivía en
 * `emilseriosacademy.com/aula/`, que redirige acá. Ver `Membresia.astro`.
 */
import AulaLayout from '../../layouts/Aula.astro';
import Membresia from '../../components/aula/Membresia.astro';
import { useAula, membresiaPath } from '../../i18n/aula';

const lang = 'es' as const;
const a = useAula(lang);
---

<AulaLayout
  lang={lang}
  title={a('memb.title')}
  seccion="membresia"
  pathEs={membresiaPath('es')}
  pathEn={membresiaPath('en')}
  migaja={a('memb.title')}
>
  <Membresia lang={lang} />
</AulaLayout>
