---
/**
 * El reproductor de un curso, en español.
 *
 * Hay **una página por curso, no una por clase**: dentro se cambia de clase con
 * el `#hash`, sin recargar. Ver el porqué en `src/components/aula/Curso.astro`.
 *
 * Se genera una por cada curso del catálogo de Formaciones. **El contenido no
 * va en la página**: llega por consulta a Supabase, con la RLS decidiendo. Un
 * curso que Emi cree en el panel con un slug que el catálogo todavía no tiene
 * se abre en `/aulavirtual/curso/?c=<slug>` (`curso/index.astro`).
 */
import AulaLayout from '../../../layouts/Aula.astro';
import Curso from '../../../components/aula/Curso.astro';
import { catalogo } from '../../../data/aula';
import { cursoPath } from '../../../i18n/aula';

export function getStaticPaths() {
  return catalogo
    .filter((p) => p.tipo === 'curso')
    .map((p) => ({ params: { curso: p.slug }, props: { producto: p } }));
}

const lang = 'es' as const;
const { curso } = Astro.params;
const { producto } = Astro.props;
---

<AulaLayout
  lang={lang}
  title={producto.copia[lang].nombre}
  seccion="curso"
  migaja={producto.copia[lang].nombre}
  pathEs={cursoPath(curso!, 'es')}
  pathEn={cursoPath(curso!, 'en')}
>
  <Curso lang={lang} slug={curso!} />
</AulaLayout>
