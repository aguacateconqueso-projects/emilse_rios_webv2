---
/**
 * Las páginas de ventas, en inglés: la membresía y los cursos.
 *
 * **Se resuelven en el servidor desde el 23 sep 2026** (`prerender = false`),
 * con un minuto de caché en Vercel: Emi publica desde el panel (Págs. de
 * ventas, y la ficha en Tienda) y al minuto está en la web, sin desplegar.
 * Si la base de datos no tiene esa página, sale la de `src/data/cartas.ts`;
 * si no hay ninguna, o la ficha está en borrador, 404. Ver `src/lib/tienda.ts`.
 *
 * Con la cortina bajada, `src/middleware.ts` la tapa igual que al resto.
 */
import PaginaVenta from '../../../components/PaginaVenta.astro';
import { leerPagina, CACHE_TIENDA } from '../../../lib/tienda';
import { paginaDeVenta } from '../../../i18n/ui';

export const prerender = false;

const lang = 'en' as const;
/* La membresía tiene dirección propia desde el 1 oct 2026: su dirección de
   antes, con el slug, lleva a la nueva. Ver `direccionesPropias`. */
const pide = paginaDeVenta(Astro.url, Astro.params.producto ?? '', lang)!;
if ('redirigir' in pide) return Astro.redirect(pide.redirigir, 301);
const pagina = await leerPagina(pide.slug);
if (!pagina) return new Response(null, { status: 404 });
Astro.response.headers.set('Cache-Control', CACHE_TIENDA);
---

<PaginaVenta lang={lang} producto={pagina.ficha} c={pagina.carta[lang]} />
