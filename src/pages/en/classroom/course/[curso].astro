---
/**
 * El reproductor de un curso, en inglés. Gemelo de
 * `/aulavirtual/curso/[curso].astro`.
 *
 * **El slug del curso no se traduce** —`todo-el-diapason` es `todo-el-diapason` en los dos
 * idiomas—, igual que en la tienda: el slug es la identidad del curso, la misma
 * que lleva su fila en la base de datos y la que Emi pega en un correo. Lo
 * que se traduce es el segmento de la sección: `/curso/` ↔ `/course/`.
 */
import AulaLayout from '../../../../layouts/Aula.astro';
import Curso from '../../../../components/aula/Curso.astro';
import { catalogo } from '../../../../data/aula';
import { cursoPath } from '../../../../i18n/aula';

export function getStaticPaths() {
  return catalogo
    .filter((p) => p.tipo === 'curso')
    .map((p) => ({ params: { curso: p.slug }, props: { producto: p } }));
}

const lang = 'en' as const;
const { curso } = Astro.params;
const { producto } = Astro.props;
---

<AulaLayout
  lang={lang}
  title={producto.copia[lang].nombre}
  seccion="curso"
  migaja={producto.copia[lang].nombre}
  pathEs={cursoPath(curso!, 'es')}
  pathEn={cursoPath(curso!, 'en')}
>
  <Curso lang={lang} slug={curso!} />
</AulaLayout>
