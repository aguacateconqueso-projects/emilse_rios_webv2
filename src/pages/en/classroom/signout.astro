---
/**
 * Sign out: ends the session and returns to the door.
 *
 * Es una página y no un botón porque cerrar sesión es una operación asíncrona
 * —hay que limpiar los dos almacenes y avisar a Supabase— y desde una pantalla
 * cualquiera no hay dónde enseñar el «un momento». Acá sí.
 */
import Acceso from '../../../layouts/Acceso.astro';
import { useAula, salirPath, puertaPath } from '../../../i18n/aula';

const lang = 'en' as const;
const a = useAula(lang);
---

<Acceso lang={lang} title={a('app.leave')} pathEs={salirPath('es')} pathEn={salirPath('en')}>
  <section class="salida" data-salir data-destino={puertaPath(lang)}>
    <p class="eyebrow">{a('app.leave')}</p>
    <h1 class="puerta__h">{a('signin.leaving')}</h1>
    <p class="puerta__lead">{a('gate.wait')}</p>
    <noscript>
      <p><a href={puertaPath(lang)}>{a('app.title')}</a></p>
    </noscript>
  </section>
</Acceso>

<script>
  import { supabase, isSupabaseConfigured } from '../../../lib/supabase';

  const caja = document.querySelector('[data-salir]');
  const destino = caja?.getAttribute('data-destino') || '/';

  (async () => {
    // `signOut` limpia los dos almacenes a través del adaptador de `supabase.ts`
    // —la sesión pudo nacer en cualquiera de ellos según la casilla—. Si falla,
    // igual se sale: quedarse en esta pantalla no le sirve a nadie.
    try {
      if (isSupabaseConfigured) await supabase.auth.signOut();
    } catch {
      /* sin red, sesión ya caducada… */
    }
    location.replace(destino);
  })();
</script>
