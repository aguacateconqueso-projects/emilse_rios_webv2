---
/**
 * Las páginas de ventas, en inglés: la membresía y los cursos.
 *
 * **Todas bajo `/en/programs/` y con su slug en inglés desde el 9 oct 2026**
 * (pedido de Emi): `/en/programs/fingerboard/`, `/en/programs/
 * double-bass-membership/`… Lo decide `slugsIngles` en `src/i18n/ui.ts`.
 * Pedida con el slug español —`/en/programs/todo-el-diapason/`—, la página
 * manda a la inglesa con un 301. Hasta ese día los cursos vivían en
 * `/en/courses/<slug-español>/`, y esas direcciones las redirige
 * `astro.config.mjs`.
 *
 * **Se resuelve en el servidor desde el 23 sep 2026** (`prerender = false`),
 * con un minuto de caché en Vercel: Emi publica desde el panel y al minuto
 * está en la web. Si la base de datos no tiene esa página, sale la de
 * `src/data/cartas.ts`; si no hay ninguna, o la ficha está en borrador, 404.
 * Ver `src/lib/tienda.ts`.
 */
import PaginaVenta from '../../../components/PaginaVenta.astro';
import { leerPagina, CACHE_TIENDA } from '../../../lib/tienda';
import { paginaDeVenta } from '../../../i18n/ui';

export const prerender = false;

const lang = 'en' as const;
const pide = paginaDeVenta(Astro.url, Astro.params.producto ?? '', lang);
if ('redirigir' in pide) return Astro.redirect(pide.redirigir, 301);
const pagina = await leerPagina(pide.slug);
if (!pagina) return new Response(null, { status: 404 });
Astro.response.headers.set('Cache-Control', CACHE_TIENDA);
---

<PaginaVenta lang={lang} producto={pagina.ficha} c={pagina.carta[lang]} />
