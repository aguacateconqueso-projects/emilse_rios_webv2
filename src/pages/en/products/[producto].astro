---
/**
 * La carta de venta de cada producto, en inglés.
 *
 * Gemela de `/productos/[producto].astro`: mismos productos, mismos slugs
 * —el slug es la identidad del producto y no se traduce—, y la copia sale del
 * mismo fichero de datos. Lo único que cambia es el idioma — incluida la nota
 * de por qué la membresía no pasa por acá.
 */
import Base from '../../../layouts/Base.astro';
import Producto from '../../../components/Producto.astro';
import { useTranslations, productPath } from '../../../i18n/ui';
import { conPagina, type Product } from '../../../data/aula';

export function getStaticPaths() {
  return conPagina()
    .filter((producto) => !producto.cartaPropia)
    .map((producto) => ({
      params: { producto: producto.slug },
      props: { producto },
    }));
}

interface Props {
  producto: Product;
}
const { producto } = Astro.props;
const lang = 'en' as const;
const t = useTranslations(lang);
const copia = producto.copia[lang];
---

<Base
  lang={lang}
  title={`${copia.nombre} · ${t('products.title')}`}
  description={copia.resumen}
  route="products"
  pathEs={productPath(producto.slug, 'es')}
  pathEn={productPath(producto.slug, 'en')}
>
  <Producto lang={lang} producto={producto} />
</Base>
