---
import Base from '../../layouts/Base.astro';
import About from '../../components/About.astro';
import { metaPaginas } from '../../data/seo';

const lang = 'en' as const;
---

<Base
  lang={lang}
  title={metaPaginas[lang].about.title}
  description={metaPaginas[lang].about.description}
  route="about"
  entrada={false}
  ogImagen
>
  <About lang={lang} />
</Base>
