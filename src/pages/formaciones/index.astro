---
/**
 * Formaciones, en español: el catálogo.
 *
 * **Se resuelve en el servidor desde el 23 sep 2026**, con un minuto de caché:
 * las fichas las maneja Emi desde la pestaña Tienda del panel. Mientras la
 * tienda de la base de datos esté vacía, o si no contesta, salen las del
 * código (`src/data/aula.ts`). Ver `src/lib/tienda.ts`.
 */
import Base from '../../layouts/Base.astro';
import Catalogo from '../../components/Catalogo.astro';
import { metaPaginas } from '../../data/seo';
import { leerCatalogo, CACHE_TIENDA } from '../../lib/tienda';

export const prerender = false;

const lang = 'es' as const;
const { fichas } = await leerCatalogo();
Astro.response.headers.set('Cache-Control', CACHE_TIENDA);
---

<Base
  lang={lang}
  title={metaPaginas[lang].products.title}
  description={metaPaginas[lang].products.description}
  route="products"
  entrada={false}
  ogImagen
>
  <Catalogo lang={lang} fichas={fichas.filter((f) => f.estado !== 'borrador')} />
</Base>
