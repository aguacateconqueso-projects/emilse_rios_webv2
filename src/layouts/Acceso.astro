---
/**
 * El marco de las pantallas de la puerta: entrar, poner la contraseña, salir,
 * el puente desde la academia y `/gracias/`.
 *
 * **Desde el 23 sep 2026 va dentro de `Base.astro`**, con el menú, el pie, la
 * letra y el papel del resto del sitio —«pásalo al estilo nuevo de la web,
 * todo»—. Hasta ese día llevaba la ropa de la academia (crema, Hanken
 * Grotesk) y una copia suelta de la cápsula del menú (`CabeceraSuelta.astro`,
 * que se borró con esto: ya no hace falta, esta página carga el sitio entero).
 *
 * **No lleva la barra del aula**, y es a propósito: esa barra ofrece «Mi
 * escritorio» y «Salir», y todavía no se sabe quién es esta persona. Una barra
 * que promete lo que al pulsarlo rebota no ayuda.
 *
 * Va con `noindex`: un formulario de acceso no tiene nada que hacer en un
 * buscador.
 */
import Base from './Base.astro';
import type { Lang } from '../i18n/ui';
import { useAula } from '../i18n/aula';
import '../styles/app.css';

interface Props {
  lang: Lang;
  title: string;
  /** La dirección de ESTA pantalla en cada idioma, para el conmutador. */
  pathEs: string;
  pathEn: string;
}

const { lang, title, pathEs, pathEn } = Astro.props;
const a = useAula(lang);
---

<Base
  lang={lang}
  title={`${title} · ${a('app.title')}`}
  description={a('app.title')}
  route="aula"
  pathEs={pathEs}
  pathEn={pathEn}
  noindex
>
  <div class="puerta app-wrap app-wrap--text">
    <slot />
  </div>
</Base>

<style>
  /* La columna de lectura del sitio, con aire arriba: la cápsula del menú ya
     está en el `padding` del `<main>` de `Base.astro`. */
  .puerta {
    padding-top: var(--space-6);
  }

  /* Las piezas que comparten las cinco pantallas. Viven acá y no en cada una
     porque son de este marco: el titular, la entradilla y el aviso. */
  .puerta :global(.puerta__h) {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-anchor);
    line-height: var(--leading-anchor);
    letter-spacing: var(--tracking-section);
    text-wrap: balance;
  }

  .puerta :global(.puerta__lead) {
    margin: var(--space-2) 0 var(--space-4);
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .puerta :global(.aviso) {
    margin-bottom: var(--space-4);
  }
</style>
