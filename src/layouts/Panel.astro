---
/**
 * El documento de la consola de Emi.
 *
 * **Desde el 23 sep 2026 lleva la ropa del sitio** —papel, tinta, Instrument
 * Serif, Newsreader, IBM Plex Mono y el botón de las notas—, igual que el aula.
 * Hasta ese día llevaba la de la academia (crema, Hanken Grotesk).
 *
 * **No usa `Base.astro`, y es a propósito.** `Base.astro` pone la cápsula del
 * menú del sitio y el pie, que existen para que quien llega de fuera se quede y
 * navegue. El panel es una herramienta: su barra es de pestañas, y una cápsula
 * flotando encima de una tabla estorba. Lo que sí comparte con el sitio es
 * todo lo demás: tokens, primitivas, tipografías y el script de los botones.
 *
 * `noindex`, obviamente.
 */
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/app.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Emilse Ríos</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/botones';
    </script>
  </body>
</html>
