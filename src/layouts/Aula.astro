---
/**
 * El marco del Aula Virtual — lo que rodea al escritorio y a los cursos.
 *
 * **Desde el 23 sep 2026 va dentro de `Base.astro`**, con el menú de cápsula,
 * el pie, la letra y el papel de todo el sitio. Lo pidió Adrián —«pásalo al
 * estilo nuevo de la web, todo»— cuando las cartas ya se habían pasado. Hasta
 * ese día el aula era un documento aparte con la ropa de la academia (crema,
 * Hanken Grotesk, su propia barra), y la costura se notaba al entrar desde
 * Formaciones.
 *
 * Lo que pone este marco y ninguna pantalla repite:
 *   · `noindex` — esto está detrás de una sesión
 *   · la barra del aula: dónde estás y a dónde puedes ir (escritorio,
 *     membresía, Formaciones, el panel si eres Emi, salir)
 *   · el portón, que tapa la pantalla mientras se pregunta quién entra
 *   · el aviso de maqueta cuando no hay base de datos
 */
import Base from './Base.astro';
import Boton from '../components/Boton.astro';
import { type Lang, routePath, productPath, useTranslations } from '../i18n/ui';
import { useAula, escritorioPath, entrarPath, salirPath, panelPath } from '../i18n/aula';
import { isSupabaseConfigured } from '../lib/supabase';
import { ACADEMIA } from '../data/aula';
import '../styles/app.css';

interface Props {
  lang: Lang;
  /** Título del documento, sin el sufijo del aula. */
  title: string;
  /** Marca la opción activa de la barra. */
  seccion?: 'escritorio' | 'curso';
  /** La dirección de ESTA pantalla en cada idioma, para el conmutador. */
  pathEs: string;
  pathEn: string;
  /** Dónde estás, después de «Aula Virtual» (el nombre del curso). */
  migaja?: string;
}

const { lang, title, seccion = 'escritorio', pathEs, pathEn, migaja } = Astro.props;
const a = useAula(lang);
const t = useTranslations(lang);

/**
 * La membresía sigue viviendo en `emilseriosacademy.com`, con miembros reales
 * dentro, y se muda la última, con el cambio de dominio. Mientras tanto el
 * enlace sale del sitio y lo dice con su flecha.
 */
const membresiaHref = `${ACADEMIA}/aula/`;
const salirHref = salirPath(lang);
---

<Base
  lang={lang}
  title={`${title} · ${a('app.title')}`}
  description={a('app.title')}
  route="aula"
  pathEs={pathEs}
  pathEn={pathEn}
  noindex
>
  <div
    class="aula"
    data-aula
    data-gate-needed={a('gate.needed')}
    data-gate-needed-lead={a('gate.neededLead')}
    data-gate-nosub={a('gate.noSub')}
    data-gate-nosub-lead={a('gate.noSubLead')}
  >
    {/*
      El portón. Nace visible cuando hay base de datos y se quita al confirmar
      el acceso, no al revés: así nadie ve el aula un instante antes de que le
      digan que no puede.

      ⚠️ **No es la seguridad, es la puerta de la casa.** Desde el 23 sep 2026
      el contenido de los cursos no va escrito en el HTML: llega por consulta,
      y la base de datos solo se lo da a quien lo tiene. Forzar este portón
      desde la consola enseña un escritorio vacío.
    */}
    <div class="porton" data-porton hidden={!isSupabaseConfigured}>
      <div class="porton__caja">
        <img class="porton__logo" src="/logo.svg" alt="Emilse Ríos" width="1631" height="487" />
        <p class="eyebrow">{a('app.title')}</p>
        <h1 class="porton__h" data-porton-h>{a('gate.checking')}</h1>
        <p class="porton__p" data-porton-p>{a('gate.wait')}</p>

        {/* Para quien no ha iniciado sesión. */}
        <div class="porton__actos" data-porton-actos hidden>
          <Boton class="boton--solid" href={entrarPath(lang)}>{a('gate.signin')}</Boton>
          <Boton href={routePath('products', lang)}>{t('nav.products')}</Boton>
        </div>

        {/*
          Para quien SÍ tiene sesión pero nada a su nombre. Botones distintos
          porque el problema es otro: «iniciar sesión» no arregla nada —ya está
          dentro de su cuenta— y lo que necesita es ponerse al día o darse
          cuenta de que entró con la cuenta equivocada.
        */}
        <div class="porton__actos" data-porton-actos-sub hidden>
          <Boton class="boton--solid" href={productPath('estudiemos-juntos', lang)}>
            {a('gate.seeMembership')}
          </Boton>
          <Boton href={salirHref}>{a('gate.otherAccount')}</Boton>
        </div>
      </div>
    </div>

    <nav class="aula-bar app-wrap" aria-label={a('app.menu')}>
      <p class="aula-bar__donde eyebrow">
        <a href={escritorioPath(lang)}>{a('app.title')}</a>
        {
          migaja && (
            <>
              <span aria-hidden="true"> / </span>
              <span class="aula-bar__migaja">{migaja}</span>
            </>
          )
        }
      </p>

      <ul class="aula-bar__nav" role="list">
        <li>
          <a
            class="mono"
            href={escritorioPath(lang)}
            aria-current={seccion === 'escritorio' ? 'page' : undefined}>{a('app.desk')}</a
          >
        </li>
        <li>
          <a class="mono" href={membresiaHref} rel="noopener"
            >{a('app.membership')}<span aria-hidden="true"> ↗</span></a
          >
        </li>
        <li>
          <a class="mono" href={routePath('products', lang)}>{t('nav.products')}</a>
        </li>
        {/*
          El enlace que Emi ya conoce de la academia. Nace OCULTO y lo enseña el
          script solo si el perfil dice `admin`: al revés, una alumna vería
          parpadear un enlace al panel cada vez que entra.
        */}
        <li data-admin hidden>
          <a class="mono" href={panelPath()}>{a('panel.back')}</a>
        </li>
        <li>
          <a class="mono" href={salirHref}>{a('app.leave')}</a>
        </li>
      </ul>
    </nav>

    {
      !isSupabaseConfigured && (
        <div class="app-wrap aula__maqueta">
          <p class="aviso">
            <b>{a('demo.badge')}</b> — {a('demo.lead')}
          </p>
        </div>
      )
    }

    <slot />
  </div>
</Base>

<script>
  import { isSupabaseConfigured } from '../lib/supabase';
  import { acceso, puedePasar } from '../lib/aula-acceso';

  const caja = document.querySelector<HTMLElement>('[data-aula]');

  if (caja && isSupabaseConfigured) {
    const porton = caja.querySelector<HTMLElement>('[data-porton]')!;

    /** Deja el portón puesto con un mensaje y su juego de botones. */
    const cerrar = (titulo: string, texto: string, actos: string) => {
      porton.querySelector<HTMLElement>('[data-porton-h]')!.textContent = titulo;
      porton.querySelector<HTMLElement>('[data-porton-p]')!.textContent = texto;
      porton.querySelector<HTMLElement>(actos)!.hidden = false;
    };

    acceso()
      .then((a) => {
        if (!a.sesion) {
          cerrar(caja.dataset.gateNeeded!, caja.dataset.gateNeededLead!, '[data-porton-actos]');
          return;
        }
        if (!puedePasar(a)) {
          cerrar(caja.dataset.gateNosub!, caja.dataset.gateNosubLead!, '[data-porton-actos-sub]');
          return;
        }
        porton.hidden = true;
        /* El enlace de vuelta al panel: solo para Emi, y después de
           preguntarle a la base de datos, nunca antes. */
        if (a.admin) {
          caja.querySelectorAll<HTMLElement>('[data-admin]').forEach((el) => (el.hidden = false));
        }
      })
      .catch((e) => {
        /* Sin red o sin Supabase: se abre. Lo de dentro llega por consulta y,
           si la consulta tampoco puede, la pantalla lo dice. */
        console.error('[aula] no se pudo comprobar el acceso', e);
        porton.hidden = true;
      });
  }
</script>

<style>
  /* --- La barra del aula -----------------------------------------------------
     No flota: la cápsula del menú ya flota arriba, y dos cosas fijas se pisan.
     Es una fila con su regla debajo, como la línea de datos de las fichas de
     Formaciones. */
  .aula-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
  }

  .aula-bar::after {
    content: '';
    flex: 1 0 100%;
    height: 1px;
    margin-top: var(--space-1);
    background: var(--rule);
  }

  .aula-bar__donde {
    min-width: 0;
  }

  .aula-bar__donde a {
    border-bottom: 0;
  }

  .aula-bar__donde a:hover {
    color: var(--ink);
  }

  .aula-bar__migaja {
    color: var(--ink);
  }

  .aula-bar__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .aula-bar__nav a {
    border-bottom: 1px solid transparent;
    color: var(--ink-soft);
  }

  .aula-bar__nav a:hover,
  .aula-bar__nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: currentColor;
  }

  .aula__maqueta {
    margin-top: var(--space-3);
  }
</style>
