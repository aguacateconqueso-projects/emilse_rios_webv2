---
import { Font } from 'astro:assets';
import { type Lang, type Route, useTranslations, routePath } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import Backdrop from '../components/Backdrop.astro';
import { OG_IMAGEN, WEBSITE_ID, PERSONA_ID, persona, sitioWeb } from '../data/seo';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Sección actual: marca la opción del menú y da el canonical por defecto. */
  route?: Route;
  /**
   * Dirección exacta de esta página en cada idioma. Solo hace falta cuando la
   * página no es la portada de su sección —la de un producto del aula, por
   * ejemplo—: sin esto, el canonical y el conmutador de idioma apuntarían a
   * `/aulavirtual/` desde la página de un curso.
   */
  pathEs?: string;
  pathEn?: string;
  /** La entrada solo se reproduce en la Home. */
  intro?: boolean;
  /** El contrabajo detrás del cristal, también solo en la Home. */
  backdrop?: boolean;
  /**
   * La entrada general: lo que hay en `<main>` sube 16 px y se funde al
   * cargar, en escalera (ver «La entrada» en `base.css`). **Toda página entra
   * con animación** desde el 24 sep 2026 —lo pidió Adrián—. Las que tienen
   * la suya, hecha a medida, la apagan con `entrada={false}`: la Home, *Sobre
   * mí*, Formaciones y las cartas de venta.
   */
  entrada?: boolean;
  /**
   * Fuera de los buscadores. Lo llevan el aula —acceso, escritorio, cursos— y
   * `/gracias/`: están detrás de una sesión, o son un formulario, y no tienen
   * nada que hacer en Google. Desde el 23 sep 2026, cuando el aula pasó a
   * vestirse con este mismo marco.
   */
  noindex?: boolean;
  /**
   * La imagen al compartir del sitio (`emilse-rios-contrabajo-og.jpg`): la
   * llevan Inicio, Sobre mí, Formaciones y el newsletter (pedido de SEO de
   * Emi, 11 oct 2026). Las cartas ponen la suya por el slot `head`.
   */
  ogImagen?: boolean;
  /**
   * Más datos para Google, además de los que van siempre —Emi (`Person`), la
   * página (`WebPage`) y, en el inicio, el sitio (`WebSite`)—: la formación
   * de una carta, sus preguntas, una entrada del newsletter. Van todos en un
   * solo `@graph`.
   */
  jsonLd?: Record<string, unknown>[];
  /**
   * Sin gemela en el otro idioma: el `hreflang` solo de la propia página. Lo
   * llevan los newsletters pasados sin traducción vinculada; su conmutador de
   * idioma va al índice del otro idioma, que no es la misma página.
   */
  sinGemela?: boolean;
  /** `article` en los newsletters pasados; `website` en lo demás. */
  ogTipo?: 'website' | 'article';
}
const {
  lang,
  title,
  description,
  route = 'home',
  pathEs,
  pathEn,
  intro = false,
  backdrop = false,
  entrada = true,
  noindex = false,
  ogImagen = false,
  jsonLd = [],
  sinGemela = false,
  ogTipo = 'website',
} = Astro.props as Props;
const t = useTranslations(lang);

const hrefEs = pathEs ?? routePath(route, 'es');
const hrefEn = pathEn ?? routePath(route, 'en');

const canonical = new URL(lang === 'en' ? hrefEn : hrefEs, Astro.site);
const altEs = new URL(hrefEs, Astro.site);
const altEn = new URL(hrefEn, Astro.site);

/* Los datos para Google (11 oct 2026). Emi es la misma `Person` en todas las
   páginas, con un único `@id`; cada página es un `WebPage` con el mismo nombre
   que su `<title>`; y el inicio dice además qué sitio es (`WebSite`). Ver
   `src/data/seo.ts`. Las páginas fuera de los buscadores no llevan nada. */
const esInicio = route === 'home' && !pathEs && !pathEn;
const grafo = noindex
  ? null
  : {
      '@context': 'https://schema.org',
      '@graph': [
        persona(lang),
        ...(esInicio ? [sitioWeb] : []),
        {
          '@type': 'WebPage',
          '@id': `${canonical.href}#webpage`,
          url: canonical.href,
          name: title,
          description,
          inLanguage: lang,
          isPartOf: { '@id': WEBSITE_ID },
          about: { '@id': PERSONA_ID },
          ...(ogImagen ? { primaryImageOfPage: OG_IMAGEN.url } : {}),
        },
        ...jsonLd,
      ],
    };
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {/* La «E» del logo de Emi, recortada de la propia firma. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {
      sinGemela ? (
        <link rel="alternate" hreflang={lang} href={canonical} />
      ) : (
        <>
          <link rel="alternate" hreflang="es" href={altEs} />
          <link rel="alternate" hreflang="en" href={altEn} />
          <link rel="alternate" hreflang="x-default" href={altEs} />
        </>
      )
    }

    <meta property="og:type" content={ogTipo} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
    <meta property="og:site_name" content={t('site.title')} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      ogImagen && (
        <>
          <meta property="og:image" content={OG_IMAGEN.url} />
          <meta property="og:image:width" content={String(OG_IMAGEN.ancho)} />
          <meta property="og:image:height" content={String(OG_IMAGEN.alto)} />
          <meta property="og:image:alt" content={OG_IMAGEN.alt[lang]} />
        </>
      )
    }
    {grafo && <script type="application/ld+json" is:inline set:html={JSON.stringify(grafo)} />}

    {/*
      Sin `preload`: el atributo precarga *todas* las variantes de la familia
      — incluidas latin-ext y las cursivas que esta página no usa — y eso son
      medio megabyte antes del primer pixel. Las @font-face viajan en la hoja
      de estilos, que ya bloquea el render, así que el navegador las descubre
      igual de pronto y baja solo los cortes que el texto necesita.
    */}
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />

    {/*
      Decide la entrada antes de pintar, para que no parpadee.

      `play`: la firma sobre negro, la primera vez de la sesión.
      `seen`: la firma ya salió; la Home entra con la escalera de *Sobre mí*.
      `done`: lo pone `Intro.astro` cuando la firma termina. No es `seen` a
      propósito: la escalera no tiene que dispararse detrás del panel.
    */}
    <script is:inline define:vars={{ intro }}>
      document.documentElement.classList.remove('no-js');
      if (intro) {
        var seen = false;
        try {
          seen = sessionStorage.getItem('cec_intro') === '1';
          sessionStorage.setItem('cec_intro', '1');
        } catch (e) {
          seen = true;
        }
        document.documentElement.dataset.intro = seen ? 'seen' : 'play';
      }
    </script>

    {/* Lo que una página quiera añadir al <head>: las cartas de venta ponen
        acá su imagen para compartir y sus datos para Google. */}
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link mono" href="#contenido">{t('nav.skip')}</a>
    {backdrop && <Backdrop />}
    {intro && <Intro name={t('site.name')} />}

    <Header lang={lang} route={route} hrefEs={hrefEs} hrefEn={hrefEn} />

    <main id="contenido" class="main" data-entrada={entrada ? '' : undefined}>
      <slot />
    </main>

    <Footer lang={lang} hrefEs={hrefEs} hrefEn={hrefEn} />

    {/* El revelado al entrar en pantalla. La misma animación en todo el sitio:
        las frases-ancla, y desde el 31 ago 2026 también los bloques del aula. */}
    <script>
      const anchors = document.querySelectorAll<HTMLElement>('.reveal');
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (still || !('IntersectionObserver' in window)) {
        anchors.forEach((el) => el.classList.add('is-visible'));
      } else {
        /** Cuántos quedan por descubrir. A cero se desmonta todo. */
        let pending = anchors.length;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              reveal(entry.target as HTMLElement);
            });
          },
          { rootMargin: '0px 0px -10% 0px' },
        );

        function reveal(el: HTMLElement) {
          if (el.classList.contains('is-visible')) return;
          el.classList.add('is-visible');
          observer.unobserve(el);
          pending -= 1;
          if (pending === 0) window.removeEventListener('scroll', onScroll);
        }

        /*
          Red de seguridad, y no es teórica: el observador solo avisa cuando
          CAMBIA si el elemento cruza el borde, y un salto de scroll mayor que
          la pantalla —una rueda rápida, la tecla Fin, un enlace a un ancla—
          lo lleva de estar debajo a estar encima en un solo fotograma. En los
          dos momentos está fuera, así que no hay cambio que avisar y el bloque
          se queda invisible para siempre. Con una sola frase-ancla por página
          casi no se notaba; con la carta del aula, que son dieciséis bloques,
          pasaba en cuanto alguien bajaba con ganas.

          Esto barre lo que ya quedó por encima del borde. Va atado a un
          fotograma para no medir posiciones en cada evento de scroll.
        */
        let ticking = false;
        const sweep = () => {
          ticking = false;
          const edge = window.innerHeight * 0.9; /* el mismo -10% del observador */
          anchors.forEach((el) => {
            if (el.classList.contains('is-visible')) return;
            if (el.getBoundingClientRect().top < edge) reveal(el);
          });
        };
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(sweep);
        };

        anchors.forEach((el) => observer.observe(el));
        if (pending > 0) window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>

    {/*
      Los botones: el relleno nace donde está el cursor, el botón lo sigue un
      poco y se acerca, y suelta notas musicales. El script vive en
      `src/scripts/botones.ts` desde que el panel —que no usa este marco— los
      necesitó también. El aspecto, en `base.css` (`.boton`).
    */}
    <script>
      import '../scripts/botones';
    </script>

    {/* En el teléfono, las fotos toman color al pasarles el scroll (27 sep
        2026). Ver `src/scripts/color-al-pasar.ts`. */}
    <script>
      import '../scripts/color-al-pasar';
    </script>
  </body>
</html>

<style>
  /* La cápsula del menú flota sobre la página, así que el contenido tiene que
     arrancar por debajo de ella. La píldora mide 60 px más los 16 de separación
     al borde; el hueco sube al siguiente valor de la rejilla de 8. */
  .main {
    padding-top: 5rem; /* 80 px */
  }
</style>
