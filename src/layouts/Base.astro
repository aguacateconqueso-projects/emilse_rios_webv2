---
import { Font } from 'astro:assets';
import { type Lang, type Route, useTranslations, routePath } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import Backdrop from '../components/Backdrop.astro';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Sección actual: marca la opción del menú y da el canonical por defecto. */
  route?: Route;
  /**
   * Dirección exacta de esta página en cada idioma. Solo hace falta cuando la
   * página no es la portada de su sección —la de un producto del aula, por
   * ejemplo—: sin esto, el canonical y el conmutador de idioma apuntarían a
   * `/aulavirtual/` desde la página de un curso.
   */
  pathEs?: string;
  pathEn?: string;
  /** La entrada solo se reproduce en la Home. */
  intro?: boolean;
  /** El contrabajo detrás del cristal, también solo en la Home. */
  backdrop?: boolean;
}
const {
  lang,
  title,
  description,
  route = 'home',
  pathEs,
  pathEn,
  intro = false,
  backdrop = false,
} = Astro.props;
const t = useTranslations(lang);

const hrefEs = pathEs ?? routePath(route, 'es');
const hrefEn = pathEn ?? routePath(route, 'en');

const canonical = new URL(lang === 'en' ? hrefEn : hrefEs, Astro.site);
const altEs = new URL(hrefEs, Astro.site);
const altEn = new URL(hrefEn, Astro.site);
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* La «E» del logo de Emi, recortada de la propia firma. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={altEs} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altEs} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
    <meta property="og:site_name" content={t('site.title')} />
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      Sin `preload`: el atributo precarga *todas* las variantes de la familia
      — incluidas latin-ext y las cursivas que esta página no usa — y eso son
      medio megabyte antes del primer pixel. Las @font-face viajan en la hoja
      de estilos, que ya bloquea el render, así que el navegador las descubre
      igual de pronto y baja solo los cortes que el texto necesita.
    */}
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />

    {/* Decide la entrada antes de pintar, para que no parpadee. */}
    <script is:inline define:vars={{ intro }}>
      document.documentElement.classList.remove('no-js');
      if (intro) {
        var seen = false;
        try {
          seen = sessionStorage.getItem('cec_intro') === '1';
          sessionStorage.setItem('cec_intro', '1');
        } catch (e) {
          seen = true;
        }
        document.documentElement.dataset.intro = seen ? 'done' : 'play';
      }
    </script>
  </head>

  <body>
    <a class="skip-link mono" href="#contenido">{t('nav.skip')}</a>
    {backdrop && <Backdrop />}
    {intro && <Intro name={t('site.name')} />}

    <Header lang={lang} route={route} hrefEs={hrefEs} hrefEn={hrefEn} />

    <main id="contenido" class="main">
      <slot />
    </main>

    <Footer lang={lang} hrefEs={hrefEs} hrefEn={hrefEn} />

    {/* El revelado al entrar en pantalla. La misma animación en todo el sitio:
        las frases-ancla, y desde el 31 ago 2026 también los bloques del aula. */}
    <script>
      const anchors = document.querySelectorAll<HTMLElement>('.reveal');
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (still || !('IntersectionObserver' in window)) {
        anchors.forEach((el) => el.classList.add('is-visible'));
      } else {
        /** Cuántos quedan por descubrir. A cero se desmonta todo. */
        let pending = anchors.length;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              reveal(entry.target as HTMLElement);
            });
          },
          { rootMargin: '0px 0px -10% 0px' },
        );

        function reveal(el: HTMLElement) {
          if (el.classList.contains('is-visible')) return;
          el.classList.add('is-visible');
          observer.unobserve(el);
          pending -= 1;
          if (pending === 0) window.removeEventListener('scroll', onScroll);
        }

        /*
          Red de seguridad, y no es teórica: el observador solo avisa cuando
          CAMBIA si el elemento cruza el borde, y un salto de scroll mayor que
          la pantalla —una rueda rápida, la tecla Fin, un enlace a un ancla—
          lo lleva de estar debajo a estar encima en un solo fotograma. En los
          dos momentos está fuera, así que no hay cambio que avisar y el bloque
          se queda invisible para siempre. Con una sola frase-ancla por página
          casi no se notaba; con la carta del aula, que son dieciséis bloques,
          pasaba en cuanto alguien bajaba con ganas.

          Esto barre lo que ya quedó por encima del borde. Va atado a un
          fotograma para no medir posiciones en cada evento de scroll.
        */
        let ticking = false;
        const sweep = () => {
          ticking = false;
          const edge = window.innerHeight * 0.9; /* el mismo -10% del observador */
          anchors.forEach((el) => {
            if (el.classList.contains('is-visible')) return;
            if (el.getBoundingClientRect().top < edge) reveal(el);
          });
        };
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(sweep);
        };

        anchors.forEach((el) => observer.observe(el));
        if (pending > 0) window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>

<style>
  /* La cápsula del menú flota sobre la página, así que el contenido tiene que
     arrancar por debajo de ella. La píldora mide 60 px más los 16 de separación
     al borde; el hueco sube al siguiente valor de la rejilla de 8. */
  .main {
    padding-top: 5rem; /* 80 px */
  }
</style>
