---
import { Font } from 'astro:assets';
import { type Lang, type Route, useTranslations, routePath } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Página actual, para canonical y alternativas hreflang. */
  route?: Route;
  /** La entrada solo se reproduce en la Home. */
  intro?: boolean;
}
const { lang, title, description, route = 'home', intro = false } = Astro.props;
const t = useTranslations(lang);

const canonical = new URL(routePath(route, lang), Astro.site);
const altEs = new URL(routePath(route, 'es'), Astro.site);
const altEn = new URL(routePath(route, 'en'), Astro.site);
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Provisional: cuando llegue la firma en SVG, el icono sale de ahí. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={altEs} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altEs} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
    <meta property="og:site_name" content={t('site.title')} />
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      Sin `preload`: el atributo precarga *todas* las variantes de la familia
      — incluidas latin-ext y las cursivas que esta página no usa — y eso son
      medio megabyte antes del primer pixel. Las @font-face viajan en la hoja
      de estilos, que ya bloquea el render, así que el navegador las descubre
      igual de pronto y baja solo los cortes que el texto necesita.
    */}
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />
    <Font cssVariable="--font-signature" />

    {/* Decide la entrada antes de pintar, para que no parpadee. */}
    <script is:inline define:vars={{ intro }}>
      document.documentElement.classList.remove('no-js');
      if (intro) {
        var seen = false;
        try {
          seen = sessionStorage.getItem('cec_intro') === '1';
          sessionStorage.setItem('cec_intro', '1');
        } catch (e) {
          seen = true;
        }
        document.documentElement.dataset.intro = seen ? 'done' : 'play';
      }
    </script>
  </head>

  <body>
    <a class="skip-link mono" href="#contenido">{t('nav.skip')}</a>
    {intro && <Intro name={t('site.name')} />}

    <Header lang={lang} route={route} />

    <main id="contenido" class="main">
      <slot />
    </main>

    <Footer lang={lang} route={route} />

    {/* Revelado de las frases-ancla. La segunda y última animación. */}
    <script>
      const anchors = document.querySelectorAll<HTMLElement>('.reveal');
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (still || !('IntersectionObserver' in window)) {
        anchors.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        anchors.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>

<style>
  /* La cabecera es fija: el contenido arranca por debajo de ella. */
  .main {
    padding-top: 4.5rem; /* 72 px */
  }
</style>
